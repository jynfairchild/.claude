import { describe, it, expect, beforeAll } from 'vitest';
import {
  generateSalt,
  bytesToBase64,
  base64ToBytes,
  deriveKey,
  encrypt,
  decrypt,
  encryptArray,
  decryptArray,
  isCryptoAvailable,
} from './crypto';

// Mock Web Crypto API for Node.js test environment
beforeAll(() => {
  if (typeof globalThis.crypto === 'undefined') {
    // @ts-expect-error - Node.js crypto shim
    globalThis.crypto = require('crypto').webcrypto;
  }
});

describe('crypto utilities', () => {
  describe('isCryptoAvailable', () => {
    it('returns true when Web Crypto API is available', () => {
      expect(isCryptoAvailable()).toBe(true);
    });
  });

  describe('salt generation', () => {
    it('generates a 32-byte salt', () => {
      const salt = generateSalt();
      expect(salt).toBeInstanceOf(Uint8Array);
      expect(salt.length).toBe(32);
    });

    it('generates unique salts each time', () => {
      const salt1 = generateSalt();
      const salt2 = generateSalt();
      expect(bytesToBase64(salt1)).not.toBe(bytesToBase64(salt2));
    });
  });

  describe('base64 encoding', () => {
    it('converts bytes to base64 and back', () => {
      const original = new Uint8Array([1, 2, 3, 4, 5, 255, 0, 128]);
      const base64 = bytesToBase64(original);
      const decoded = base64ToBytes(base64);
      expect(decoded).toEqual(original);
    });

    it('handles empty arrays', () => {
      const empty = new Uint8Array([]);
      const base64 = bytesToBase64(empty);
      const decoded = base64ToBytes(base64);
      expect(decoded).toEqual(empty);
    });
  });

  describe('key derivation', () => {
    it('derives a CryptoKey from password and salt', async () => {
      const password = 'test-password-123';
      const salt = generateSalt();
      const key = await deriveKey(password, salt);

      expect(key).toBeDefined();
      expect(key.type).toBe('secret');
      expect(key.algorithm.name).toBe('AES-GCM');
    });

    it('derives same key from same password and salt', async () => {
      const password = 'consistent-password';
      const salt = generateSalt();

      const key1 = await deriveKey(password, salt);
      const key2 = await deriveKey(password, salt);

      // Encrypt same text with both keys, should produce different ciphertexts
      // (due to random IV) but both should decrypt to same plaintext
      const plaintext = 'test message';
      const encrypted1 = await encrypt(plaintext, key1);
      const encrypted2 = await encrypt(plaintext, key2);

      const decrypted1 = await decrypt(encrypted1, key2); // Cross-decrypt
      const decrypted2 = await decrypt(encrypted2, key1); // Cross-decrypt

      expect(decrypted1).toBe(plaintext);
      expect(decrypted2).toBe(plaintext);
    });

    it('derives different keys from different passwords', async () => {
      const salt = generateSalt();
      const key1 = await deriveKey('password1', salt);
      const key2 = await deriveKey('password2', salt);

      const plaintext = 'secret message';
      const encrypted = await encrypt(plaintext, key1);

      // Decrypting with wrong key should fail
      await expect(decrypt(encrypted, key2)).rejects.toThrow();
    });

    it('derives different keys from different salts', async () => {
      const password = 'same-password';
      const salt1 = generateSalt();
      const salt2 = generateSalt();
      const key1 = await deriveKey(password, salt1);
      const key2 = await deriveKey(password, salt2);

      const plaintext = 'secret message';
      const encrypted = await encrypt(plaintext, key1);

      // Decrypting with key from different salt should fail
      await expect(decrypt(encrypted, key2)).rejects.toThrow();
    });
  });

  describe('encrypt/decrypt', () => {
    let testKey: CryptoKey;

    beforeAll(async () => {
      const salt = generateSalt();
      testKey = await deriveKey('test-password', salt);
    });

    it('encrypts and decrypts text correctly', async () => {
      const plaintext = 'Hello, World!';
      const encrypted = await encrypt(plaintext, testKey);
      const decrypted = await decrypt(encrypted, testKey);

      expect(decrypted).toBe(plaintext);
    });

    it('produces different ciphertext each time (random IV)', async () => {
      const plaintext = 'Same message';
      const encrypted1 = await encrypt(plaintext, testKey);
      const encrypted2 = await encrypt(plaintext, testKey);

      expect(encrypted1).not.toBe(encrypted2);

      // Both should decrypt to same plaintext
      expect(await decrypt(encrypted1, testKey)).toBe(plaintext);
      expect(await decrypt(encrypted2, testKey)).toBe(plaintext);
    });

    it('ciphertext looks nothing like plaintext', async () => {
      const plaintext = 'My secret task title';
      const encrypted = await encrypt(plaintext, testKey);

      // Encrypted should be base64 and not contain plaintext
      expect(encrypted).not.toContain(plaintext);
      expect(encrypted).not.toContain('secret');
      expect(encrypted).not.toContain('task');
      expect(encrypted).not.toContain('title');

      // Should be valid base64
      expect(() => base64ToBytes(encrypted)).not.toThrow();
    });

    it('handles empty strings', async () => {
      const encrypted = await encrypt('', testKey);
      expect(encrypted).toBe('');

      const decrypted = await decrypt('', testKey);
      expect(decrypted).toBe('');
    });

    it('handles unicode characters', async () => {
      const plaintext = 'Hello 世界! 🎉 Привет';
      const encrypted = await encrypt(plaintext, testKey);
      const decrypted = await decrypt(encrypted, testKey);

      expect(decrypted).toBe(plaintext);
    });

    it('handles long strings', async () => {
      const plaintext = 'A'.repeat(10000);
      const encrypted = await encrypt(plaintext, testKey);
      const decrypted = await decrypt(encrypted, testKey);

      expect(decrypted).toBe(plaintext);
    });

    it('fails to decrypt with wrong key', async () => {
      const wrongKey = await deriveKey('wrong-password', generateSalt());
      const encrypted = await encrypt('secret', testKey);

      await expect(decrypt(encrypted, wrongKey)).rejects.toThrow();
    });

    it('fails to decrypt corrupted ciphertext', async () => {
      const encrypted = await encrypt('secret', testKey);
      const corrupted = encrypted.slice(0, -4) + 'XXXX';

      await expect(decrypt(corrupted, testKey)).rejects.toThrow();
    });
  });

  describe('encryptArray/decryptArray', () => {
    let testKey: CryptoKey;

    beforeAll(async () => {
      const salt = generateSalt();
      testKey = await deriveKey('test-password', salt);
    });

    it('encrypts and decrypts arrays correctly', async () => {
      const tags = ['urgent', 'design', 'frontend'];
      const encrypted = await encryptArray(tags, testKey);
      const decrypted = await decryptArray(encrypted, testKey);

      expect(decrypted).toEqual(tags);
    });

    it('handles empty arrays', async () => {
      const encrypted = await encryptArray([], testKey);
      expect(encrypted).toBe('');

      const decrypted = await decryptArray('', testKey);
      expect(decrypted).toEqual([]);
    });

    it('handles arrays with unicode', async () => {
      const tags = ['设计', '🚀', 'тест'];
      const encrypted = await encryptArray(tags, testKey);
      const decrypted = await decryptArray(encrypted, testKey);

      expect(decrypted).toEqual(tags);
    });

    it('encrypted array looks nothing like original', async () => {
      const tags = ['secret-tag', 'private-info'];
      const encrypted = await encryptArray(tags, testKey);

      expect(encrypted).not.toContain('secret');
      expect(encrypted).not.toContain('private');
      expect(encrypted).not.toContain('tag');
    });
  });
});

describe('encryption end-to-end simulation', () => {
  it('simulates full task encryption flow', async () => {
    // Simulate signup: generate salt, derive key
    const password = 'user-password-123';
    const salt = generateSalt();
    const saltBase64 = bytesToBase64(salt);
    const key = await deriveKey(password, salt);

    // User creates a task with sensitive data
    const taskData = {
      title: 'Fix authentication bug in login page',
      project: 'Secret Project Alpha',
      tags: ['security', 'high-priority', 'confidential'],
    };

    // Encrypt before sending to server
    const encryptedData = {
      title: await encrypt(taskData.title, key),
      project: await encrypt(taskData.project, key),
      tags: await encryptArray(taskData.tags, key),
    };

    // Verify server would only see gibberish
    expect(encryptedData.title).not.toContain('Fix');
    expect(encryptedData.title).not.toContain('authentication');
    expect(encryptedData.title).not.toContain('bug');
    expect(encryptedData.project).not.toContain('Secret');
    expect(encryptedData.project).not.toContain('Alpha');
    expect(encryptedData.tags).not.toContain('security');
    expect(encryptedData.tags).not.toContain('confidential');

    // Simulate login: derive key from same password + salt
    const restoredSalt = base64ToBytes(saltBase64);
    const restoredKey = await deriveKey(password, restoredSalt);

    // Decrypt after receiving from server
    const decryptedData = {
      title: await decrypt(encryptedData.title, restoredKey),
      project: await decrypt(encryptedData.project, restoredKey),
      tags: await decryptArray(encryptedData.tags, restoredKey),
    };

    // Verify data is correctly restored
    expect(decryptedData.title).toBe(taskData.title);
    expect(decryptedData.project).toBe(taskData.project);
    expect(decryptedData.tags).toEqual(taskData.tags);
  });

  it('simulates password change re-encryption', async () => {
    // Initial setup
    const oldPassword = 'old-password';
    const oldSalt = generateSalt();
    const oldKey = await deriveKey(oldPassword, oldSalt);

    // Encrypt task with old key
    const taskTitle = 'Important task';
    const encryptedWithOld = await encrypt(taskTitle, oldKey);

    // Password change: new password and salt
    const newPassword = 'new-password';
    const newSalt = generateSalt();
    const newKey = await deriveKey(newPassword, newSalt);

    // Re-encryption process:
    // 1. Decrypt with old key
    const decrypted = await decrypt(encryptedWithOld, oldKey);
    // 2. Re-encrypt with new key
    const encryptedWithNew = await encrypt(decrypted, newKey);

    // Verify old key no longer works
    await expect(decrypt(encryptedWithNew, oldKey)).rejects.toThrow();

    // Verify new key works
    const finalDecrypted = await decrypt(encryptedWithNew, newKey);
    expect(finalDecrypted).toBe(taskTitle);
  });
});
