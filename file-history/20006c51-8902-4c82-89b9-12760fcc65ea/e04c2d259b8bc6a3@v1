import { describe, it, expect, vi, beforeEach, afterEach } from 'vitest';
import { fetchWithAuth } from './http';
import * as authApiModule from './authApi';
import { resetRefreshGateForTests } from './refreshGate';

describe('fetchWithAuth', () => {
  beforeEach(() => {
    localStorage.clear();
    resetRefreshGateForTests();
  });
  afterEach(() => {
    vi.restoreAllMocks();
  });

  it('on 401 performs a single refresh then retries', async () => {
    // First call returns 401; second (retry) returns OK
    const fetchSpy = vi.spyOn(global, 'fetch' as any).mockImplementation(async (_url: string, init?: RequestInit) => {
      const call = fetchSpy.mock.calls.length;
      if (call === 1) {
        return { ok: false, status: 401 } as any;
      }
      return {
        ok: true,
        status: 200,
        json: async () => ({ success: true, credentials: init?.credentials }),
      } as any;
    });

    const refreshSpy = vi.spyOn(authApiModule.authApi, 'refresh').mockResolvedValue({} as any);

    const resp = await fetchWithAuth('http://example.com/secure', { method: 'GET' });
    expect(refreshSpy).toHaveBeenCalledTimes(1);
    expect(fetchSpy).toHaveBeenCalledTimes(2);

    const payload = await resp.json();
    expect(payload.success).toBe(true);

    // Both calls should include credentials
    const [, init1] = fetchSpy.mock.calls[0] as [string, RequestInit];
    const [, init2] = fetchSpy.mock.calls[1] as [string, RequestInit];
    expect(init1?.credentials).toBe('include');
    expect(init2?.credentials).toBe('include');
  });

  it('deduplicates concurrent refreshes (single-flight)', async () => {
    const fetchSpy = vi.spyOn(global, 'fetch' as any).mockImplementation(async (_url: string) => {
      const c = fetchSpy.mock.calls.length;
      // First two attempts (for two concurrent requests) -> 401
      if (c === 1 || c === 2) return { ok: false, status: 401 } as any;
      // Retries -> OK
      return { ok: true, status: 200, json: async () => ({ ok: true }) } as any;
    });

    const refreshSpy = vi.spyOn(authApiModule.authApi, 'refresh').mockImplementation(async () => {
      // Simulate small delay to ensure both requests hit 401 before refresh resolves
      await new Promise(r => setTimeout(r, 10));
      return {} as any;
    });

    const [r1, r2] = await Promise.all([
      fetchWithAuth('http://e/secure1'),
      fetchWithAuth('http://e/secure2'),
    ]);
    expect(refreshSpy).toHaveBeenCalledTimes(1); // Single-flight deduplication
    expect(fetchSpy).toHaveBeenCalledTimes(4); // 2 initial + 2 retries
    const j1 = await r1.json();
    const j2 = await r2.json();
    expect(j1.ok).toBe(true);
    expect(j2.ok).toBe(true);
  });

  it('always includes credentials for cookie-based auth', async () => {
    const fetchSpy = vi.spyOn(global, 'fetch' as any).mockResolvedValue({
      ok: true,
      status: 200,
      json: async () => ({ ok: true }),
    } as any);

    await fetchWithAuth('http://example.com/data', { method: 'GET' });

    expect(fetchSpy).toHaveBeenCalledTimes(1);
    const [, init] = fetchSpy.mock.calls[0] as [string, RequestInit];
    expect(init?.credentials).toBe('include');
  });
});
