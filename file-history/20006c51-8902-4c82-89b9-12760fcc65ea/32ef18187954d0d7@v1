import fs from 'fs';
import path from 'path';
import { LegalHeader } from '@/components/LegalHeader/LegalHeader';
import './legal.css';

function parseMarkdown(content: string) {
  const lines = content.split('\n');
  const elements: { type: string; content: string; items?: string[] }[] = [];
  let currentList: string[] = [];

  for (const line of lines) {
    // Flush any pending list
    if (currentList.length > 0 && !line.startsWith('•')) {
      elements.push({ type: 'list', content: '', items: [...currentList] });
      currentList = [];
    }

    if (line.startsWith('# ')) {
      elements.push({ type: 'h1', content: line.slice(2) });
    } else if (line.match(/^\d+\.\s/)) {
      elements.push({ type: 'h2', content: line });
    } else if (line.startsWith('**')) {
      elements.push({ type: 'meta', content: line.replace(/\*\*/g, '') });
    } else if (line.startsWith('•')) {
      currentList.push(line.slice(1).trim());
    } else if (line.trim()) {
      elements.push({ type: 'p', content: line });
    }
  }

  // Flush remaining list
  if (currentList.length > 0) {
    elements.push({ type: 'list', content: '', items: [...currentList] });
  }

  return elements;
}

export default function TermsPage() {
  const filePath = path.join(process.cwd(), 'terms.md');
  let content = '';

  try {
    content = fs.readFileSync(filePath, 'utf-8');
  } catch {
    content = 'Terms of Service content not found.';
  }

  const elements = parseMarkdown(content);

  return (
    <div className="legal-page">
      <LegalHeader />
      <main className="legal-content">
        {elements.map((el, i) => {
          if (el.type === 'h1') return <h1 key={i} className="legal-title">{el.content}</h1>;
          if (el.type === 'h2') return <h2 key={i} className="legal-heading">{el.content}</h2>;
          if (el.type === 'meta') return <p key={i} className="legal-meta">{el.content}</p>;
          if (el.type === 'list') return (
            <ul key={i} className="legal-list">
              {el.items?.map((item, j) => <li key={j}>{item}</li>)}
            </ul>
          );
          return <p key={i} className="legal-paragraph">{el.content}</p>;
        })}
      </main>
    </div>
  );
}
