/* Import header styles for nav-link reuse */
@import '../../components/header/Header.css';

.admin-nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 44px;
  background: var(--color-white);
  border-bottom: 1px solid var(--kkan-grey-100);
}

.admin-nav-back {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: var(--kkan-grey-500);
  font-family: 'Berkeley Mono', monospace;
  font-size: 14px;
  font-weight: 500;
  text-decoration: none;
  transition: color 0.2s;
}

.admin-nav-back:hover {
  color: var(--kkan-grey-800);
}

.admin-nav-back img {
  width: 20px;
  height: 20px;
}

.admin-nav {
  margin-left: 0;
}

@media (max-width: 768px) {
  .admin-nav-bar {
    padding: 12px 16px;
    flex-direction: column;
    gap: 12px;
    align-items: flex-start;
  }

  .admin-nav {
    width: 100%;
    justify-content: flex-start;
  }
}
