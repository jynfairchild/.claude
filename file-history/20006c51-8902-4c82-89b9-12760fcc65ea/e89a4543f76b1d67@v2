'use client';

import { useEffect, useState } from 'react';

interface OnboardingTooltipProps {
  text: string;
}

export const OnboardingTooltip = ({ text }: OnboardingTooltipProps) => {
  const [isVisible, setIsVisible] = useState(false);
  const [currentText, setCurrentText] = useState('');
  const [shouldHide, setShouldHide] = useState(false);

  useEffect(() => {
    let showTimeout: NodeJS.Timeout;
    let hideTimeout: NodeJS.Timeout;

    if (text && !currentText) {
      // New text appeared - wait 3s before showing
      showTimeout = setTimeout(() => {
        setCurrentText(text);
        setIsVisible(true);
      }, 1800);
    } else if (!text && currentText) {
      // Text disappeared - immediately start hiding animation
      setShouldHide(true);
      hideTimeout = setTimeout(() => {
        setIsVisible(false);
        setCurrentText('');
        setShouldHide(false);
      }, 500); // Match the fadeOut animation duration
    } else if (text !== currentText && text) {
      // Text changed - wait 3s before transitioning
      setShouldHide(true);
      hideTimeout = setTimeout(() => {
        setIsVisible(false);
        setTimeout(() => {
          setCurrentText(text);
          setIsVisible(true);
          setShouldHide(false);
        }, 100);
      }, 1200);
    }

    return () => {
      clearTimeout(showTimeout);
      clearTimeout(hideTimeout);
    };
  }, [text, currentText]);

  if (!isVisible) return null;

  return (
    <div className="onboarding-tooltip-container">
      <div className="onboarding-tooltip">
        {currentText === 'Add a title' && (
          <div className={`tooltip-with-arrow ${shouldHide ? 'hiding' : ''}`}>
            <span className="tooltip-text tooltip-text-with-bg">{currentText}</span>
            <svg className="tooltip-line" width="125" height="71" viewBox="0 0 125 71" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M62.5 60L62.5 1" stroke="#222832" strokeLinecap="square"/>
              <rect opacity="0.2" x="54.5" y="55" width="16" height="16" fill="#222832"/>
              <rect x="58.5" y="59" width="8" height="8" fill="#222832"/>
            </svg>
          </div>
        )}
        {currentText === 'Hit play' && (
          <div className={`tooltip-with-arrow hit-play-tooltip ${shouldHide ? 'hiding' : ''}`}>
            <span className="tooltip-text tooltip-text-with-bg">{currentText}</span>
            <svg className="tooltip-left-line" width="66" height="42" viewBox="0 0 66 42" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect y="20.5" width="55" height="1" fill="#222832"/>
              <rect opacity="0.2" x="50" y="13" width="16" height="16" fill="#222832"/>
              <rect x="54" y="17" width="8" height="8" fill="#222832"/>
            </svg>
          </div>
        )}
        {currentText !== 'Add a title' && currentText !== 'Hit play' && <span className={shouldHide ? 'hiding' : ''}>{currentText}</span>}
      </div>
    </div>
  );
};
