package database

import (
	"fmt"
	stdlog "log"
	"os"

	"gorm.io/driver/postgres"
	"gorm.io/gorm"
	gormlogger "gorm.io/gorm/logger"

	"simple_task_tracker/backend/internal/models"
)

func InitDB() (*gorm.DB, error) {
	dsn := os.Getenv("DATABASE_URL")
	if dsn == "" {
		dsn = "host=localhost user=postgres password=postgres dbname=astrotask_db port=5432 sslmode=disable"
	}

	// Configure GORM logger to reduce noise and ignore ErrRecordNotFound
	glogger := gormlogger.New(
		stdlog.New(os.Stdout, "", stdlog.LstdFlags),
		gormlogger.Config{
			SlowThreshold:             0,
			LogLevel:                  gormlogger.Warn, // keep warnings and errors
			IgnoreRecordNotFoundError: true,            // do not print "record not found"
			Colorful:                  true,
		},
	)

	db, err := gorm.Open(postgres.Open(dsn), &gorm.Config{Logger: glogger})
	if err != nil {
		return nil, fmt.Errorf("failed to connect to database: %w", err)
	}

	if err := db.AutoMigrate(
		&models.User{},
		&models.Project{},
		&models.Task{},
		&models.Session{},
		&models.UserColumn{},
		&models.RefreshToken{},
		&models.EmailVerificationToken{},
		&models.PasswordResetToken{},
		&models.Invitation{},
	); err != nil {
		return nil, fmt.Errorf("failed to migrate database: %w", err)
	}

	// Run custom migrations for constraint updates
	if err := RunMigrations(db); err != nil {
		stdlog.Printf("Warning during migrations: %v", err)
	}

	stdlog.Println("Database connected and migrated successfully")
	return db, nil
}
