/**
 * Tests for encryption in the task/column flow
 *
 * These tests verify that:
 * 1. Data sent to the API is encrypted (not plaintext)
 * 2. Encrypted data can be decrypted with the correct key
 * 3. Sensitive information never appears in API payloads
 */

import { describe, it, expect, beforeAll } from 'vitest';
import {
  encrypt,
  decrypt,
  encryptArray,
  decryptArray,
  generateSalt,
  bytesToBase64,
  base64ToBytes,
  deriveKey,
} from '../utils/crypto';

// Mock Web Crypto API for Node.js test environment
beforeAll(() => {
  if (typeof globalThis.crypto === 'undefined') {
    // @ts-expect-error - Node.js crypto shim
    globalThis.crypto = require('crypto').webcrypto;
  }
});

describe('Task encryption simulation', () => {
  let encryptionKey: CryptoKey;
  const testPassword = 'user-secure-password';
  let testSalt: Uint8Array;
  let testSaltBase64: string;

  beforeAll(async () => {
    testSalt = generateSalt();
    testSaltBase64 = bytesToBase64(testSalt);
    encryptionKey = await deriveKey(testPassword, testSalt);
  });

  describe('encryptTaskData simulation', () => {
    /**
     * Simulates the encryptTaskData function from TaskContext
     */
    async function encryptTaskData(data: {
      title?: string;
      project?: string;
      tags?: string[];
    }) {
      const encrypted: Record<string, any> = { ...data };

      if (data.title) {
        encrypted.title = await encrypt(data.title, encryptionKey);
      }
      if (data.project) {
        encrypted.project = await encrypt(data.project, encryptionKey);
      }
      if (data.tags && data.tags.length > 0) {
        encrypted.tags = [await encryptArray(data.tags, encryptionKey)];
      }

      return encrypted;
    }

    /**
     * Simulates the decryptTask function from TaskContext
     */
    async function decryptTaskData(data: {
      title?: string;
      project?: string;
      tags?: string[];
    }) {
      const decrypted: Record<string, any> = { ...data };

      if (data.title) {
        decrypted.title = await decrypt(data.title, encryptionKey);
      }
      if (data.project) {
        decrypted.project = await decrypt(data.project, encryptionKey);
      }
      if (data.tags && data.tags.length > 0) {
        decrypted.tags = await decryptArray(data.tags[0], encryptionKey);
      }

      return decrypted;
    }

    it('encrypts task title before API call', async () => {
      const plainTitle = 'My secret task title';
      const encrypted = await encryptTaskData({ title: plainTitle });

      expect(encrypted.title).not.toBe(plainTitle);
      expect(encrypted.title).not.toContain('secret');
      expect(encrypted.title).not.toContain('task');
      expect(encrypted.title).not.toContain('title');
    });

    it('encrypts project name before API call', async () => {
      const plainProject = 'Confidential Project Alpha';
      const encrypted = await encryptTaskData({ project: plainProject });

      expect(encrypted.project).not.toBe(plainProject);
      expect(encrypted.project).not.toContain('Confidential');
      expect(encrypted.project).not.toContain('Alpha');
    });

    it('encrypts tags before API call', async () => {
      const plainTags = ['private', 'sensitive', 'confidential'];
      const encrypted = await encryptTaskData({ tags: plainTags });

      expect(encrypted.tags).toHaveLength(1); // Encrypted as single string
      expect(encrypted.tags[0]).not.toContain('private');
      expect(encrypted.tags[0]).not.toContain('sensitive');
      expect(encrypted.tags[0]).not.toContain('confidential');
    });

    it('full round-trip: encrypt then decrypt', async () => {
      const original = {
        title: 'Important meeting with client',
        project: 'Sales Q4',
        tags: ['meeting', 'important', 'client'],
      };

      const encrypted = await encryptTaskData(original);
      const decrypted = await decryptTaskData(encrypted);

      expect(decrypted.title).toBe(original.title);
      expect(decrypted.project).toBe(original.project);
      expect(decrypted.tags).toEqual(original.tags);
    });

    it('simulates what API would receive vs what user sees', async () => {
      const userInput = {
        title: 'Bank password: mySecurePass123!',
        project: 'Personal Finance',
        tags: ['banking', 'passwords', 'sensitive'],
      };

      // What gets sent to server (encrypted)
      const apiPayload = await encryptTaskData(userInput);

      // Verify server sees only ciphertext
      expect(apiPayload.title).not.toContain('Bank');
      expect(apiPayload.title).not.toContain('password');
      expect(apiPayload.title).not.toContain('mySecurePass123');
      expect(apiPayload.project).not.toContain('Personal');
      expect(apiPayload.project).not.toContain('Finance');
      expect(JSON.stringify(apiPayload.tags)).not.toContain('banking');
      expect(JSON.stringify(apiPayload.tags)).not.toContain('passwords');

      // What user sees after decryption
      const userSees = await decryptTaskData(apiPayload);

      expect(userSees.title).toBe(userInput.title);
      expect(userSees.project).toBe(userInput.project);
      expect(userSees.tags).toEqual(userInput.tags);
    });
  });
});

describe('Column encryption simulation', () => {
  let encryptionKey: CryptoKey;

  beforeAll(async () => {
    const salt = generateSalt();
    encryptionKey = await deriveKey('test-password', salt);
  });

  it('encrypts column name before API call', async () => {
    const plainName = 'Top Secret Projects';
    const encryptedName = await encrypt(plainName, encryptionKey);

    expect(encryptedName).not.toBe(plainName);
    expect(encryptedName).not.toContain('Top');
    expect(encryptedName).not.toContain('Secret');
    expect(encryptedName).not.toContain('Projects');

    // Verify decryption works
    const decryptedName = await decrypt(encryptedName, encryptionKey);
    expect(decryptedName).toBe(plainName);
  });

  it('default column names are encrypted', async () => {
    const defaultNames = ['Todo', 'In Progress', 'Done', 'Column 3'];

    for (const name of defaultNames) {
      const encrypted = await encrypt(name, encryptionKey);
      expect(encrypted).not.toBe(name);
      expect(encrypted).not.toContain(name);

      const decrypted = await decrypt(encrypted, encryptionKey);
      expect(decrypted).toBe(name);
    }
  });
});

describe('Password change re-encryption simulation', () => {
  it('simulates full password change with data re-encryption', async () => {
    // Initial setup with old password
    const oldPassword = 'old-password-123';
    const oldSalt = generateSalt();
    const oldKey = await deriveKey(oldPassword, oldSalt);

    // User's data encrypted with old key
    const tasks = [
      { id: 1, title: 'Task 1', project: 'Project A', tags: ['tag1'] },
      { id: 2, title: 'Task 2', project: 'Project B', tags: ['tag2', 'tag3'] },
    ];

    const columns = [
      { id: 1, name: 'Todo' },
      { id: 2, name: 'In Progress' },
    ];

    // Encrypt with old key (simulating existing data)
    const encryptedTasks = await Promise.all(
      tasks.map(async (t) => ({
        id: t.id,
        title: await encrypt(t.title, oldKey),
        project: await encrypt(t.project, oldKey),
        tags: [await encryptArray(t.tags, oldKey)],
      }))
    );

    const encryptedColumns = await Promise.all(
      columns.map(async (c) => ({
        id: c.id,
        name: await encrypt(c.name, oldKey),
      }))
    );

    // Password change process
    const newPassword = 'new-password-456';
    const newSalt = generateSalt();
    const newKey = await deriveKey(newPassword, newSalt);

    // Step 1: Decrypt with old key
    const decryptedTasks = await Promise.all(
      encryptedTasks.map(async (t) => ({
        id: t.id,
        title: await decrypt(t.title, oldKey),
        project: await decrypt(t.project, oldKey),
        tags: await decryptArray(t.tags[0], oldKey),
      }))
    );

    const decryptedColumns = await Promise.all(
      encryptedColumns.map(async (c) => ({
        id: c.id,
        name: await decrypt(c.name, oldKey),
      }))
    );

    // Verify decryption matches original
    expect(decryptedTasks[0].title).toBe('Task 1');
    expect(decryptedTasks[1].project).toBe('Project B');
    expect(decryptedColumns[0].name).toBe('Todo');

    // Step 2: Re-encrypt with new key
    const reencryptedTasks = await Promise.all(
      decryptedTasks.map(async (t) => ({
        id: t.id,
        title: await encrypt(t.title, newKey),
        project: await encrypt(t.project, newKey),
        tags: [await encryptArray(t.tags, newKey)],
      }))
    );

    const reencryptedColumns = await Promise.all(
      decryptedColumns.map(async (c) => ({
        id: c.id,
        name: await encrypt(c.name, newKey),
      }))
    );

    // Verify old key no longer works
    await expect(decrypt(reencryptedTasks[0].title, oldKey)).rejects.toThrow();
    await expect(decrypt(reencryptedColumns[0].name, oldKey)).rejects.toThrow();

    // Verify new key works
    const finalTasks = await Promise.all(
      reencryptedTasks.map(async (t) => ({
        id: t.id,
        title: await decrypt(t.title, newKey),
        project: await decrypt(t.project, newKey),
        tags: await decryptArray(t.tags[0], newKey),
      }))
    );

    const finalColumns = await Promise.all(
      reencryptedColumns.map(async (c) => ({
        id: c.id,
        name: await decrypt(c.name, newKey),
      }))
    );

    // Data should match original
    expect(finalTasks[0].title).toBe('Task 1');
    expect(finalTasks[1].project).toBe('Project B');
    expect(finalTasks[1].tags).toEqual(['tag2', 'tag3']);
    expect(finalColumns[0].name).toBe('Todo');
    expect(finalColumns[1].name).toBe('In Progress');
  });
});

describe('Backend storage simulation', () => {
  it('verifies what backend would store vs what user enters', async () => {
    const password = 'user-password';
    const salt = generateSalt();
    const key = await deriveKey(password, salt);

    // Sensitive user data
    const userData = {
      taskTitle: 'Meeting with lawyer about divorce',
      taskProject: 'Personal Legal Matters',
      taskTags: ['legal', 'private', 'urgent'],
      columnName: 'Confidential',
    };

    // What gets stored in database (encrypted)
    const dbStorage = {
      taskTitle: await encrypt(userData.taskTitle, key),
      taskProject: await encrypt(userData.taskProject, key),
      taskTags: await encryptArray(userData.taskTags, key),
      columnName: await encrypt(userData.columnName, key),
    };

    // Simulate a database dump - attacker sees only this
    const dbDump = JSON.stringify(dbStorage);

    // Verify sensitive info is NOT in database
    expect(dbDump).not.toContain('lawyer');
    expect(dbDump).not.toContain('divorce');
    expect(dbDump).not.toContain('Personal');
    expect(dbDump).not.toContain('Legal');
    expect(dbDump).not.toContain('private');
    expect(dbDump).not.toContain('urgent');
    expect(dbDump).not.toContain('Confidential');

    // Legitimate user with password can still read
    const userView = {
      taskTitle: await decrypt(dbStorage.taskTitle, key),
      taskProject: await decrypt(dbStorage.taskProject, key),
      taskTags: await decryptArray(dbStorage.taskTags, key),
      columnName: await decrypt(dbStorage.columnName, key),
    };

    expect(userView.taskTitle).toBe(userData.taskTitle);
    expect(userView.taskProject).toBe(userData.taskProject);
    expect(userView.taskTags).toEqual(userData.taskTags);
    expect(userView.columnName).toBe(userData.columnName);
  });

  it('different users have different encryption keys', async () => {
    const user1Salt = generateSalt();
    const user2Salt = generateSalt();

    const user1Key = await deriveKey('password1', user1Salt);
    const user2Key = await deriveKey('password2', user2Salt);

    const sharedTaskTitle = 'Common task name';

    const user1Encrypted = await encrypt(sharedTaskTitle, user1Key);
    const user2Encrypted = await encrypt(sharedTaskTitle, user2Key);

    // Even same plaintext produces different ciphertext for different users
    expect(user1Encrypted).not.toBe(user2Encrypted);

    // Each user can only decrypt their own data
    expect(await decrypt(user1Encrypted, user1Key)).toBe(sharedTaskTitle);
    expect(await decrypt(user2Encrypted, user2Key)).toBe(sharedTaskTitle);

    // Cross-decryption fails
    await expect(decrypt(user1Encrypted, user2Key)).rejects.toThrow();
    await expect(decrypt(user2Encrypted, user1Key)).rejects.toThrow();
  });
});
