package handlers

import (
	"net/http"
	"time"

	"github.com/gin-gonic/gin"
	"gorm.io/gorm"

	"simple_task_tracker/backend/internal/models"
)

type MetricsHandler struct {
	db *gorm.DB
}

func NewMetricsHandler(db *gorm.DB) *MetricsHandler {
	return &MetricsHandler{db: db}
}

// GetOverview returns aggregate stats computed on demand
// GET /api/v1/admin/metrics/overview
func (h *MetricsHandler) GetOverview(c *gin.Context) {
	stats := models.AggregateStats{}

	now := time.Now()
	startOfDay := time.Date(now.Year(), now.Month(), now.Day(), 0, 0, 0, 0, now.Location())
	startOfWeek := startOfDay.AddDate(0, 0, -int(now.Weekday()))
	startOfMonth := time.Date(now.Year(), now.Month(), 1, 0, 0, 0, 0, now.Location())
	startOfYear := time.Date(now.Year(), 1, 1, 0, 0, 0, 0, now.Location())

	// User stats
	h.db.Model(&models.User{}).Count(&stats.Users.Total)
	h.db.Model(&models.User{}).Where("email_verified_at IS NOT NULL").Count(&stats.Users.Verified)
	stats.Users.Unverified = stats.Users.Total - stats.Users.Verified
	h.db.Model(&models.User{}).Where("role = ?", "admin").Count(&stats.Users.Admins)
	h.db.Model(&models.User{}).Where("created_at >= ?", startOfDay).Count(&stats.Users.Today)
	h.db.Model(&models.User{}).Where("created_at >= ?", startOfWeek).Count(&stats.Users.ThisWeek)
	h.db.Model(&models.User{}).Where("created_at >= ?", startOfMonth).Count(&stats.Users.ThisMonth)
	h.db.Model(&models.User{}).Where("created_at >= ?", startOfYear).Count(&stats.Users.ThisYear)

	// Task stats
	h.db.Model(&models.Task{}).Count(&stats.Tasks.Total)
	h.db.Model(&models.Task{}).Where("is_active = ?", true).Count(&stats.Tasks.Active)
	h.db.Model(&models.Task{}).Where("status = ?", "completed").Count(&stats.Tasks.Completed)
	h.db.Model(&models.Task{}).Where("status = ?", "uncompleted").Count(&stats.Tasks.Uncompleted)
	h.db.Model(&models.Task{}).Where("created_at >= ?", startOfDay).Count(&stats.Tasks.Today)
	h.db.Model(&models.Task{}).Where("created_at >= ?", startOfWeek).Count(&stats.Tasks.ThisWeek)

	// Average duration (completed tasks only, with duration > 0)
	var avgDuration float64
	h.db.Model(&models.Task{}).
		Where("status = ? AND duration > 0", "completed").
		Select("COALESCE(AVG(duration), 0)").
		Scan(&avgDuration)
	stats.Tasks.AvgDuration = avgDuration

	// Session stats
	h.db.Model(&models.Session{}).Count(&stats.Sessions.Total)
	h.db.Model(&models.Session{}).Where("end_time IS NULL").Count(&stats.Sessions.ActiveNow)

	var totalTime int64
	h.db.Model(&models.Session{}).Select("COALESCE(SUM(duration), 0)").Scan(&totalTime)
	stats.Sessions.TotalTimeTracked = totalTime

	h.db.Model(&models.Session{}).
		Where("created_at >= ?", startOfDay).
		Select("COALESCE(SUM(duration), 0)").Scan(&stats.Sessions.TodayTime)
	h.db.Model(&models.Session{}).
		Where("created_at >= ?", startOfWeek).
		Select("COALESCE(SUM(duration), 0)").Scan(&stats.Sessions.ThisWeekTime)
	h.db.Model(&models.Session{}).
		Where("created_at >= ?", startOfMonth).
		Select("COALESCE(SUM(duration), 0)").Scan(&stats.Sessions.ThisMonthTime)

	// Top users (by time tracked)
	h.db.Raw(`
		SELECT u.id as user_id, u.name, u.email,
		       COALESCE(SUM(s.duration), 0) as time_tracked,
		       COUNT(DISTINCT t.id) as task_count,
		       COUNT(s.id) as session_count
		FROM users u
		LEFT JOIN tasks t ON t.user_id = u.id
		LEFT JOIN sessions s ON s.task_id = t.id
		GROUP BY u.id, u.name, u.email
		ORDER BY time_tracked DESC
		LIMIT 10
	`).Scan(&stats.TopUsers)

	c.JSON(http.StatusOK, stats)
}

// GetChartData returns time-series data for charts
// GET /api/v1/admin/metrics/charts?period=week&metric=signups
func (h *MetricsHandler) GetChartData(c *gin.Context) {
	period := c.DefaultQuery("period", "week")
	metric := c.DefaultQuery("metric", "signups")

	var days int
	switch period {
	case "week":
		days = 7
	case "month":
		days = 30
	case "year":
		days = 365
	default:
		days = 7
	}

	startDate := time.Now().AddDate(0, 0, -days).Truncate(24 * time.Hour)

	var data []models.ChartDataPoint

	switch metric {
	case "signups":
		h.db.Raw(`
			SELECT TO_CHAR(created_at, 'YYYY-MM-DD') as date, COUNT(*) as value
			FROM users
			WHERE created_at >= ?
			GROUP BY TO_CHAR(created_at, 'YYYY-MM-DD')
			ORDER BY date ASC
		`, startDate).Scan(&data)

	case "tasks":
		h.db.Raw(`
			SELECT TO_CHAR(created_at, 'YYYY-MM-DD') as date, COUNT(*) as value
			FROM tasks
			WHERE created_at >= ?
			GROUP BY TO_CHAR(created_at, 'YYYY-MM-DD')
			ORDER BY date ASC
		`, startDate).Scan(&data)

	case "sessions":
		h.db.Raw(`
			SELECT TO_CHAR(created_at, 'YYYY-MM-DD') as date, COUNT(*) as value
			FROM sessions
			WHERE created_at >= ?
			GROUP BY TO_CHAR(created_at, 'YYYY-MM-DD')
			ORDER BY date ASC
		`, startDate).Scan(&data)

	case "time":
		h.db.Raw(`
			SELECT TO_CHAR(created_at, 'YYYY-MM-DD') as date, COALESCE(SUM(duration), 0) as value
			FROM sessions
			WHERE created_at >= ?
			GROUP BY TO_CHAR(created_at, 'YYYY-MM-DD')
			ORDER BY date ASC
		`, startDate).Scan(&data)

	default:
		c.JSON(http.StatusBadRequest, gin.H{"error": "invalid metric"})
		return
	}

	c.JSON(http.StatusOK, models.ChartResponse{
		Period: period,
		Metric: metric,
		Data:   data,
	})
}
