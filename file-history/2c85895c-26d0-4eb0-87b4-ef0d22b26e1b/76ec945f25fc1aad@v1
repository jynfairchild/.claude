.delete-data-modal {
  width: 440px;
  border: 1px solid var(--kkan-grey-200);
  border-radius: 12px;
  background: var(--kkan-white);
  padding: 20px;
  box-shadow: 0 8px 24px rgba(0,0,0,0.08);
}

.delete-data-title {
  font-family: 'Berkeley Mono', monospace;
  font-size: 16px;
  font-weight: 700;
  color: var(--kkan-grey-950);
  margin: 0 0 8px 0;
}

.delete-data-message {
  font-family: 'Berkeley Mono', monospace;
  font-size: 14px;
  color: var(--kkan-grey-600);
  margin-bottom: 8px;
  line-height: 1.5;
}

.delete-data-warning {
  font-family: 'Berkeley Mono', monospace;
  font-size: 14px;
  font-weight: 700;
  color: var(--kkan-red-500);
  margin-bottom: 16px;
}

.delete-data-field {
  background: var(--kkan-white);
  border: 1px solid var(--kkan-grey-200);
  border-radius: 8px;
  padding: 10px 12px;
}

.delete-data-field.error {
  border-color: var(--kkan-red-400);
}

.delete-data-input {
  width: 100%;
  border: none;
  outline: none;
  background: transparent;
  color: var(--kkan-grey-900);
  font-family: 'Berkeley Mono', monospace;
  font-size: 14px;
  font-weight: 600;
}

.delete-data-input::placeholder {
  color: var(--kkan-grey-400);
}

.delete-data-input:disabled {
  opacity: 0.6;
}

.delete-data-error {
  font-family: 'Berkeley Mono', monospace;
  font-size: 13px;
  color: var(--kkan-red-500);
  margin-top: 8px;
  margin-bottom: 0;
}

.delete-data-actions {
  display: flex;
  justify-content: flex-end;
  gap: 12px;
  margin-top: 16px;
}

.delete-data-modal .btn-cancel {
  background: var(--kkan-grey-200);
  color: var(--kkan-grey-800);
  border: none;
  border-radius: 8px;
  padding: 8px 14px;
  font-family: 'Berkeley Mono', monospace;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
}

.delete-data-modal .btn-cancel:hover {
  background: var(--kkan-grey-300);
}

.delete-data-modal .btn-cancel:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

.delete-data-modal .btn-danger {
  background: #e5484d;
  color: white;
  border: none;
  border-radius: 8px;
  padding: 8px 14px;
  font-family: 'Berkeley Mono', monospace;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
}

.delete-data-modal .btn-danger:hover:not(:disabled) {
  background: #cf3b40;
}

.delete-data-modal .btn-danger:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}
