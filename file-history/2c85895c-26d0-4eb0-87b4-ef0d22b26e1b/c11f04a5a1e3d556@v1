.app-header {
  height: 76px;
  width: 100%;
  background: var(--color-white);
  flex-shrink: 0;
  display: flex;
  align-items: center;
  padding: 0 24px 0 44px;
}

.header-inner {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.header-left {
  display: flex;
  align-items: center;
}

.header-brand {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.brand-link {
  display: inline-flex;
  align-items: baseline;
  text-decoration: none;
  color: inherit;
}

.brand-wordmark {
  font-family: var(--font-primary);
  font-size: 22px;
  letter-spacing: 0.05em;
  display: inline-flex;
}

.brand-wordmark-base {
  font-weight: 900;
  color: var(--kkan-grey-900);
}

.brand-wordmark-accent {
  color: var(--kkan-grey-900);
  font-weight: 500;
}

.brand-badge {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-family: var(--font-primary);
  font-size: 13px;
  font-weight: 600;
  line-height: 1;
  margin-top: 2px;
  width: 100%;
}

.brand-badge-stage {
  color: var(--kkan-grey-400);
  letter-spacing: 0.08em;
  text-align: left;
}

.brand-badge-version {
  color: var(--kkan-grey-400);
  letter-spacing: -0.06em;
  text-align: right;
}

.header-nav {
  display: flex;
  align-items: center;
  margin-left: 80px;
  position: relative;
}

.nav-link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  height: 40px;
  padding: 0 18px;
  border-radius: 100px;
  font-size: 14px;
  font-weight: 600;
  color: var(--kkan-grey-600);
  background: var(--color-white);
  border: 1px solid var(--kkan-blue-100);
  position: relative;
  z-index: 0;
  transition: background var(--transition-fast), color var(--transition-fast), border-color var(--transition-fast), box-shadow var(--transition-fast);
}

.header-nav .nav-link + .nav-link { margin-left: -8px; }

.nav-link:hover,
.nav-link:focus-visible {
  color: var(--kkan-grey-800);
  background: var(--kkan-grey-25);
  outline: none;
}

.nav-link.active {
  color: var(--kkan-blue-700);
  background: var(--kkan-blue-25);
  border-color: transparent;
  z-index: 3;
}

.nav-icon { display: inline-flex; width: 24px; height: 24px; transition: filter var(--transition-fast); }
.nav-icon img { width: 100%; height: 100%; object-fit: contain; }
.nav-link.active .nav-icon img {
  filter: brightness(0) saturate(100%) invert(24%) sepia(34%) saturate(6868%) hue-rotate(209deg) brightness(86%) contrast(101%);
}

.header-right {
  margin-left: auto;
  display: inline-flex;
  align-items: center;
  justify-content: flex-end;
}

.header-account {
  display: flex;
  align-items: center;
}

.auth-links {
  display: flex;
  align-items: center;
  gap: 12px;
  font-size: 16px;
}

.auth-links a {
  color: var(--kkan-grey-800);
  text-decoration: none;
}

.user-menu {
  position: relative;
  display: inline-flex;
  align-items: center;
  gap: 8px;
}

.settings-button {
  width: 44px;
  height: 44px;
  padding: 0;
  border-radius: 8px;
  border: none;
  background: var(--color-white);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: background var(--transition-fast), color var(--transition-fast), box-shadow var(--transition-fast);
}

.settings-button img {
  width: 24px;
  height: 24px;
  object-fit: contain;
}

.settings-button:hover { background: var(--kkan-grey-50); }
.settings-button:focus-visible {
  background: var(--kkan-grey-50);
  outline: 2px solid rgba(53, 135, 249, 0.3);
  outline-offset: 2px;
}

.user-button {
  color: var(--kkan-grey-950);
  font-family: 'Berkeley Mono', monospace;
  font-size: 15px;
  font-variation-settings: 'wdth' 85;
  font-weight: 600;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 0 16px;
  height: 40px;
  background: transparent;
  border: 1px solid var(--kkan-grey-200);
  border-radius: 8px;
  cursor: pointer;
  transition: border-color var(--transition-fast), color var(--transition-fast), background var(--transition-fast);
}

.user-button:hover,
.user-button:focus-visible {
  border-color: var(--kkan-grey-400);
  color: var(--kkan-grey-800);
  outline: none;
}

.user-pill-icon {
  display: inline-flex;
  width: 24px;
  height: 24px;
}

.user-pill-icon img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.dropdown {
  position: absolute;
  right: 0;
  top: calc(100% + 6px);
  min-width: 160px;
  background: var(--color-white);
  border: 1px solid var(--kkan-grey-200);
  border-radius: 8px;
  box-shadow: 0 4px 20px rgba(0,0,0,0.08);
  padding: 6px;
  z-index: 1000;
}

.dropdown-item {
  font-family: 'Berkeley Mono', monospace;
  font-size: 14px;
  font-weight: 600;
  display: flex;
  width: 100%;
  text-align: left;
  padding: 8px 10px;
  border: none;
  background: transparent;
  text-decoration: none;
  border-radius: 6px;
  cursor: pointer;
  color: var(--kkan-grey-950);
}

.dropdown-item:hover { background: var(--kkan-grey-50); }
.dropdown-item.danger { color: var(--kkan-grey-900); }
.dropdown-item.danger:hover { background: var(--kkan-grey-50); }

.dropdown-divider {
  height: 1px;
  background: var(--kkan-grey-100);
  margin: 6px 0;
}
