package handlers

import (
	"log"
	"net/http"
	"os"
	"strings"

	"github.com/gin-gonic/gin"
	"gorm.io/gorm"

	"simple_task_tracker/backend/internal/auth"
	"simple_task_tracker/backend/internal/email"
	"simple_task_tracker/backend/internal/models"
)

type InvitationHandler struct {
	db *gorm.DB
}

func NewInvitationHandler(db *gorm.DB) *InvitationHandler {
	return &InvitationHandler{db: db}
}

type CreateInvitationRequest struct {
	Email string `json:"email" binding:"required,email"`
}

type CreateInvitationResponse struct {
	InviteURL string `json:"invite_url"`
	Email     string `json:"email"`
	ExpiresAt string `json:"expires_at"`
}

type ValidateInvitationResponse struct {
	Email     string `json:"email"`
	ExpiresAt string `json:"expires_at"`
	Valid     bool   `json:"valid"`
}

// Create creates a new invitation for the given email address.
// Requires admin privileges.
func (h *InvitationHandler) Create(c *gin.Context) {
	// Get the current user ID from context (set by auth middleware)
	userID, exists := c.Get("userID")
	if !exists {
		c.JSON(http.StatusUnauthorized, gin.H{"error": "unauthorized"})
		return
	}

	var req CreateInvitationRequest
	if err := c.ShouldBindJSON(&req); err != nil {
		c.JSON(http.StatusBadRequest, gin.H{"error": "invalid request: " + err.Error()})
		return
	}

	// Normalize email
	recipientEmail := strings.ToLower(strings.TrimSpace(req.Email))

	// Check if user with this email already exists
	var existingUser models.User
	if err := h.db.Where("email = ?", recipientEmail).First(&existingUser).Error; err == nil {
		c.JSON(http.StatusConflict, gin.H{"error": "user with this email already exists"})
		return
	}

	// Check if there's already a valid invitation for this email
	var existingInvite models.Invitation
	if err := h.db.Where("email = ? AND used_at IS NULL AND expires_at > NOW()", recipientEmail).First(&existingInvite).Error; err == nil {
		c.JSON(http.StatusConflict, gin.H{"error": "pending invitation already exists for this email"})
		return
	}

	// Create the invitation token
	token, invite, err := auth.CreateInvitationToken(h.db, recipientEmail, userID.(uint))
	if err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{"error": "failed to create invitation"})
		return
	}

	// Build the invite URL
	frontendURL := os.Getenv("FRONTEND_URL")
	if frontendURL == "" {
		frontendURL = "http://localhost:3000"
	}
	inviteURL := frontendURL + "/signup?invite=" + token

	// Send invite email
	if err := email.SendInviteEmail(recipientEmail, inviteURL); err != nil {
		log.Printf("Failed to send invite email to %s: %v", recipientEmail, err)
		// Don't fail the request - still return the URL
	}

	c.JSON(http.StatusCreated, CreateInvitationResponse{
		InviteURL: inviteURL,
		Email:     invite.Email,
		ExpiresAt: invite.ExpiresAt.Format("2006-01-02T15:04:05Z07:00"),
	})
}

// Validate checks if an invitation token is valid (public endpoint).
// Used by the frontend signup page to verify the invite before showing the form.
func (h *InvitationHandler) Validate(c *gin.Context) {
	token := c.Param("token")
	if token == "" {
		c.JSON(http.StatusBadRequest, gin.H{"error": "missing token"})
		return
	}

	invite, err := auth.ValidateInvitationToken(h.db, token)
	if err != nil {
		c.JSON(http.StatusNotFound, gin.H{"error": "invalid or expired invitation"})
		return
	}

	c.JSON(http.StatusOK, ValidateInvitationResponse{
		Email:     invite.Email,
		ExpiresAt: invite.ExpiresAt.Format("2006-01-02T15:04:05Z07:00"),
		Valid:     true,
	})
}

// List returns all invitations (admin only, for management).
func (h *InvitationHandler) List(c *gin.Context) {
	var invites []models.Invitation
	if err := h.db.Order("created_at DESC").Limit(100).Find(&invites).Error; err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{"error": "failed to list invitations"})
		return
	}

	c.JSON(http.StatusOK, gin.H{"invitations": invites})
}

// Revoke invalidates an invitation by marking it as used.
func (h *InvitationHandler) Revoke(c *gin.Context) {
	id := c.Param("id")
	if id == "" {
		c.JSON(http.StatusBadRequest, gin.H{"error": "missing invitation id"})
		return
	}

	var invite models.Invitation
	if err := h.db.First(&invite, id).Error; err != nil {
		c.JSON(http.StatusNotFound, gin.H{"error": "invitation not found"})
		return
	}

	if invite.UsedAt != nil {
		c.JSON(http.StatusBadRequest, gin.H{"error": "invitation already used"})
		return
	}

	if err := h.db.Delete(&invite).Error; err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{"error": "failed to revoke invitation"})
		return
	}

	c.JSON(http.StatusOK, gin.H{"message": "invitation revoked"})
}
