/**
 * Zero-Knowledge Encryption Utilities
 *
 * Uses Web Crypto API for client-side encryption:
 * - PBKDF2 with 600,000 iterations for key derivation
 * - AES-256-GCM for encryption/decryption
 *
 * The server never sees plaintext - only encrypted blobs.
 */

// Configuration
const PBKDF2_ITERATIONS = 600000; // Industry standard (LastPass uses 600K)
const SALT_LENGTH = 32; // 256 bits
const IV_LENGTH = 12; // 96 bits for GCM

/**
 * Generate a random salt for key derivation.
 * Called once during signup, stored in database.
 */
export function generateSalt(): Uint8Array {
  return crypto.getRandomValues(new Uint8Array(SALT_LENGTH));
}

/**
 * Convert Uint8Array to base64 string for storage/transmission.
 */
export function bytesToBase64(bytes: Uint8Array): string {
  return btoa(String.fromCharCode(...bytes));
}

/**
 * Convert base64 string back to Uint8Array.
 */
export function base64ToBytes(base64: string): Uint8Array {
  const binary = atob(base64);
  const bytes = new Uint8Array(binary.length);
  for (let i = 0; i < binary.length; i++) {
    bytes[i] = binary.charCodeAt(i);
  }
  return bytes;
}

/**
 * Derive an AES-256-GCM encryption key from a password using PBKDF2.
 * This is the core of zero-knowledge encryption - the key never leaves the browser.
 */
export async function deriveKey(password: string, salt: Uint8Array): Promise<CryptoKey> {
  // Import password as key material
  const keyMaterial = await crypto.subtle.importKey(
    'raw',
    new TextEncoder().encode(password),
    'PBKDF2',
    false,
    ['deriveKey']
  );

  // Derive AES-256-GCM key using PBKDF2
  return crypto.subtle.deriveKey(
    {
      name: 'PBKDF2',
      salt: salt,
      iterations: PBKDF2_ITERATIONS,
      hash: 'SHA-256',
    },
    keyMaterial,
    { name: 'AES-GCM', length: 256 },
    true, // Extractable - needed to persist in sessionStorage for page refresh
    ['encrypt', 'decrypt']
  );
}

/**
 * Encrypt a string and return base64-encoded ciphertext.
 * Format: [12-byte IV][ciphertext][16-byte auth tag]
 */
export async function encrypt(plaintext: string, key: CryptoKey): Promise<string> {
  // Handle empty strings - return empty string (no encryption needed)
  if (!plaintext) return '';

  // Generate random IV for each encryption
  const iv = crypto.getRandomValues(new Uint8Array(IV_LENGTH));

  // Encrypt
  const ciphertext = await crypto.subtle.encrypt(
    { name: 'AES-GCM', iv },
    key,
    new TextEncoder().encode(plaintext)
  );

  // Combine IV + ciphertext into single buffer
  const combined = new Uint8Array(iv.length + ciphertext.byteLength);
  combined.set(iv, 0);
  combined.set(new Uint8Array(ciphertext), iv.length);

  return bytesToBase64(combined);
}

/**
 * Decrypt a base64-encoded ciphertext back to string.
 */
export async function decrypt(ciphertextBase64: string, key: CryptoKey): Promise<string> {
  // Handle empty strings
  if (!ciphertextBase64) return '';

  const combined = base64ToBytes(ciphertextBase64);

  // Extract IV and ciphertext
  const iv = combined.slice(0, IV_LENGTH);
  const ciphertext = combined.slice(IV_LENGTH);

  // Decrypt
  const plaintext = await crypto.subtle.decrypt(
    { name: 'AES-GCM', iv },
    key,
    ciphertext
  );

  return new TextDecoder().decode(plaintext);
}

/**
 * Encrypt an array of strings (for tags).
 * Encrypts the JSON representation of the array.
 */
export async function encryptArray(items: string[], key: CryptoKey): Promise<string> {
  if (!items || items.length === 0) return '';
  return encrypt(JSON.stringify(items), key);
}

/**
 * Decrypt an array of strings.
 */
export async function decryptArray(ciphertextBase64: string, key: CryptoKey): Promise<string[]> {
  if (!ciphertextBase64) return [];
  const json = await decrypt(ciphertextBase64, key);
  return JSON.parse(json);
}

/**
 * Check if the Web Crypto API is available.
 * Should be true in all modern browsers.
 */
export function isCryptoAvailable(): boolean {
  return typeof crypto !== 'undefined' &&
         typeof crypto.subtle !== 'undefined' &&
         typeof crypto.getRandomValues !== 'undefined';
}
