'use client';

import React, { useState, useEffect, useCallback, useRef } from 'react';
import './NewOnboardingTaskCard.css';
import Image from 'next/image';
import playButtonIcon from '@/assets/components/ticket/play_24px.svg';
import pauseButtonIcon from '@/assets/components/ticket/stop_24px.svg';
import addIcon from '@/assets/components/kanban/add_24px.svg';
import { useTask } from '@/contexts/TaskContext';
import { useTimerWorker } from '@/contexts/TimerWorkerContext';

interface NewOnboardingTaskCardProps {
  onTimerStart?: () => void;
}

export default function NewOnboardingTaskCard({ onTimerStart }: NewOnboardingTaskCardProps = {}) {
  const { activeTask, startTask, stopTask } = useTask();
  const { seconds, start: startTimer, stop: stopTimer, isRunning } = useTimerWorker();

  const [title, setTitle] = useState('');
  const [project, setProject] = useState('');
  const [isEditingProject, setIsEditingProject] = useState(false);
  const [tags, setTags] = useState<string[]>([]);
  const [tagInput, setTagInput] = useState('');
  const [isAddingTag, setIsAddingTag] = useState(false);
  const [editingTagIndex, setEditingTagIndex] = useState<number | null>(null);
  const [editingTagValue, setEditingTagValue] = useState('');
  const [isAnimatingOut, setIsAnimatingOut] = useState(false);

  const projectInputRef = useRef<HTMLInputElement>(null);
  const tagInputRef = useRef<HTMLInputElement>(null);
  const tagEditInputRef = useRef<HTMLInputElement>(null);

  const formatTime = (value: number): string => {
    return value.toString().padStart(2, '0');
  };

  // Focus project input when entering edit mode
  useEffect(() => {
    if (isEditingProject && projectInputRef.current) {
      const el = projectInputRef.current;
      el.focus();
      try {
        const len = el.value.length;
        el.setSelectionRange(len, len);
      } catch {}
    }
  }, [isEditingProject]);

  // Focus tag input when adding new tag
  useEffect(() => {
    if (isAddingTag && tagInputRef.current) {
      tagInputRef.current.focus();
    }
  }, [isAddingTag]);

  // Focus tag edit input
  useEffect(() => {
    if (editingTagIndex !== null && tagEditInputRef.current) {
      const el = tagEditInputRef.current;
      el.focus();
      try {
        const len = el.value.length;
        el.setSelectionRange(len, len);
      } catch {}
    }
  }, [editingTagIndex]);

  const toggleTimer = useCallback(async () => {
    if (isRunning && activeTask) {
      // Stop the active timer
      // For the first session, total duration equals session duration
      const totalDuration = activeTask.duration + seconds;
      await stopTask(totalDuration, seconds); // Pass correct total and session duration
      stopTimer(); // Stop the shared timer AFTER stopping the task
    } else {
      // Start a new task
      try {
        // Create a new task - send exactly what the user typed
        await startTask(title, project, tags);

        // Start the shared timer
        startTimer();

        // Animate the card away for onboarding
        setIsAnimatingOut(true);
        if (onTimerStart) {
          onTimerStart();
        }
      } catch (error) {
        console.error('Failed to start task:', error);
      }
    }
  }, [title, project, tags, isRunning, activeTask, seconds, stopTask, startTask, startTimer, stopTimer, onTimerStart]);

  // Keyboard shortcut for play/pause
  useEffect(() => {
    const handleKeyDown = (e: KeyboardEvent) => {
      // Check for Cmd+K (Mac) or Ctrl+K (Windows/Linux)
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault(); // Prevent default browser behavior
        toggleTimer();
      }
    };

    document.addEventListener('keydown', handleKeyDown);

    return () => {
      document.removeEventListener('keydown', handleKeyDown);
    };
  }, [toggleTimer]); // Depend on toggleTimer to get fresh values

  // Project handlers
  const handleProjectClick = () => {
    setIsEditingProject(true);
  };

  const handleProjectBlur = () => {
    setIsEditingProject(false);
  };

  const handleProjectKeyDown = (e: React.KeyboardEvent<HTMLInputElement>) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      setIsEditingProject(false);
    } else if (e.key === 'Tab') {
      // Save and let Tab naturally move to next field (tags)
      setIsEditingProject(false);
      // Focus will move to next focusable element (tag add button) which triggers its onFocus
    } else if (e.key === 'Escape') {
      setIsEditingProject(false);
    } else if ((e.key === 'Backspace' || e.key === 'Delete') && project.trim().length === 0) {
      e.preventDefault();
      setProject('');
      setIsEditingProject(false);
    }
  };

  // Tag handlers
  const handleStartAddTag = () => {
    setIsAddingTag(true);
    setTimeout(() => {
      tagInputRef.current?.focus();
    }, 0);
  };

  const handleAddTag = () => {
    const next = tagInput.trim();
    if (!next) return;
    if (tags.includes(next)) {
      setTagInput('');
      return;
    }
    setTags([...tags, next]);
    setTagInput('');
  };

  const handleTagInputKeyDown = (e: React.KeyboardEvent<HTMLInputElement>) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      handleAddTag();
      // Keep input open for adding more tags
    } else if (e.key === 'Tab') {
      // Add tag if there's content, then let Tab move naturally
      if (tagInput.trim()) {
        handleAddTag();
      }
      setIsAddingTag(false);
    } else if (e.key === 'Escape') {
      setTagInput('');
      setIsAddingTag(false);
    }
  };

  const beginEditTag = (index: number) => {
    setIsAddingTag(false);
    setEditingTagIndex(index);
    setEditingTagValue(tags[index] ?? '');
    setTimeout(() => {
      tagEditInputRef.current?.focus();
    }, 0);
  };

  const commitEditTag = () => {
    if (editingTagIndex === null) return;
    const idx = editingTagIndex;
    const value = editingTagValue.trim();
    setEditingTagIndex(null);
    if (!value) {
      setEditingTagValue('');
      return;
    }
    // Prevent duplicates
    const duplicateAt = tags.findIndex((t, i) => i !== idx && t === value);
    if (duplicateAt !== -1) {
      setEditingTagValue('');
      return;
    }
    const newTags = [...tags];
    newTags[idx] = value;
    setTags(newTags);
    setEditingTagValue('');
  };

  const cancelEditTag = () => {
    setEditingTagIndex(null);
    setEditingTagValue('');
  };

  const handleTagEditKeyDown = (e: React.KeyboardEvent<HTMLInputElement>) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      commitEditTag();
      return;
    }
    if (e.key === 'Tab') {
      // Commit edit and let Tab move naturally
      commitEditTag();
      return;
    }
    if (e.key === 'Escape') {
      e.preventDefault();
      cancelEditTag();
      return;
    }
    if ((e.key === 'Backspace' || e.key === 'Delete') && editingTagValue.length === 0) {
      // Delete tag when empty and backspacing
      e.preventDefault();
      if (editingTagIndex !== null) {
        const newTags = tags.filter((_, i) => i !== editingTagIndex);
        setTags(newTags);
        cancelEditTag();
      }
    }
  };

  const hasProject = project.trim() !== '';

  return (
    <div className={`ticket ${isAnimatingOut ? 'animating-out' : ''}`}>
      <div className="ticketLeft" onClick={toggleTimer}>
        <div className="playButton">
          <Image
            src={isRunning ? pauseButtonIcon : playButtonIcon}
            alt={isRunning ? "Pause" : "Play"}
            width={24}
            height={24}
          />
        </div>
        <div className="shortcut-hint">
          <span className="shortcut-cmd">⌘</span>
          <span className="shortcut-key">K</span>
        </div>
      </div>

      <div className="ticketCenter">
        <div className="ticketHeader">
          <span className="taskLabel">TASK</span>
          <textarea
            className="taskInput"
            placeholder="Add a task"
            value={title}
            onChange={(e) => setTitle(e.target.value)}
            rows={2}
          />
        </div>

        <div className="ticketFooter">
          <div className="projectSection">
            <span className="fieldLabel">PROJECT</span>
            <div className="ticket-project">
              {isEditingProject ? (
                <input
                  ref={projectInputRef}
                  type="text"
                  className="ticket-project-input"
                  value={project}
                  onChange={(e) => setProject(e.target.value)}
                  onBlur={handleProjectBlur}
                  onKeyDown={handleProjectKeyDown}
                  placeholder="Add project"
                  size={project.length || 11}
                />
              ) : hasProject ? (
                <span className="ticket-project-text" onClick={handleProjectClick}>
                  {project}
                </span>
              ) : (
                <button
                  type="button"
                  className="ticket-project-add"
                  onClick={handleProjectClick}
                  onFocus={handleProjectClick}
                  aria-label="Add project"
                >
                  <Image src={addIcon} alt="Add" width={20} height={20} />
                </button>
              )}
            </div>
          </div>

          <div className="tagsSection">
            <span className="fieldLabel">TAGS</span>
            <div className="ticket-tags">
              {tags.map((tag, index) => (
                editingTagIndex === index ? (
                  <div key={`${tag}-${index}-edit`} className="ticket-tag ticket-tag-edit">
                    <input
                      ref={tagEditInputRef}
                      type="text"
                      className="ticket-tag-input"
                      autoFocus
                      value={editingTagValue}
                      onChange={(e) => setEditingTagValue(e.target.value)}
                      onKeyDown={handleTagEditKeyDown}
                      onBlur={commitEditTag}
                      size={(editingTagValue || tag).length || 1}
                    />
                  </div>
                ) : (
                  <button
                    key={`${tag}-${index}`}
                    className="ticket-tag"
                    type="button"
                    onClick={() => beginEditTag(index)}
                  >
                    {tag}
                  </button>
                )
              ))}
              {isAddingTag ? (
                <div className="ticket-tag ticket-tag-add ticket-tag-add--active" onClick={() => tagInputRef.current?.focus()}>
                  <input
                    ref={tagInputRef}
                    type="text"
                    className="ticket-tag-input"
                    placeholder="Add tag"
                    autoFocus
                    value={tagInput}
                    onChange={(e) => setTagInput(e.target.value)}
                    onKeyDown={handleTagInputKeyDown}
                    onBlur={() => { if (!tagInput.trim()) setIsAddingTag(false); }}
                    size={tagInput.length || 7}
                  />
                </div>
              ) : (
                <button className="ticket-tag ticket-tag-add" type="button" onClick={handleStartAddTag} onFocus={handleStartAddTag} aria-label="Add tag">
                  <Image src={addIcon} alt="Add" width={20} height={20} />
                </button>
              )}
            </div>
          </div>
        </div>
      </div>

      <div className={`ticketRight ${isRunning ? 'running' : ''}`}>
        <div className={`timer ${isRunning ? 'running' : ''}`}>
          {formatTime(Math.floor(seconds / 3600))}:{formatTime(Math.floor((seconds % 3600) / 60))}:{formatTime(seconds % 60)}
        </div>
      </div>
    </div>
  );
}
