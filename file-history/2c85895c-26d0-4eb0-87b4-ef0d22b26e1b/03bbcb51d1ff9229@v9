'use client';

import React from 'react';
import Link from 'next/link';
import { usePathname } from 'next/navigation';
import { useAuth } from '@/contexts/AuthContext';
import './Header.css';
import Dropdown from '@/components/ui/Dropdown';

const NAV_LINKS = [
  { label: 'Dashboard', href: '/dashboard', icon: '/icons/dashboard_24px.svg' },
  // { label: 'Time', href: '/time', icon: '/icons/date_range_24px.svg' }, // TODO: Re-enable when Time page is ready
];

export function Header() {
  const { user, isAuthenticated, loading, logout } = useAuth();
  const pathname = usePathname();
  const appVersion = process.env.NEXT_PUBLIC_APP_VERSION ?? '0.0.0';

  return (
    <header className="app-header">
      <div className="header-inner">
        <div className="header-left">
          <div className="header-brand">
            <Link href="/dashboard" className="brand-link" aria-label="Astrotask home">
              <span className="brand-wordmark">
                <span className="brand-wordmark-base">ASTRO</span>
                <span className="brand-wordmark-accent">TASK</span>
              </span>
            </Link>
            <div className="brand-badge" aria-label={`Astrotask alpha version ${appVersion}`}>
              <span className="brand-badge-stage">ALPHA</span>
              <span className="brand-badge-version">{appVersion}</span>
            </div>
          </div>

          <nav className="header-nav" aria-label="Main navigation">
            {NAV_LINKS.map(({ label, href, icon }) => {
              const isActive = pathname === href || (href !== '/' && pathname?.startsWith(href));
              return (
                <Link
                  key={href}
                  href={href}
                  className={`nav-link${isActive ? ' active' : ''}`}
                  aria-current={isActive ? 'page' : undefined}
                >
                  <span className="nav-icon" aria-hidden="true">
                    <img src={icon} alt="" />
                  </span>
                  {label}
                </Link>
              );
            })}
          </nav>
        </div>

        <div className="header-right">

          <div className="header-account">
            {user ? (
              <div className="user-menu">
                {/* Settings button hidden for now - may add settings panel later
                <button type="button" className="settings-button" aria-label="Open settings">
                  <img src="/icons/settings_24px.svg" alt="" aria-hidden="true" />
                </button>
                */}
                <Dropdown
                  align="right"
                  trigger={({ onClick, "aria-expanded": expanded }) => (
                    <button className="user-button" onClick={onClick} aria-haspopup="menu" aria-expanded={expanded}>
                      <span className="user-pill-label">{user.name}</span>
                      <span className="user-pill-icon" aria-hidden="true">
                        <img src="/icons/keyboard_arrow_down_24px.svg" alt="" />
                      </span>
                    </button>
                  )}
                >
                  {(close) => (
                    <>
                      <Link href="/settings" className="dropdown-item" onClick={() => close()}>Settings</Link>
                      {user.role === 'admin' && (
                        <Link href="/metrics" className="dropdown-item" onClick={() => close()}>Admin</Link>
                      )}
                      <button
                        className="dropdown-item"
                        onClick={() => {
                          try {
                            localStorage.removeItem('onboardingComplete');
                          } catch {}
                          close();
                          try { window.location.reload(); } catch {}
                        }}
                      >
                        Restart onboarding
                      </button>
                      <div className="dropdown-divider" />
                      <Link href="/terms" className="dropdown-item" onClick={() => close()}>Terms</Link>
                      <Link href="/privacy" className="dropdown-item" onClick={() => close()}>Privacy</Link>
                      <div className="dropdown-divider" />
                      <button className="dropdown-item danger" onClick={async () => { await logout(); close(); try { window.location.replace('/login'); } catch {} }}>Logout</button>
                    </>
                  )}
                </Dropdown>
              </div>
            ) : isAuthenticated && !loading ? (
              <div className="auth-links" aria-busy="true" aria-live="polite">Loading…</div>
            ) : (
              <div className="auth-links">
                <Link href="/login">Log in</Link>
              </div>
            )}
          </div>
        </div>
      </div>
    </header>
  );
}
