import React from 'react';
import { describe, it, expect, vi, beforeEach, afterEach } from 'vitest';
import { render, screen, waitFor, act } from '@testing-library/react';
import { AuthProvider, useAuth } from '@/contexts/AuthContext';
import * as authApiModule from '@/services/authApi';
import { resetRefreshGateForTests } from '@/services/refreshGate';

type MeResponse = Awaited<ReturnType<typeof authApiModule.authApi.me>>;

function TestConsumer() {
  const { user, loading, isAuthenticated } = useAuth();
  return (
    <div>
      <span data-testid="loading">{loading ? 'loading' : 'ready'}</span>
      <span data-testid="authenticated">{isAuthenticated ? 'yes' : 'no'}</span>
      <span data-testid="user">{user?.email || 'none'}</span>
    </div>
  );
}

describe('AuthContext cookie-based auth', () => {
  beforeEach(() => {
    localStorage.clear();
    resetRefreshGateForTests();
  });
  afterEach(() => {
    vi.restoreAllMocks();
  });

  it('calls checkAuth on mount via authApi.me', async () => {
    const meSpy = vi.spyOn(authApiModule.authApi, 'me').mockResolvedValue({
      user: { id: 1, email: 'test@example.com', name: 'Test User' }
    } as MeResponse);

    render(
      <AuthProvider>
        <TestConsumer />
      </AuthProvider>
    );

    await waitFor(() => {
      expect(screen.getByTestId('loading').textContent).toBe('ready');
    });

    expect(meSpy).toHaveBeenCalledTimes(1);
    expect(screen.getByTestId('authenticated').textContent).toBe('yes');
    expect(screen.getByTestId('user').textContent).toBe('test@example.com');
  });

  it('refreshes on visibilitychange when user is logged in', async () => {
    const meSpy = vi.spyOn(authApiModule.authApi, 'me').mockResolvedValue({
      user: { id: 1, email: 'e@e.com', name: 'n' }
    } as MeResponse);
    const refreshSpy = vi.spyOn(authApiModule.authApi, 'refresh').mockResolvedValue({} as any);

    render(
      <AuthProvider>
        <TestConsumer />
      </AuthProvider>
    );

    await waitFor(() => {
      expect(screen.getByTestId('loading').textContent).toBe('ready');
    });

    // Initial load calls me, no refresh yet
    expect(meSpy).toHaveBeenCalledTimes(1);
    expect(refreshSpy).toHaveBeenCalledTimes(0);

    // Simulate visibility change
    Object.defineProperty(document, 'visibilityState', { configurable: true, get: () => 'visible' });
    await act(async () => {
      document.dispatchEvent(new Event('visibilitychange'));
    });

    // Refresh should be called when returning to tab
    await waitFor(() => {
      expect(refreshSpy).toHaveBeenCalledTimes(1);
    });
  });

  it('does not refresh on visibilitychange when user is not logged in', async () => {
    const meSpy = vi.spyOn(authApiModule.authApi, 'me').mockRejectedValue(new Error('Unauthorized'));
    const refreshSpy = vi.spyOn(authApiModule.authApi, 'refresh').mockRejectedValue(new Error('No token'));

    render(
      <AuthProvider>
        <TestConsumer />
      </AuthProvider>
    );

    await waitFor(() => {
      expect(screen.getByTestId('loading').textContent).toBe('ready');
    });

    // checkAuth tried me, then refresh (both failed)
    expect(meSpy).toHaveBeenCalledTimes(1);
    // refresh was called during checkAuth recovery attempt
    const callsBefore = refreshSpy.mock.calls.length;

    // Simulate visibility change
    Object.defineProperty(document, 'visibilityState', { configurable: true, get: () => 'visible' });
    await act(async () => {
      document.dispatchEvent(new Event('visibilitychange'));
    });

    // Small wait to ensure no additional calls
    await new Promise(r => setTimeout(r, 50));

    // No additional refresh should be called (user is null)
    expect(refreshSpy.mock.calls.length).toBe(callsBefore);
  });
});
