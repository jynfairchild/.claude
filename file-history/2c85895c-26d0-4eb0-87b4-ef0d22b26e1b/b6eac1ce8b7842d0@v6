.ticket {
  display: flex;
  align-items: stretch;
  height: 242px;
  width: 100%;
  max-width: 900px;
}

@keyframes slideInFromRight {
  from {
    opacity: 0;
    transform: translateX(140px);
  }
  to {
    opacity: 1s;
    transform: translateX(0);
  }
}

.ticketLeft {
  position: relative;
  display: flex;
  width: 90px;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  align-self: stretch;
  border-radius: 8px;
  border: 1px solid var(--kkan-grey-200);
  background: var(--kkan-grey-25);
  box-shadow: var(--shadow-default);
  transition: background 0.2s;
  cursor: pointer;
  animation: slideInFromRight 900ms cubic-bezier(0.4, 0, 0.2, 1);
}

.ticketLeft:hover {
  background: var(--kkan-grey-50);
}

.playButton {
  width: 48px;
  height: 48px;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}

.playButton img {
  width: 40px;
  height: 40px;
  filter: brightness(0) saturate(100%) invert(27%) sepia(15%) saturate(1107%) hue-rotate(184deg) brightness(93%) contrast(88%);
}

.shortcut-hint {
  position: absolute;
  bottom: 16px;
  display: flex;
  align-items: center;
  gap: 2px;
  font-family: 'Berkeley Mono', monospace;
  color: var(--kkan-grey-300);
}

.shortcut-cmd {
  font-size: 22px;
  font-weight: 900;
  line-height: 1;
  position: relative;
  top: 1px;
}

.shortcut-key {
  font-size: 18px;
  font-weight: 600;
  line-height: 1;
  letter-spacing: 0.02em;
}

.ticketCenter {
  display: flex;
  width: 456px;
  height: 242px;
  padding: 32px 32px 32px 32px;
  flex-direction: column;
  justify-content: space-between;
  align-items: flex-start;
  align-self: stretch;
  border-radius: 8px;
  border: 1px solid var(--kkan-grey-200);
  background: var(--kkan-white);
  box-shadow: var(--shadow-default);
  margin-left: -1px;
  margin-right: -1px;
  animation: slideInFromRight 900ms cubic-bezier(0.4, 0, 0.2, 1);
  animation-delay: 100ms;
  animation-fill-mode: backwards;
}

.ticketHeader {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.taskLabel {
  font-family: 'Berkeley Mono', monospace;
  font-size: 11px;
  font-weight: 800;
  font-stretch: semi-condensed;
  letter-spacing: 0.08em;
  color: var(--kkan-grey-500);
}

.taskInput {
  font-family: 'Berkeley Mono', monospace;
  font-size: 24px;
  font-weight: 800;
  font-stretch: condensed;
  line-height: 36px;
  color: var(--kkan-grey-950);
  border: none;
  outline: none;
  padding: 0;
  background: transparent;
  width: 100%;
  resize: none;
  overflow: hidden;
}

.taskInput::placeholder {
  color: var(--kkan-grey-300);
}

.ticketFooter {
  display: flex;
  gap: 40px;
}

.projectSection,
.tagsSection {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.fieldLabel {
  font-family: 'Berkeley Mono', monospace;
  font-size: 11px;
  font-weight: 800;
  font-stretch: semi-condensed;
  letter-spacing: 0.08em;
  color: var(--kkan-grey-500);
}

.fieldInput {
  font-family: 'Berkeley Mono', monospace;
  font-size: 16px;
  font-weight: 700;
  color: var(--kkan-grey-950);
  border: none;
  outline: none;
  padding: 0;
  background: transparent;
  width: 180px;
}

.fieldInput::placeholder {
  color: var(--kkan-grey-300);
  font-weight: 700;
}

.ticketRight {
  display: flex;
  padding: 40px;
  flex-direction: column;
  justify-content: center;
  align-items: flex-end;
  gap: 24px;
  align-self: stretch;
  border-radius: 8px;
  border: 1px solid var(--kkan-grey-200);
  background: var(--kkan-white);
  box-shadow: var(--shadow-default);
  transition: all 0.3s;
  animation: slideInFromRight 900ms cubic-bezier(0.1, 0, 0.2, 1);
  animation-delay: 200ms;
  animation-fill-mode: backwards;
}

.ticketRight.running {
  border: 1px solid var(--kkan-blue-400);
  background: var(--kkan-blue-50);
  box-shadow: 0 6px 0 0 rgba(30, 114, 235, 0.16);
}

.timer {
  font-family: 'Berkeley Mono', monospace;
  font-size: 40px;
  font-weight: 700;
  color: var(--kkan-grey-500);
  font-variant-numeric: tabular-nums;
  letter-spacing: 0.02em;
  line-height: 40px;
  transition: color 0.3s;
}

.timer.running {
  color: var(--kkan-blue-600);
}

/* Animation for ticket card going away */
@keyframes slideOutDown {
  from {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }
  to {
    opacity: 0;
    transform: translateX(-50%) translateY(100px);
  }
}

.ticket.animating-out {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  animation: slideOutDown 0.6s cubic-bezier(0.4, 0, 0.2, 1) 2s forwards;
}

/* Project styles */
.ticket-project {
  display: inline-flex;
  align-items: center;
  border-radius: 4px;
  padding: 6px 16px;
  background-color: var(--kkan-grey-50);
  min-height: 34px;
}

.ticket-project:has(.ticket-project-add) {
  padding: 0;
  width: 34px;
  height: 34px;
  justify-content: center;
}

.ticket-project:has(.ticket-project-text) {
  background-color: var(--kkan-blue-50);
}

.ticket-project-text {
  font-family: 'Berkeley Mono', monospace;
  font-size: 14px;
  font-weight: 700;
  color: var(--kkan-blue-700);
  cursor: pointer;
  transition: color 0.2s;
}

.ticket-project-text:hover {
  color: var(--kkan-blue-500);
}

.ticket-project-input {
  font-family: 'Berkeley Mono', monospace;
  font-size: 14px;
  font-weight: 700;
  color: var(--kkan-grey-700);
  border: none;
  padding: 0;
  background-color: transparent;
  outline: none;
  width: auto;
  min-width: 2ch;
}

.ticket-project-input::placeholder {
  color: var(--kkan-grey-400);
}

.ticket-project-add {
  background: transparent;
  border: none;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  cursor: pointer;
}

.ticket-project-add img {
  filter: brightness(0) saturate(100%) invert(31%) sepia(9%) saturate(556%) hue-rotate(182deg) brightness(94%) contrast(91%);
  transition: filter 0.2s;
}

.ticket-project-add:hover img {
  filter: brightness(0) saturate(100%) invert(13%) sepia(5%) saturate(1016%) hue-rotate(196deg) brightness(94%) contrast(86%);
}

/* Tags styles */
.ticket-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  align-items: center;
}

.ticket-tag {
  align-items: center;
  background-color: var(--kkan-grey-25);
  border-radius: 54px;
  border: none;
  display: inline-flex;
  justify-content: center;
  padding: 6px 12px;
  color: var(--kkan-grey-800);
  font-family: 'Berkeley Mono', monospace;
  font-size: 14px;
  font-weight: 700;
  line-height: 22px;
  white-space: nowrap;
  cursor: pointer;
  transition: background 0.2s;
}

.ticket-tag:hover {
  background: var(--kkan-grey-50);
}

.ticket-tag-add {
  width: 34px;
  height: 34px;
  padding: 0;
  justify-content: center;
}

.ticket-tag-add img {
  filter: brightness(0) saturate(100%) invert(25%) sepia(6%) saturate(1491%) hue-rotate(182deg) brightness(94%) contrast(90%);
  transition: filter 0.2s;
}

.ticket-tag-add:hover img {
  filter: brightness(0) saturate(100%) invert(13%) sepia(5%) saturate(1016%) hue-rotate(196deg) brightness(94%) contrast(86%);
}

.ticket-tag-add--active {
  width: auto;
  min-width: calc(7ch + 24px);
  padding: 6px 12px;
  cursor: text;
}

.ticket-tag-input {
  font-family: 'Berkeley Mono', monospace;
  font-size: 14px;
  font-weight: 700;
  line-height: 22px;
  color: var(--kkan-grey-800);
  border: none;
  outline: none;
  background: transparent;
  padding: 0;
  width: auto;
  min-width: 7ch;
}

.ticket-tag-input::placeholder {
  color: var(--kkan-grey-400);
}

.ticket-tag-edit {
  height: 34px;
  padding: 6px 12px;
  cursor: text;
}

.ticket-tag-edit .ticket-tag-input {
  min-width: 2ch;
}
