.legal-page {
  min-height: 100vh;
  background: var(--kkan-white);
}

.legal-content {
  max-width: 680px;
  margin: 0 auto;
  padding: 0 40px 80px;
}

.legal-title {
  font-family: var(--font-primary);
  font-size: 32px;
  font-weight: 700;
  color: var(--kkan-grey-900);
  margin: 0 0 8px 0;
  letter-spacing: 0.02em;
}

.legal-meta {
  font-family: var(--font-primary);
  font-size: 14px;
  font-weight: 500;
  color: var(--kkan-grey-500);
  margin: 0 0 40px 0;
}

.legal-heading {
  font-family: var(--font-primary);
  font-size: 18px;
  font-weight: 700;
  color: var(--kkan-grey-900);
  margin: 32px 0 12px 0;
}

.legal-paragraph {
  font-family: var(--font-primary);
  font-size: 15px;
  font-weight: 400;
  color: var(--kkan-grey-700);
  line-height: 1.7;
  margin: 0 0 16px 0;
}

.legal-list {
  font-family: var(--font-primary);
  font-size: 15px;
  font-weight: 400;
  color: var(--kkan-grey-700);
  line-height: 1.7;
  margin: 0 0 16px 0;
  padding-left: 24px;
}

.legal-list li {
  margin-bottom: 8px;
}

.legal-list li:last-child {
  margin-bottom: 0;
}
