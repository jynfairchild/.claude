.signup-page {
  display: flex;
  min-height: 100vh;
  align-items: center;
  justify-content: center;
  width: 100%;
  background: var(--kkan-white);
}

.signup-layout {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 200px;
}

.signup-info-column {
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.signup-info {
  width: 442px;
  background: var(--kkan-white);
  border: 1px solid var(--kkan-red-400);
  border-radius: 12px;
  box-shadow: 0 6px 0 0 rgba(208, 0, 0, 0.16);
  padding: 24px;
}

.signup-info-grey {
  width: 442px;
  background: var(--kkan-white);
  border: 1px solid var(--kkan-grey-200);
  border-radius: 12px;
  box-shadow: var(--shadow-grey);
  padding: 24px;
}

.signup-info-grey .signup-info-title {
  color: var(--kkan-grey-700);
}

.signup-info-grey .signup-info-text {
  color: var(--kkan-grey-700);
}

.signup-info-list {
  font-family: 'Berkeley Mono', monospace;
  font-size: 16px;
  line-height: 24px;
  font-weight: 600;
  font-variation-settings: 'wdth' 85;
  color: var(--kkan-red-700);
  margin: 16px 0;
  padding-left: 24px;
}

.signup-info-grey .signup-info-list {
  color: var(--kkan-grey-700);
}

.signup-info-text--italic {
  font-style: italic;
}

.signup-info-text strong {
  font-weight: 800;
}

.signup-info-title {
  font-family: 'Berkeley Mono', monospace;
  font-size: 20px;
  line-height: 20px;
  font-weight: 800;
  font-variation-settings: 'wdth' 85;
  color: var(--kkan-red-700);
  margin: 0 0 16px 0;
}

.signup-info-text {
  font-family: 'Berkeley Mono', monospace;
  font-size: 16px;
  line-height: 24px;
  font-weight: 600;
  font-variation-settings: 'wdth' 85;
  color: var(--kkan-red-700);
  margin: 0;
}

.signup-brand {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 24px;
  margin-bottom: 104px;
}

.signup-brand .brand-top {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  gap: 12px;
}

.signup-brand .brand-welcome {
  font-family: 'Berkeley Mono', monospace;
  font-size: 18px;
  line-height: 18px;
  font-weight: 600;
  color: var(--kkan-grey-500);
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.signup-brand .brand-link {
  display: inline-flex;
  align-items: baseline;
  text-decoration: none;
  color: inherit;
}

.signup-brand .brand-wordmark {
  font-family: 'Berkeley Mono', monospace;
  font-size: 40px;
  line-height: 40px;
  letter-spacing: 0.05em;
  display: inline-flex;
}

.signup-brand .brand-wordmark-base {
  font-weight: 900;
  color: var(--kkan-grey-900);
}

.signup-brand .brand-wordmark-accent {
  color: var(--kkan-grey-900);
  font-weight: 500;
}

.signup-brand .brand-version {
  font-family: 'Berkeley Mono', monospace;
  font-size: 14px;
  font-weight: 600;
  color: var(--kkan-grey-400);
  letter-spacing: -0.02em;
}

.signup-card {
  width: 372px;
  margin: 0 16px;
}

.signup-title {
  color: var(--kkan-grey-800);
  font-family: 'Berkeley Mono', monospace;
  font-size: 20px;
  font-weight: 700;
  letter-spacing: 1.41px;
  line-height: 20px;
  margin: 0 0 24px 0;
}

.signup-field {
  background: var(--kkan-white);
  border: 1px solid var(--kkan-grey-200);
  border-radius: 12px;
  box-shadow: var(--shadow-default);
  padding: 12px 16px;
  margin-top: 16px;
}

/* Spacing between stacked fields (e.g., Name → Email → Password) */
.signup-field + .signup-field { margin-top: 18px; }

/* Error state: red stroke and subtle red shadow */
.signup-field.error {
  border-color: var(--kkan-red-400);
  box-shadow: 0 6px 0 0 rgba(228, 91, 91, 0.14);
}

.signup-input {
  width: 100%;
  border: none;
  outline: none;
  background: transparent;
  color: var(--kkan-grey-900);
  font-family: 'Berkeley Mono', monospace;
  font-size: 16px;
  font-weight: 800;
  line-height: 26px;
  transition: color 0.2s ease;
}

.signup-input::placeholder { color: var(--kkan-grey-300); }

/* Normalize browser autofill styles (Firefox + Chromium) */
/* Firefox */
.signup-input:-moz-autofill {
  color: var(--kkan-grey-900) !important;
  background-color: var(--kkan-white) !important;
  box-shadow: 0 0 0 1000px var(--kkan-white) inset;
  caret-color: var(--kkan-grey-900);
}

/* Chrome/Safari/Edge (WebKit/Blink) */
.signup-input:-webkit-autofill,
.signup-input:-webkit-autofill:hover,
.signup-input:-webkit-autofill:focus {
  -webkit-text-fill-color: var(--kkan-grey-900);
  -webkit-box-shadow: 0 0 0px 1000px var(--kkan-white) inset;
  box-shadow: 0 0 0px 1000px var(--kkan-white) inset;
}

.signup-cta {
  margin-top: 40px;
  background: var(--kkan-blue-25);
  border: 1px solid var(--kkan-blue-400);
  border-radius: 12px;
  box-shadow: 0 6px 0 0 rgba(0, 104, 255, 0.16);
  padding: 12px 16px;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
}

.signup-cta:hover { background: var(--kkan-blue-50); }
.signup-cta:active { background: var(--kkan-blue-100); transform: translateY(1px); }
.signup-cta:focus,
.signup-cta:focus-visible {
  background: var(--kkan-blue-50);
  border-color: var(--kkan-blue-400);
  outline: none;
  box-shadow: 0 6px 0 0 rgba(0, 104, 255, 0.16);
}

.signup-cta:disabled {
  background: var(--kkan-grey-100);
  border-color: var(--kkan-grey-200);
  box-shadow: var(--shadow-grey);
  cursor: not-allowed;
}

.signup-cta:disabled .signup-cta-text {
  color: var(--kkan-grey-400);
}

.signup-cta:disabled:hover {
  background: var(--kkan-grey-100);
}

.signup-cta:disabled:active {
  background: var(--kkan-grey-100);
  transform: none;
}

.signup-cta-text {
  color: var(--kkan-blue-600);
  font-family: 'Berkeley Mono', monospace;
  font-size: 20px;
  font-weight: 800;
}

.signup-subrow {
  margin-top: 32px;
  display: flex;
  gap: 12px;
  align-items: center;
}

.signup-subtext {
  color: var(--kkan-black);
  font-family: 'Berkeley Mono', monospace;
  font-size: 14px;
  font-weight: 600;
}

.signup-link {
  color: var(--kkan-blue-600);
  font-family: 'Berkeley Mono', monospace;
  font-size: 16px;
  font-weight: 800;
  text-decoration: none;
}

.signup-error {
  color: #b00020;
  margin-top: 12px;
  font-family: 'Berkeley Mono', monospace;
}

.signup-loading { opacity: 0.6; pointer-events: none; }

.signup-agree {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  margin-top: 24px;
  cursor: pointer;
}

.signup-checkbox-input {
  position: absolute;
  opacity: 0;
  width: 0;
  height: 0;
}

.signup-checkbox-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 24px;
  height: 24px;
  flex-shrink: 0;
}

.signup-checkbox-icon img {
  width: 24px;
  height: 24px;
  opacity: 0.7;
  transition: opacity 0.15s ease;
}

.signup-agree:hover .signup-checkbox-icon img {
  opacity: 1;
}

.signup-agree-text {
  font-family: 'Berkeley Mono', monospace;
  font-size: 14px;
  font-weight: 500;
  color: var(--kkan-grey-700);
  line-height: 1.5;
}

.signup-agree-link {
  color: var(--kkan-blue-600);
  text-decoration: none;
  font-weight: 600;
}

.signup-agree-link:hover {
  text-decoration: underline;
}

.signup-agree.error .signup-agree-text {
  color: var(--kkan-red-500);
}

.signup-agree.error .signup-checkbox-icon img {
  filter: brightness(0) saturate(100%) invert(36%) sepia(93%) saturate(1054%) hue-rotate(331deg) brightness(89%) contrast(97%);
  opacity: 1;
}

.signup-invite-notice {
  font-family: 'Berkeley Mono', monospace;
  font-size: 14px;
  font-weight: 500;
  color: var(--kkan-grey-600);
  margin: 0 0 8px 0;
}
