"use client";

import React, { useEffect, useState } from "react";
import { useRouter } from "next/navigation";
import Link from "next/link";
import { useAuth } from "@/contexts/AuthContext";
import { useEncryption } from "@/contexts/EncryptionContext";
import { useTask } from "@/contexts/TaskContext";
import { authApi, type AuthUser } from "@/services/authApi";
import { taskApi, columnsApi } from "@/services/api";
import { authLog } from "@/utils/debug";
import { DeleteDataModal } from "@/components/modal/DeleteDataModal";
import { DeleteAccountModal } from "@/components/modal/DeleteAccountModal";
import {
  deriveKey,
  encrypt,
  decrypt,
  encryptArray,
  decryptArray,
  generateSalt,
  bytesToBase64,
  base64ToBytes,
} from "@/utils/crypto";
import "./settings.css";

type SettingsTab = 'general' | 'password' | 'privacy';

export default function SettingsPage() {
  const router = useRouter();
  const { user, isAuthenticated, logout, refresh, loading } = useAuth();
  const { rederiveKey } = useEncryption();
  const { loadTasks } = useTask();
  const [activeTab, setActiveTab] = useState<SettingsTab>('general');
  const [profile, setProfile] = useState<AuthUser | null>(user);
  const [error, setError] = useState<string | null>(null);
  const [saving, setSaving] = useState<boolean>(false);
  const [pw, setPw] = useState({ current: "", next: "" });
  const [pwMsg, setPwMsg] = useState<string | null>(null);
  const [currErr, setCurrErr] = useState(false);
  const [nextErr, setNextErr] = useState(false);
  const [showDeleteDataModal, setShowDeleteDataModal] = useState(false);
  const [deleteDataSuccess, setDeleteDataSuccess] = useState(false);
  const [showDeleteAccountModal, setShowDeleteAccountModal] = useState(false);
  const [editEmail, setEditEmail] = useState("");
  const [editNickname, setEditNickname] = useState("");
  const [profileSaving, setProfileSaving] = useState(false);
  const [profileMsg, setProfileMsg] = useState<string | null>(null);
  const [emailErr, setEmailErr] = useState(false);
  const [nicknameErr, setNicknameErr] = useState(false);

  useEffect(() => {
    // Wait for auth state to hydrate before deciding
    if (loading) return;
    if (!isAuthenticated) {
      router.push("/login");
      return;
    }
    (async () => {
      try {
        const me = await authApi.me();
        setProfile(me.user);
        setEditEmail(me.user.email);
        setEditNickname(me.user.name);
      } catch (err: unknown) {
        const msg = err instanceof Error ? err.message : "Failed to load profile";
        if (/unauthorized/i.test(msg)) {
          authLog('AccountPage: profile unauthorized, attempting refresh');
          const ok = await refresh();
          if (!ok) {
            // Soft-expire handled by AuthContext. Do not logout or redirect.
            setError('Session expired. Please reauthenticate.');
            authLog('AccountPage: refresh failed, soft-expire active');
          }
          return;
        }
        setError(msg);
      }
    })();
  }, [loading, isAuthenticated, router, refresh]);

  const onChangePassword = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!isAuthenticated || !profile) return;
    setPwMsg(null);
    setError(null);
    const currBlank = pw.current.trim().length === 0;
    const nextBlank = pw.next.trim().length === 0;
    setCurrErr(currBlank);
    setNextErr(nextBlank);
    if (currBlank || nextBlank) return;
    setSaving(true);

    try {
      // Get current encryption salt
      const currentSalt = profile.encryption_salt;
      if (!currentSalt) {
        // User has no encryption set up - fall back to simple password change
        const res = await authApi.changePassword(pw.current, pw.next);
        setPwMsg(res.message || "Password changed");
        setPw({ current: "", next: "" });
        setSaving(false);
        return;
      }

      // Step 1: Derive old key from current password
      authLog('Password change: deriving old key');
      const oldSaltBytes = base64ToBytes(currentSalt);
      const oldKey = await deriveKey(pw.current, oldSaltBytes);

      // Step 2: Fetch all tasks and columns from server (encrypted)
      authLog('Password change: fetching tasks and columns');
      const [encryptedTasks, encryptedColumns] = await Promise.all([
        taskApi.getAll(),
        columnsApi.list(),
      ]);

      // Step 3: Decrypt all tasks with old key
      authLog('Password change: decrypting tasks with old key');
      const decryptedTasks = await Promise.all(
        encryptedTasks.map(async (task) => {
          try {
            return {
              id: task.id,
              title: task.title ? await decrypt(task.title, oldKey) : '',
              project: task.project ? await decrypt(task.project, oldKey) : '',
              tags: task.tags && task.tags.length > 0
                ? await decryptArray(task.tags[0], oldKey)
                : [],
            };
          } catch {
            // If decryption fails, task might not be encrypted
            return {
              id: task.id,
              title: task.title || '',
              project: task.project || '',
              tags: task.tags || [],
            };
          }
        })
      );

      // Decrypt all columns with old key
      authLog('Password change: decrypting columns with old key');
      const decryptedColumns = await Promise.all(
        encryptedColumns.map(async (col) => {
          try {
            return {
              id: col.id,
              name: col.name ? await decrypt(col.name, oldKey) : '',
            };
          } catch {
            // If decryption fails, column might not be encrypted
            return {
              id: col.id,
              name: col.name || '',
            };
          }
        })
      );

      // Step 4: Generate new salt
      authLog('Password change: generating new salt');
      const newSaltBytes = generateSalt();
      const newSaltBase64 = bytesToBase64(newSaltBytes);

      // Step 5: Derive new key from new password + new salt
      authLog('Password change: deriving new key');
      const newKey = await deriveKey(pw.next, newSaltBytes);

      // Step 6: Re-encrypt all tasks with new key
      authLog('Password change: re-encrypting tasks with new key');
      const reencryptedTasks = await Promise.all(
        decryptedTasks.map(async (task) => ({
          id: task.id,
          title: task.title ? await encrypt(task.title, newKey) : '',
          project: task.project ? await encrypt(task.project, newKey) : '',
          tags: task.tags.length > 0
            ? [await encryptArray(task.tags, newKey)]
            : [],
        }))
      );

      // Re-encrypt all columns with new key
      authLog('Password change: re-encrypting columns with new key');
      const reencryptedColumns = await Promise.all(
        decryptedColumns.map(async (col) => ({
          id: col.id,
          name: col.name ? await encrypt(col.name, newKey) : '',
        }))
      );

      // Step 7: Send to backend
      authLog('Password change: sending re-encrypted data to server');
      const res = await authApi.reencryptData({
        current_password: pw.current,
        new_password: pw.next,
        new_salt: newSaltBase64,
        tasks: reencryptedTasks.map(t => ({
          id: t.id,
          title: t.title,
          project: t.project,
          tags: t.tags,
        })),
        columns: reencryptedColumns.map(c => ({
          id: c.id,
          name: c.name,
        })),
      });

      // Step 8: Update encryption key in context
      authLog('Password change: updating encryption context');
      await rederiveKey(pw.next, newSaltBase64);

      // Step 9: Hard refresh to clear all cached state and reload with new key
      window.location.reload();
    } catch (err: unknown) {
      const msg = err instanceof Error ? err.message : "Failed to change password";
      setError(msg);
      setSaving(false);
    }
  };

  const onSaveProfile = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!isAuthenticated || !profile) return;
    setProfileMsg(null);
    setError(null);
    const emailBlank = editEmail.trim().length === 0;
    const nicknameBlank = editNickname.trim().length === 0;
    setEmailErr(emailBlank);
    setNicknameErr(nicknameBlank);
    if (emailBlank || nicknameBlank) return;

    setProfileSaving(true);
    try {
      const updates: { email?: string; name?: string } = {};
      if (editEmail.trim() !== profile.email) {
        updates.email = editEmail.trim();
      }
      if (editNickname.trim() !== profile.name) {
        updates.name = editNickname.trim();
      }
      if (Object.keys(updates).length === 0) {
        setProfileMsg("No changes to save");
        setProfileSaving(false);
        return;
      }
      const res = await authApi.updateProfile(updates);
      setProfile(res.user);
      setEditEmail(res.user.email);
      setEditNickname(res.user.name);
      setProfileMsg("Profile updated");
      await refresh(); // Refresh auth context with new user data
    } catch (err: unknown) {
      const msg = err instanceof Error ? err.message : "Failed to update profile";
      setError(msg);
    } finally {
      setProfileSaving(false);
    }
  };

  const onLogoutAll = async () => {
    if (!isAuthenticated) return;
    try {
      await authApi.logoutAll();
      await logout();
      router.push("/login");
    } catch (err: unknown) {
      const msg = err instanceof Error ? err.message : "Failed to logout all";
      setError(msg);
    }
  };

  const handleDeleteData = async (password: string) => {
    await authApi.deleteUserData(password);
    // Hard refresh to clear all cached frontend state
    window.location.reload();
  };

  const handleDeleteAccount = async (password: string) => {
    await authApi.deleteAccount(password);
    await logout();
    router.push("/");
  };

  if (loading || !isAuthenticated) return null;

  return (
    <div className="account-page">
      <header className="account-header">
        <Link href="/dashboard" className="account-brand" aria-label="Back to dashboard">
          <span className="account-wordmark">
            <span className="account-wordmark-base">ASTRO</span>
            <span className="account-wordmark-accent">TASK</span>
          </span>
        </Link>
      </header>

      <div className="account-layout">
        <nav className="account-nav">
          <button
            className={`account-nav-item${activeTab === 'general' ? ' active' : ''}`}
            onClick={() => setActiveTab('general')}
          >
            General
          </button>
          <button
            className={`account-nav-item${activeTab === 'password' ? ' active' : ''}`}
            onClick={() => setActiveTab('password')}
          >
            Password
          </button>
          <button
            className={`account-nav-item${activeTab === 'privacy' ? ' active' : ''}`}
            onClick={() => setActiveTab('privacy')}
          >
            Privacy & Data
          </button>
        </nav>

        <div className={`account-content ${saving || profileSaving ? 'account-loading' : ''}`}>
          {error && <p className="account-error">{error}</p>}

          {activeTab === 'general' && (
            <>
              <h1 className="account-title">General</h1>
              <section className="account-section">
                <h2 className="account-section-title">Profile</h2>
                {profile ? (
                  <form onSubmit={onSaveProfile}>
                    <div className={`account-field${emailErr ? ' error' : ''}`}>
                      <label className="account-field-label">Email</label>
                      <input
                        className="account-input"
                        type="email"
                        value={editEmail}
                        onChange={(e) => { setEditEmail(e.target.value); if (emailErr && e.target.value.trim()) setEmailErr(false); }}
                        placeholder="Email"
                        autoComplete="email"
                      />
                    </div>
                    <div className={`account-field${nicknameErr ? ' error' : ''}`}>
                      <label className="account-field-label">Nickname</label>
                      <input
                        className="account-input"
                        type="text"
                        value={editNickname}
                        onChange={(e) => { setEditNickname(e.target.value); if (nicknameErr && e.target.value.trim()) setNicknameErr(false); }}
                        placeholder="Nickname"
                        autoComplete="name"
                      />
                    </div>
                    {profile.role && (
                      <div className="account-field account-field--readonly">
                        <label className="account-field-label">Role</label>
                        <span className="account-field-value">{profile.role}</span>
                      </div>
                    )}
                    {profile.plan && (
                      <div className="account-field account-field--readonly">
                        <label className="account-field-label">Plan</label>
                        <span className="account-field-value">{profile.plan}</span>
                      </div>
                    )}
                    {profileMsg && <p className="account-success">{profileMsg}</p>}
                    <button type="submit" className="account-cta" disabled={profileSaving}>
                      <span className="account-cta-text">{profileSaving ? 'Saving…' : 'Save changes'}</span>
                    </button>
                  </form>
                ) : (
                  <p>Loading…</p>
                )}
              </section>

              <section className="account-section">
                <h2 className="account-section-title">Sessions</h2>
                <button onClick={onLogoutAll} className="account-secondary">
                  Logout all devices
                </button>
              </section>
            </>
          )}

          {activeTab === 'password' && (
            <>
              <h1 className="account-title">Password</h1>
              <section className="account-section">
                <h2 className="account-section-title">Change password</h2>
                <form onSubmit={onChangePassword}>
                  <div className={`account-field${currErr ? ' error' : ''}`}>
                    <input
                      className="account-input"
                      type="password"
                      value={pw.current}
                      onChange={(e) => { setPw((p) => ({ ...p, current: e.target.value })); if (currErr && e.target.value.trim()) setCurrErr(false); }}
                      placeholder="Current password"
                      autoComplete="current-password"
                    />
                  </div>
                  <div className={`account-field${nextErr ? ' error' : ''}`}>
                    <input
                      className="account-input"
                      type="password"
                      value={pw.next}
                      onChange={(e) => { setPw((p) => ({ ...p, next: e.target.value })); if (nextErr && e.target.value.trim()) setNextErr(false); }}
                      placeholder="New password"
                      autoComplete="new-password"
                    />
                  </div>
                  {pwMsg && <p className="account-success">{pwMsg}</p>}
                  <button type="submit" className="account-cta" disabled={saving}>
                    <span className="account-cta-text">{saving ? 'Saving…' : 'Change password'}</span>
                  </button>
                </form>
              </section>
            </>
          )}

          {activeTab === 'privacy' && (
            <>
              <h1 className="account-title">Privacy & Data</h1>
              <section className="account-section">
                <h2 className="account-section-title">Delete your data</h2>
                <p className="account-section-desc">
                  This will delete all your tasks, columns, and projects but keep your account
                  so you can log in again. To delete everything including your account, use the
                  option below.
                </p>
                {deleteDataSuccess && (
                  <p className="account-success">All your data has been deleted successfully.</p>
                )}
                <button
                  onClick={() => setShowDeleteDataModal(true)}
                  className="account-danger-secondary"
                  disabled={deleteDataSuccess}
                >
                  Delete all my data
                </button>
              </section>

              <section className="account-section">
                <h2 className="account-section-title">Delete your account</h2>
                <p className="account-section-desc">
                  This will permanently delete your account and all your data.
                  You will not be able to log in or recover your account.
                </p>
                <button
                  onClick={() => setShowDeleteAccountModal(true)}
                  className="account-danger"
                >
                  Delete my account
                </button>
              </section>
            </>
          )}
        </div>
      </div>

      <DeleteDataModal
        isOpen={showDeleteDataModal}
        onCancel={() => setShowDeleteDataModal(false)}
        onConfirm={handleDeleteData}
      />

      <DeleteAccountModal
        isOpen={showDeleteAccountModal}
        onCancel={() => setShowDeleteAccountModal(false)}
        onConfirm={handleDeleteAccount}
      />
    </div>
  );
}
