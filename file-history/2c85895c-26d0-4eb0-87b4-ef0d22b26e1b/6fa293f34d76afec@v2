.account-page {
  display: flex;
  min-height: 100vh;
  align-items: center;
  justify-content: center;
  width: 100%;
  background: var(--kkan-white);
}

.account-card {
  width: 372px;
  margin: 0 16px;
}

.account-title {
  color: var(--kkan-grey-800);
  font-family: 'Berkeley Mono', monospace;
  font-size: 24px;
  font-weight: 700;
  letter-spacing: 1.41px;
  line-height: 24px;
  margin: 0 0 40px 0;
}

.account-section { margin-top: 24px; }
.account-section-title {
  color: var(--kkan-grey-800);
  font-family: 'Berkeley Mono', monospace;
  font-size: 16px;
  font-weight: 800;
  margin-bottom: 12px;
}

.account-section-desc {
  font-family: 'Berkeley Mono', monospace;
  font-size: 14px;
  color: var(--kkan-grey-500);
  margin-bottom: 16px;
  line-height: 1.5;
}

.account-list { list-style: none; padding: 0; margin: 0 0 24px 0; }
.account-list li { color: var(--kkan-grey-800); font-family: 'Berkeley Mono', monospace; font-size: 14px; margin-bottom: 6px; }
.account-list strong { font-weight: 800; }

.account-field {
  background: var(--kkan-white);
  border: 1px solid var(--kkan-grey-200);
  border-radius: 12px;
  box-shadow: var(--shadow-default);
  padding: 12px 16px;
  margin-top: 16px;
}

.account-field + .account-field { margin-top: 18px; }

.account-field.error {
  border-color: var(--kkan-red-400);
  box-shadow: 0 6px 0 0 rgba(228, 91, 91, 0.14);
}

.account-input {
  width: 100%;
  border: none;
  outline: none;
  background: transparent;
  color: var(--kkan-grey-900);
  font-family: 'Berkeley Mono', monospace;
  font-size: 16px;
  font-weight: 800;
  line-height: 26px;
}

.account-input::placeholder { color: var(--kkan-grey-300); }

/* Autofill normalization */
.account-input:-moz-autofill {
  color: var(--kkan-grey-900) !important;
  background-color: var(--kkan-white) !important;
  box-shadow: 0 0 0 1000px var(--kkan-white) inset;
  caret-color: var(--kkan-grey-900);
}
.account-input:-webkit-autofill,
.account-input:-webkit-autofill:hover,
.account-input:-webkit-autofill:focus {
  -webkit-text-fill-color: var(--kkan-grey-900);
  -webkit-box-shadow: 0 0 0px 1000px var(--kkan-white) inset;
  box-shadow: 0 0 0px 1000px var(--kkan-white) inset;
}

.account-cta {
  margin-top: 40px;
  background: var(--kkan-blue-25);
  border: 1px solid var(--kkan-blue-400);
  border-radius: 12px;
  box-shadow: 0 6px 0 0 rgba(0, 104, 255, 0.16);
  padding: 12px 16px;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
}
.account-cta:hover { background: var(--kkan-blue-50); }
.account-cta:active { background: var(--kkan-blue-100); transform: translateY(1px); }
.account-cta:focus,
.account-cta:focus-visible {
  background: var(--kkan-blue-50);
  border-color: var(--kkan-blue-400);
  outline: none;
  box-shadow: 0 6px 0 0 rgba(0, 104, 255, 0.16);
}
.account-cta-text { color: var(--kkan-blue-600); font-family: 'Berkeley Mono', monospace; font-size: 20px; font-weight: 800; }

.account-secondary {
  margin-top: 16px;
  background: var(--kkan-white);
  border: 1px solid var(--kkan-blue-400);
  color: var(--kkan-blue-600);
  border-radius: 12px;
  box-shadow: 0 6px 0 0 rgba(0, 104, 255, 0.12);
  padding: 10px 14px;
  width: 100%;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  font-family: 'Berkeley Mono', monospace;
  font-size: 14px;
  font-weight: 700;
}
.account-secondary:hover { background: var(--kkan-blue-25); }
.account-secondary:active { transform: translateY(1px); background: var(--kkan-blue-50); }
.account-secondary:focus,
.account-secondary:focus-visible {
  outline: none;
  background: var(--kkan-blue-25);
}

.account-danger {
  margin-top: 16px;
  background: var(--kkan-red-400);
  border: 1px solid var(--kkan-red-400);
  color: white;
  border-radius: 12px;
  box-shadow: 0 6px 0 0 rgba(228, 91, 91, 0.2);
  padding: 10px 14px;
  width: 100%;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  font-family: 'Berkeley Mono', monospace;
  font-size: 14px;
  font-weight: 700;
}
.account-danger:hover { filter: brightness(0.98); }
.account-danger:active { transform: translateY(1px); }
.account-danger:focus,
.account-danger:focus-visible {
  outline: none;
  box-shadow: 0 6px 0 0 rgba(228, 91, 91, 0.2);
}
.account-danger:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.account-error { color: #b00020; margin-top: 12px; font-family: 'Berkeley Mono', monospace; }
.account-success { color: #0a7d00; margin-top: 12px; font-family: 'Berkeley Mono', monospace; }
.account-loading { opacity: 0.6; pointer-events: none; }

