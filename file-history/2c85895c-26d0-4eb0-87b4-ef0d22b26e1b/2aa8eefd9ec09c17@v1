// Invitation tokens for magic link invite system

func invitationTTL() time.Duration {
    if v := os.Getenv("INVITATION_TTL"); v != "" {
        if d, err := time.ParseDuration(v); err == nil {
            return d
        }
    }
    return 7 * 24 * time.Hour // 7 days default
}

// CreateInvitationToken creates a new invitation for the given email address.
// Returns the plain token (to be sent in the invite link), the invitation record, and any error.
func CreateInvitationToken(db *gorm.DB, email string, invitedByID uint) (string, *models.Invitation, error) {
    plain, err := genOpaque(24)
    if err != nil {
        return "", nil, err
    }
    rec := &models.Invitation{
        Email:       email,
        TokenHash:   hashOpaque(plain),
        InvitedByID: invitedByID,
        ExpiresAt:   time.Now().Add(invitationTTL()),
    }
    if err := db.Create(rec).Error; err != nil {
        return "", nil, err
    }
    return plain, rec, nil
}

// ValidateInvitationToken checks if an invitation token is valid without consuming it.
// Returns the invitation record if valid, or an error if invalid/expired/used.
func ValidateInvitationToken(db *gorm.DB, token string) (*models.Invitation, error) {
    if token == "" {
        return nil, errors.New("missing token")
    }
    var rec models.Invitation
    if err := db.Where("token_hash = ?", hashOpaque(token)).First(&rec).Error; err != nil {
        return nil, err
    }
    if rec.UsedAt != nil {
        return nil, errors.New("invitation already used")
    }
    if time.Now().After(rec.ExpiresAt) {
        return nil, errors.New("invitation expired")
    }
    return &rec, nil
}

// ConsumeInvitationToken validates and marks an invitation token as used.
// Returns the invitation record if successfully consumed.
func ConsumeInvitationToken(db *gorm.DB, token string) (*models.Invitation, error) {
    if token == "" {
        return nil, errors.New("missing token")
    }
    var rec models.Invitation
    if err := db.Where("token_hash = ?", hashOpaque(token)).First(&rec).Error; err != nil {
        return nil, err
    }
    if rec.UsedAt != nil {
        return nil, errors.New("invitation already used")
    }
    if time.Now().After(rec.ExpiresAt) {
        return nil, errors.New("invitation expired")
    }
    now := time.Now()
    rec.UsedAt = &now
    if err := db.Save(&rec).Error; err != nil {
        return nil, err
    }
    return &rec, nil
}

