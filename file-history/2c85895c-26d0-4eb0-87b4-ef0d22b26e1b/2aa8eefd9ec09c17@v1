package auth

import (
    "crypto/rand"
    "crypto/sha256"
    "encoding/base64"
    "errors"
    "fmt"
    "os"
    "time"

    "gorm.io/gorm"

    "simple_task_tracker/backend/internal/models"
)

func emailVerifyTTL() time.Duration {
    if v := os.Getenv("EMAIL_VERIFY_TTL"); v != "" { if d, err := time.ParseDuration(v); err == nil { return d } }
    return 48 * time.Hour
}

func passwordResetTTL() time.Duration {
    if v := os.Getenv("PASSWORD_RESET_TTL"); v != "" { if d, err := time.ParseDuration(v); err == nil { return d } }
    return 1 * time.Hour
}

func genOpaque(n int) (string, error) {
    b := make([]byte, n)
    if _, err := rand.Read(b); err != nil { return "", fmt.Errorf("rand: %w", err) }
    return base64.RawURLEncoding.EncodeToString(b), nil
}

func hashOpaque(token string) string {
    sum := sha256.Sum256([]byte(token))
    return base64.RawURLEncoding.EncodeToString(sum[:])
}

// Email verification tokens
func CreateEmailVerificationToken(db *gorm.DB, userID uint) (string, *models.EmailVerificationToken, error) {
    plain, err := genOpaque(24)
    if err != nil { return "", nil, err }
    rec := &models.EmailVerificationToken{
        UserID:    userID,
        TokenHash: hashOpaque(plain),
        ExpiresAt: time.Now().Add(emailVerifyTTL()),
    }
    if err := db.Create(rec).Error; err != nil { return "", nil, err }
    return plain, rec, nil
}

func ConsumeEmailVerificationToken(db *gorm.DB, token string) (*models.EmailVerificationToken, error) {
    if token == "" { return nil, errors.New("missing token") }
    var rec models.EmailVerificationToken
    if err := db.Where("token_hash = ?", hashOpaque(token)).First(&rec).Error; err != nil { return nil, err }
    if rec.UsedAt != nil { return nil, errors.New("token already used") }
    if time.Now().After(rec.ExpiresAt) { return nil, errors.New("token expired") }
    now := time.Now()
    rec.UsedAt = &now
    if err := db.Save(&rec).Error; err != nil { return nil, err }
    return &rec, nil
}

