import { authApi } from './authApi';
import { authLog } from '@/utils/debug';

// Get CSRF token from cookie (set by backend, readable by JS)
function getCSRFToken(): string {
  if (typeof document === 'undefined') return '';
  const match = document.cookie.match(/csrf_token=([^;]+)/);
  return match ? match[1] : '';
}

/**
 * Fetch wrapper that:
 * 1. Always includes credentials (cookies) for authentication
 * 2. Adds CSRF token header for state-changing requests
 * 3. Attempts refresh on 401 and retries once
 */
export async function fetchWithAuth(input: RequestInfo | URL, init: RequestInit = {}): Promise<Response> {
  const method = init.method?.toUpperCase() || 'GET';
  const isMutation = method !== 'GET' && method !== 'HEAD' && method !== 'OPTIONS';

  const headers: Record<string, string> = {
    ...(init.headers as Record<string, string> | undefined),
  };

  // Add CSRF token for state-changing requests
  if (isMutation && !headers['X-CSRF-Token']) {
    const csrfToken = getCSRFToken();
    if (csrfToken) {
      headers['X-CSRF-Token'] = csrfToken;
    }
  }

  // Make request with credentials included
  let resp = await fetch(input, {
    ...init,
    headers,
    credentials: 'include',
  });

  if (resp.status !== 401) return resp;

  // Attempt refresh once, then retry
  authLog('fetchWithAuth: got 401, attempting refresh');
  try {
    await authApi.refresh();
    authLog('fetchWithAuth: refresh succeeded, retrying request');

    // Retry with fresh CSRF token
    const retryHeaders: Record<string, string> = {
      ...(init.headers as Record<string, string> | undefined),
    };
    if (isMutation) {
      const freshCsrf = getCSRFToken();
      if (freshCsrf) {
        retryHeaders['X-CSRF-Token'] = freshCsrf;
      }
    }

    return fetch(input, {
      ...init,
      headers: retryHeaders,
      credentials: 'include',
    });
  } catch {
    authLog('fetchWithAuth: refresh failed, returning original 401');
    return resp;
  }
}
