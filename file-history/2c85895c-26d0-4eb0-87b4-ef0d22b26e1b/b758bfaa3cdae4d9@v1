import { describe, it, expect, beforeEach, vi, afterEach } from 'vitest';
import { taskApi, type Task } from './api';

function makeTask(overrides: Partial<Task> = {}): Task {
  return {
    id: 1,
    user_id: 1,
    title: 'T',
    project: '',
    start_time: new Date().toISOString(),
    end_time: null,
    duration: 0,
    session_count: 0,
    tags: [],
    column_index: 0,
    status: 'uncompleted',
    position: 0,
    is_active: false,
    created_at: new Date().toISOString(),
    updated_at: new Date().toISOString(),
    ...overrides,
  };
}

describe('taskApi payloads', () => {
  beforeEach(() => {
    localStorage.clear();
  });

  afterEach(() => {
    vi.restoreAllMocks();
  });

  it('updateTimer sends only durations (no is_active)', async () => {
    const fetchSpy = vi.spyOn(global, 'fetch' as any).mockResolvedValue({
      ok: true,
      json: async () => makeTask({ id: 42, is_active: true, duration: 100, session_count: 1 }),
      statusText: 'OK',
    } as any);

    await taskApi.updateTimer(42, 100, 20);

    expect(fetchSpy).toHaveBeenCalledTimes(1);
    const [url, init] = fetchSpy.mock.calls[0] as [string, RequestInit];
    expect(url).toMatch(/\/tasks\/42$/);
    expect(init?.method).toBe('PATCH');
    const body = JSON.parse(String(init?.body));
    expect(body).toEqual({ duration: 100, session_duration: 20 });
    // Ensure is_active not sent implicitly
    expect('is_active' in body).toBe(false);
  });

  it('stopTimer includes is_active=false and durations', async () => {
    const fetchSpy = vi.spyOn(global, 'fetch' as any).mockResolvedValue({
      ok: true,
      json: async () => makeTask({ id: 7, is_active: false, duration: 120 }),
      statusText: 'OK',
    } as any);

    await taskApi.stopTimer(7, 120, 10);

    const [, init] = fetchSpy.mock.calls[0] as [string, RequestInit];
    const body = JSON.parse(String(init?.body));
    expect(body).toEqual({ duration: 120, session_duration: 10, is_active: false });
  });

  it('includes credentials for cookie-based auth', async () => {
    const fetchSpy = vi.spyOn(global, 'fetch' as any).mockResolvedValue({
      ok: true,
      json: async () => makeTask({ id: 1 }),
      statusText: 'OK',
    } as any);

    await taskApi.update(1, { title: 'X' });

    const [, init] = fetchSpy.mock.calls[0] as [string, RequestInit];
    expect(init?.credentials).toBe('include');
  });
});
