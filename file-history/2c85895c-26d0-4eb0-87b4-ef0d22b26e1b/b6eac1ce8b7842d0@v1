.ticket {
  display: flex;
  align-items: stretch;
  height: 242px;
  width: 100%;
  max-width: 900px;
}

@keyframes slideInFromRight {
  from {
    opacity: 0;
    transform: translateX(140px);
  }
  to {
    opacity: 1s;
    transform: translateX(0);
  }
}

.ticketLeft {
  position: relative;
  display: flex;
  width: 90px;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  align-self: stretch;
  border-radius: 8px;
  border: 1px solid var(--kkan-grey-200);
  background: var(--kkan-grey-25);
  box-shadow: var(--shadow-default);
  transition: background 0.2s;
  cursor: pointer;
  animation: slideInFromRight 900ms cubic-bezier(0.4, 0, 0.2, 1);
}

.ticketLeft:hover {
  background: var(--kkan-grey-50);
}

.playButton {
  width: 48px;
  height: 48px;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}

.playButton img {
  width: 40px;
  height: 40px;
  filter: brightness(0) saturate(100%) invert(27%) sepia(15%) saturate(1107%) hue-rotate(184deg) brightness(93%) contrast(88%);
}

.shortcut-hint {
  position: absolute;
  bottom: 16px;
  display: flex;
  align-items: center;
  gap: 2px;
  font-family: 'Berkeley Mono', monospace;
  color: var(--kkan-grey-300);
}

.shortcut-cmd {
  font-size: 22px;
  font-weight: 900;
  line-height: 1;
  position: relative;
  top: 1px;
}

.shortcut-key {
  font-size: 18px;
  font-weight: 600;
  line-height: 1;
  letter-spacing: 0.02em;
}

.ticketCenter {
  display: flex;
  width: 456px;
  height: 242px;
  padding: 32px 56px 32px 32px;
  flex-direction: column;
  justify-content: space-between;
  align-items: flex-start;
  align-self: stretch;
  border-radius: 8px;
  border: 1px solid var(--kkan-grey-200);
  background: var(--kkan-white);
  box-shadow: var(--shadow-default);
  margin-left: -1px;
  margin-right: -1px;
  animation: slideInFromRight 900ms cubic-bezier(0.4, 0, 0.2, 1);
  animation-delay: 100ms;
  animation-fill-mode: backwards;
}

.ticketHeader {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.taskLabel {
  font-family: 'Berkeley Mono', monospace;
  font-size: 11px;
  font-weight: 800;
  font-stretch: semi-condensed;
  letter-spacing: 0.08em;
  color: var(--kkan-grey-500);
}

.taskInput {
  font-family: 'Berkeley Mono', monospace;
  font-size: 24px;
  font-weight: 800;
  font-stretch: condensed;
  line-height: 36px;
  color: var(--kkan-grey-950);
  border: none;
  outline: none;
  padding: 0;
  background: transparent;
  width: 100%;
  resize: none;
  overflow: hidden;
}

.taskInput::placeholder {
  color: var(--kkan-grey-300);
}

.ticketFooter {
  display: flex;
  gap: 80px;
}

.projectSection,
.tagsSection {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.fieldLabel {
  font-family: 'Berkeley Mono', monospace;
  font-size: 11px;
  font-weight: 800;
  font-stretch: semi-condensed;
  letter-spacing: 0.08em;
  color: var(--kkan-grey-500);
}

.fieldInput {
  font-family: 'Berkeley Mono', monospace;
  font-size: 16px;
  font-weight: 700;
  color: var(--kkan-grey-950);
  border: none;
  outline: none;
  padding: 0;
  background: transparent;
  width: 180px;
}

.fieldInput::placeholder {
  color: var(--kkan-grey-300);
  font-weight: 700;
}

.ticketRight {
  display: flex;
  padding: 40px;
  flex-direction: column;
  justify-content: center;
  align-items: flex-end;
  gap: 24px;
  align-self: stretch;
  border-radius: 8px;
  border: 1px solid var(--kkan-grey-200);
  background: var(--kkan-white);
  box-shadow: var(--shadow-default);
  transition: all 0.3s;
  animation: slideInFromRight 900ms cubic-bezier(0.1, 0, 0.2, 1);
  animation-delay: 200ms;
  animation-fill-mode: backwards;
}

.ticketRight.running {
  border: 1px solid var(--kkan-blue-400);
  background: var(--kkan-blue-50);
  box-shadow: 0 6px 0 0 rgba(30, 114, 235, 0.16);
}

.timer {
  font-family: 'Berkeley Mono', monospace;
  font-size: 40px;
  font-weight: 700;
  color: var(--kkan-grey-500);
  font-variant-numeric: tabular-nums;
  letter-spacing: 0.02em;
  line-height: 40px;
  transition: color 0.3s;
}

.timer.running {
  color: var(--kkan-blue-600);
}

/* Animation for ticket card going away */
@keyframes slideOutDown {
  from {
    opacity: 1;
    transform: translateY(0);
  }
  to {
    opacity: 0;
    transform: translateY(100px);
  }
}

.ticket.animating-out {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  animation: slideOutDown 0.6s cubic-bezier(0.4, 0, 0.2, 1) 2s forwards;
}
