.login-page {
  display: flex;
  min-height: 100vh;
  width: 100%;
}

.login-left-panel {
  flex: 1;
  background: var(--kkan-grey-25);
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-brand {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 24px;
}

.login-brand .brand-top {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  gap: 12px;
}

.login-brand .brand-link {
  display: inline-flex;
  align-items: baseline;
  text-decoration: none;
  color: inherit;
}

.login-brand .brand-wordmark {
  font-family: 'Berkeley Mono', monospace;
  font-size: 40px;
  line-height: 40px;
  letter-spacing: 0.05em;
  display: inline-flex;
}

.login-brand .brand-wordmark-base {
  font-weight: 900;
  color: var(--kkan-grey-900);
}

.login-brand .brand-wordmark-accent {
  color: var(--kkan-grey-900);
  font-weight: 500;
}

.login-brand .brand-version {
  font-family: 'Berkeley Mono', monospace;
  font-size: 14px;
  font-weight: 600;
  color: var(--kkan-grey-400);
  letter-spacing: -0.02em;
}

.login-brand .brand-welcome {
  font-family: 'Berkeley Mono', monospace;
  font-size: 18px;
  line-height: 18px;
  font-weight: 600;
  color: var(--kkan-grey-500);
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.login-right-panel {
  width: 500px;
  background: var(--kkan-white);
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-card {
  width: 372px;
  margin: 0 16px;   /* small horizontal breathing room on tiny screens */
  /* No outer box: remove background, border, shadow, padding */
}

.login-title {
  color: var(--kkan-grey-800);
  font-family: 'Berkeley Mono', monospace;
  font-size: 24px;
  font-weight: 700;
  letter-spacing: 1.41px;
  line-height: 24px;
  margin: 0 0 40px 0; /* 40px space before first field */
}

.login-field {
  background: var(--kkan-white);
  border: 1px solid var(--kkan-grey-200);
  border-radius: 12px;
  box-shadow: var(--shadow-default);
  padding: 12px 16px;
  margin-top: 16px;
}

/* Error state: red stroke and subtle red shadow */
.login-field.error {
  border-color: var(--kkan-red-400);
  box-shadow: 0 6px 0 0 rgba(228, 91, 91, 0.14);
}

/* Spacing between email and password fields */
.login-field + .login-field { margin-top: 18px; }

.login-input {
  width: 100%;
  border: none;
  outline: none;
  background: transparent;
  color: var(--kkan-grey-900);
  font-family: 'Berkeley Mono', monospace;
  font-size: 16px;
  font-weight: 800;
  line-height: 26px;
  transition: color 0.2s ease;
}

/* Placeholder should be lighter */
.login-input::placeholder { color: var(--kkan-grey-300); }

/* Normalize browser autofill styles (Firefox + Chromium) */
/* Firefox */
.login-input:-moz-autofill {
  color: var(--kkan-grey-900) !important;
  background-color: var(--kkan-white) !important;
  box-shadow: 0 0 0 1000px var(--kkan-white) inset; /* overwrite UA autofill bg */
  caret-color: var(--kkan-grey-900);
}

/* Chrome/Safari/Edge (WebKit/Blink) */
.login-input:-webkit-autofill,
.login-input:-webkit-autofill:hover,
.login-input:-webkit-autofill:focus {
  -webkit-text-fill-color: var(--kkan-grey-900);
  -webkit-box-shadow: 0 0 0px 1000px var(--kkan-white) inset;
  box-shadow: 0 0 0px 1000px var(--kkan-white) inset;
}

.login-cta {
  margin-top: 40px; /* more space after password */
  background: var(--kkan-blue-25);
  border: 1px solid var(--kkan-blue-400);
  border-radius: 12px;
  box-shadow: 0 6px 0 0 rgba(0, 104, 255, 0.16);
  padding: 12px 16px;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
}

.login-cta:hover { background: var(--kkan-blue-50); }
.login-cta:active {
  background: var(--kkan-blue-100);
  transform: translateY(1px);
}

/* Keyboard focus: match hover bg, keep stroke, remove UA outline */
.login-cta:focus,
.login-cta:focus-visible {
  background: var(--kkan-blue-50);
  border-color: var(--kkan-blue-400);
  outline: none;
  box-shadow: 0 6px 0 0 rgba(0, 104, 255, 0.16);
}

.login-cta-text {
  color: var(--kkan-blue-600);
  font-family: 'Berkeley Mono', monospace;
  font-size: 20px;
  font-weight: 800;
}

.login-subrow {
  margin-top: 32px; /* 32px from Login button */
  display: flex;
  gap: 12px;
  align-items: center;
}

.login-subtext {
  color: var(--kkan-black);
  font-family: 'Berkeley Mono', monospace;
  font-size: 14px;
  font-weight: 600;
}

.login-link {
  color: var(--kkan-blue-600);
  font-family: 'Berkeley Mono', monospace;
  font-size: 16px;
  font-weight: 800;
  text-decoration: none;
}

.login-error {
  color: #b00020;
  margin-top: 12px;
  font-family: 'Berkeley Mono', monospace;
}

.login-loading { opacity: 0.6; pointer-events: none; }
