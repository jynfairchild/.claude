'use client';

import { useEffect, useState } from 'react';
import Kanban from '@/components/kanban/Kanban';
import { Header } from '@/components/header/Header';
import { OnboardingWithTimer } from '@/components/onboarding/OnboardingWithTimer';
import './dashboard.css';
import { useAuth } from '@/contexts/AuthContext';
import { useRouter } from 'next/navigation';

export default function Dashboard() {
  const { isAuthenticated, loading } = useAuth();
  const router = useRouter();
  const [showOnboarding, setShowOnboarding] = useState(false);
  const [showKanban, setShowKanban] = useState(false);
  const [timerStarted, setTimerStarted] = useState(false);

  useEffect(() => {
    // Redirect to login if not authenticated (after auth state hydrated)
    if (!loading && !isAuthenticated) {
      router.replace('/login');
    }
  }, [isAuthenticated, loading, router]);

  useEffect(() => {
    const isComplete = localStorage.getItem('onboardingComplete');
    setShowOnboarding(!isComplete);
  }, []);

  // Show kanban after ticket animates away when timer starts
  useEffect(() => {
    if (timerStarted) {
      const timer = setTimeout(() => {
        setShowKanban(true);
        // Mark onboarding as complete
        localStorage.setItem('onboardingComplete', 'true');
      }, 2600); // 2s delay + 0.6s animation
      return () => clearTimeout(timer);
    }
  }, [timerStarted]);

  const handleTimerStart = () => {
    setTimerStarted(true);
  };

  // Prevent flashing dashboard before auth state is known or when redirecting
  // Hooks must run unconditionally in the same order on every render.
  if (loading || !isAuthenticated) {
    return null;
  }

  if (showOnboarding) {
    return (
      <div className={`dashboard-container${!showKanban ? ' dashboard-container--centered' : ''}`}>
        <OnboardingWithTimer timerStarted={timerStarted} onTimerStart={handleTimerStart}>
          {showKanban && (
            <div className="dashboard-kanban-wrapper">
              <Header />
              <div className="dashboard-kanban-body">
                <Kanban />
              </div>
            </div>
          )}
        </OnboardingWithTimer>
        {/* Onboarding restart is available in the user menu */}
      </div>
    );
  }

  return (
    <div className="dashboard-container">
      <div className="dashboard-kanban-wrapper">
        <Header />
        <div className="dashboard-kanban-body">
          <Kanban />
        </div>
      </div>
      {/* Onboarding restart is available in the user menu */}
    </div>
  );
}
