// API service for communicating with the backend
import { fetchWithAuth } from './http';
import { apiLog } from '@/utils/debug';

// Use the same env-based base URL convention as other services
const API_BASE_URL = process.env.NEXT_PUBLIC_API_URL || 'http://localhost:8080/api/v1';

// Session interface matching backend model
export interface Session {
  id: number;
  task_id: number;
  start_time: string;
  end_time: string | null;
  duration: number; // in seconds
  session_num: number; // Sequential number within task (1, 2, 3...)
  created_at: string;
  updated_at: string;
}

// Task interface matching backend model
export interface Task {
  id: number;
  user_id: number;
  title: string;
  project: string; // Now just a string, not an ID
  start_time: string;
  end_time: string | null;
  duration: number; // in seconds
  session_duration?: number; // Current session duration in seconds
  session_count: number;
  tags: string[];
  column_index: number; // Integer column index (0 = leftmost)
  status: 'uncompleted' | 'completed'; // Task completion status
  position: number; // Position within column
  is_active: boolean;
  created_at: string;
  updated_at: string;
  sessions?: Session[]; // Array of sessions
}

// Request interfaces
export interface CreateTaskRequest {
  title: string;
  project?: string;
  tags?: string[];
  is_active?: boolean;
}

export interface UpdateTaskRequest {
  title?: string;
  project?: string;
  tags?: string[];
  column_index?: number; // Preferred: column index
  status?: 'uncompleted' | 'completed'; // Task completion status
  position?: number; // Position within column
  duration?: number;
  session_duration?: number; // Current session duration
  is_active?: boolean;
}

// API functions
export const taskApi = {
  // Create a new task
  async create(data: CreateTaskRequest): Promise<Task> {
    const response = await fetchWithAuth(`${API_BASE_URL}/tasks`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', ...getAuthHeaders() },
      body: JSON.stringify(data),
    });
    
    if (!response.ok) {
      throw new Error(`Failed to create task: ${response.statusText}`);
    }
    
    return response.json();
  },

  // Update an existing task
  async update(id: number, data: UpdateTaskRequest): Promise<Task> {
    apiLog('Updating task', {
      taskId: id,
      data,
      timestamp: new Date().toISOString()
    });
    
    const response = await fetchWithAuth(`${API_BASE_URL}/tasks/${id}`, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json', ...getAuthHeaders() },
      body: JSON.stringify(data),
    });
    
    if (!response.ok) {
      apiLog('Update failed', { statusText: response.statusText });
      throw new Error(`Failed to update task: ${response.statusText}`);
    }
    
    const result = await response.json();
    const respLog: Record<string, unknown> = {
      taskId: result.id,
      isActive: result.is_active,
      duration: result.duration,
    };
    if (typeof result.session_duration === 'number') {
      respLog.sessionDuration = result.session_duration;
    }
    apiLog('Update response', respLog);

    return result;
  },

  async delete(id: number): Promise<{ deleted: number; column_index?: number }> {
    const response = await fetchWithAuth(`${API_BASE_URL}/tasks/${id}`, {
      method: 'DELETE',
      headers: { ...getAuthHeaders() },
    });

    if (!response.ok) {
      const msg = await response.text().catch(() => response.statusText);
      throw new Error(`Failed to delete task: ${msg}`);
    }

    return response.json();
  },

  // Get all tasks
  async getAll(): Promise<Task[]> {
    const response = await fetchWithAuth(`${API_BASE_URL}/tasks`, { headers: { ...getAuthHeaders() } });
    
    if (!response.ok) {
      throw new Error(`Failed to fetch tasks: ${response.statusText}`);
    }
    
    return response.json();
  },

  // Get the active task (if any)
  async getActive(): Promise<Task | null> {
    const response = await fetchWithAuth(`${API_BASE_URL}/active`, { headers: { ...getAuthHeaders() } });
    
    if (!response.ok) {
      if (response.status === 404) {
        // No active task
        return null;
      }
      throw new Error(`Failed to fetch active task: ${response.statusText}`);
    }
    
    return response.json();
  },

  // Update task timer (convenience method)
  async updateTimer(id: number, duration: number, sessionDuration?: number): Promise<Task> {
    // Do not force is_active=true on periodic syncs; backend should
    // remain the source of truth for active state. Only send durations.
    const payload: UpdateTaskRequest = { duration };
    if (typeof sessionDuration === 'number') {
      payload.session_duration = sessionDuration;
    }
    return this.update(id, payload);
  },

  // Stop task timer (convenience method)
  async stopTimer(id: number, duration: number, sessionDuration?: number): Promise<Task> {
    const payload: UpdateTaskRequest = { duration, is_active: false };
    if (typeof sessionDuration === 'number') {
      payload.session_duration = sessionDuration;
    }
    return this.update(id, payload);
  },

  // Move task to different column
  async moveTask(id: number, columnIndex: number, position?: number): Promise<Task> {
    const data: UpdateTaskRequest = { column_index: columnIndex, position };
    return this.update(id, data);
  },
};

// Columns API (skeleton)
export interface UserColumn { id: number; user_id: number; project?: string; col_index: number; name: string; }
export const columnsApi = {
  async list(project?: string): Promise<UserColumn[]> {
    const url = new URL(`${API_BASE_URL}/columns`);
    if (project) url.searchParams.set('project', project);
    const res = await fetchWithAuth(url.toString(), { headers: { ...getAuthHeaders() } });
    if (!res.ok) throw new Error(`Failed to fetch columns: ${res.statusText}`);
    return res.json();
  },
  async create(data: Partial<Pick<UserColumn, 'name' | 'col_index' | 'project'>>): Promise<UserColumn> {
    const res = await fetchWithAuth(`${API_BASE_URL}/columns`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', ...getAuthHeaders() },
      body: JSON.stringify(data),
    });
    if (!res.ok) {
      const msg = await res.text().catch(() => res.statusText);
      throw new Error(`Failed to create column: ${msg}`);
    }
    return res.json();
  },
  async delete(id: number): Promise<{ deleted: number; col_index?: number }> {
    const res = await fetchWithAuth(`${API_BASE_URL}/columns/${id}`, { method: 'DELETE', headers: { ...getAuthHeaders() } });
    if (!res.ok) {
      const msg = await res.text().catch(() => res.statusText);
      throw new Error(`Failed to delete column: ${msg}`);
    }
    return res.json();
  },
  async update(id: number, data: Partial<Pick<UserColumn, 'name' | 'col_index'>>): Promise<UserColumn> {
    const res = await fetchWithAuth(`${API_BASE_URL}/columns/${id}`, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json', ...getAuthHeaders() },
      body: JSON.stringify(data),
    });
    if (!res.ok) {
      const msg = await res.text().catch(() => res.statusText);
      throw new Error(`Failed to update column: ${msg}`);
    }
    return res.json();
  },
};
