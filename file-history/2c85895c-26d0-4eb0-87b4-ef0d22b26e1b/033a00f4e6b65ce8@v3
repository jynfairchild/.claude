const API_BASE_URL = process.env.NEXT_PUBLIC_API_URL || 'http://localhost:8080/api/v1';

export type AuthUser = {
  id: number;
  email: string;
  name: string;
  role?: 'user' | 'admin';
  plan?: 'normal' | 'pro' | 'vip';
  actionbar?: string[];
};

export type LoginResponse = {
  message: string;
  user: AuthUser;
  // tokens are optional - in production they're only in cookies
  token?: string;
  refresh_token?: string;
};

export type SignupResponse = LoginResponse;

// Get CSRF token from cookie (set by backend, readable by JS)
function getCSRFToken(): string {
  if (typeof document === 'undefined') return '';
  const match = document.cookie.match(/csrf_token=([^;]+)/);
  return match ? match[1] : '';
}

// Common fetch options for cookie-based auth
const withCredentials: RequestInit = {
  credentials: 'include',
};

// Headers for state-changing requests (include CSRF token)
function mutationHeaders(): HeadersInit {
  return {
    'Content-Type': 'application/json',
    'X-CSRF-Token': getCSRFToken(),
  };
}

export type InvitationValidation = {
  email: string;
  expires_at: string;
  valid: boolean;
};

export const authApi = {
  async signup(data: { email: string; password: string; name: string; invite_token?: string }): Promise<SignupResponse> {
    const res = await fetch(`${API_BASE_URL}/auth/signup`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data),
      ...withCredentials,
    });
    if (!res.ok) {
      const msg = await res.text().catch(() => res.statusText);
      throw new Error(`Signup failed: ${msg}`);
    }
    return res.json();
  },

  async validateInvitation(token: string): Promise<InvitationValidation> {
    const res = await fetch(`${API_BASE_URL}/auth/invitation/${token}`, {
      ...withCredentials,
    });
    if (!res.ok) {
      const msg = await res.text().catch(() => res.statusText);
      throw new Error(`Invalid invitation: ${msg}`);
    }
    return res.json();
  },

  async verifyEmail(token: string): Promise<{ message: string }> {
    const res = await fetch(`${API_BASE_URL}/auth/verify-email`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ token }),
      ...withCredentials,
    });
    if (!res.ok) {
      const msg = await res.text().catch(() => res.statusText);
      throw new Error(`Verify email failed: ${msg}`);
    }
    return res.json();
  },

  async requestPasswordReset(email: string): Promise<{ message: string; reset_token?: string }> {
    const res = await fetch(`${API_BASE_URL}/auth/request-password-reset`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email }),
      ...withCredentials,
    });
    if (!res.ok) {
      const msg = await res.text().catch(() => res.statusText);
      throw new Error(`Request reset failed: ${msg}`);
    }
    return res.json();
  },

  async resetPassword(token: string, newPassword: string): Promise<{ message: string }> {
    const res = await fetch(`${API_BASE_URL}/auth/reset-password`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ token, new_password: newPassword }),
      ...withCredentials,
    });
    if (!res.ok) {
      const msg = await res.text().catch(() => res.statusText);
      throw new Error(`Reset password failed: ${msg}`);
    }
    return res.json();
  },

  async login(data: { email: string; password: string; }): Promise<LoginResponse> {
    const res = await fetch(`${API_BASE_URL}/auth/login`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data),
      ...withCredentials,
    });
    if (!res.ok) {
      const msg = await res.text().catch(() => res.statusText);
      throw new Error(`Login failed: ${msg}`);
    }
    return res.json();
  },

  async refresh(): Promise<{ message: string; refresh_expires?: string }> {
    const res = await fetch(`${API_BASE_URL}/auth/refresh`, {
      method: 'POST',
      headers: mutationHeaders(),
      ...withCredentials,
    });
    if (!res.ok) {
      const msg = await res.text().catch(() => res.statusText);
      throw new Error(`Refresh failed: ${msg}`);
    }
    return res.json();
  },

  async logout(): Promise<void> {
    const res = await fetch(`${API_BASE_URL}/auth/logout`, {
      method: 'POST',
      headers: mutationHeaders(),
      ...withCredentials,
    });
    if (!res.ok) {
      const msg = await res.text().catch(() => res.statusText);
      throw new Error(`Logout failed: ${msg}`);
    }
  },

  async logoutAll(): Promise<void> {
    const res = await fetch(`${API_BASE_URL}/auth/logout-all`, {
      method: 'POST',
      headers: mutationHeaders(),
      ...withCredentials,
    });
    if (!res.ok) {
      const msg = await res.text().catch(() => res.statusText);
      throw new Error(`Logout all failed: ${msg}`);
    }
  },

  async me(): Promise<{ user: AuthUser; }> {
    const res = await fetch(`${API_BASE_URL}/auth/profile`, {
      ...withCredentials,
    });
    if (!res.ok) {
      const msg = await res.text().catch(() => res.statusText);
      throw new Error(`Profile failed: ${msg}`);
    }
    return res.json();
  },

  async changePassword(currentPassword: string, newPassword: string): Promise<{ message: string }> {
    const res = await fetch(`${API_BASE_URL}/auth/change-password`, {
      method: 'POST',
      headers: mutationHeaders(),
      body: JSON.stringify({ current_password: currentPassword, new_password: newPassword }),
      ...withCredentials,
    });
    if (!res.ok) {
      const msg = await res.text().catch(() => res.statusText);
      throw new Error(`Change password failed: ${msg}`);
    }
    return res.json();
  },

  async updateProfile(data: { actionbar?: string[] }): Promise<{ user: AuthUser }> {
    const res = await fetch(`${API_BASE_URL}/auth/profile`, {
      method: 'PATCH',
      headers: mutationHeaders(),
      body: JSON.stringify(data),
      ...withCredentials,
    });
    if (!res.ok) {
      const msg = await res.text().catch(() => res.statusText);
      throw new Error(`Update profile failed: ${msg}`);
    }
    return res.json();
  },

  async deleteUserData(password: string): Promise<{ message: string }> {
    const res = await fetch(`${API_BASE_URL}/auth/data`, {
      method: 'DELETE',
      headers: mutationHeaders(),
      body: JSON.stringify({ password }),
      ...withCredentials,
    });
    if (!res.ok) {
      const data = await res.json().catch(() => ({}));
      throw new Error(data.error || 'Failed to delete user data');
    }
    return res.json();
  },
};
