"use client";

import React, { useState, useEffect } from "react";
import Link from "next/link";
import Image from "next/image";
import { useRouter } from "next/navigation";
import { useAuth } from "../../contexts/AuthContext";
import commandIcon from '@/assets/components/add_card/keyboard_command_key_24px.svg';
import returnIcon from '@/assets/components/add_card/keyboard_return_24px.svg';
import checkboxFilled from '@/assets/components/add_card/check_box_fill1_24px.svg';
import addIcon from '@/assets/components/kanban/add_24px.svg';
import pauseIcon from '@/assets/components/cards/pause_filled_24px.svg';
import upChevronIcon from '@/assets/components/cards/up_chevron.svg';
import downChevronIcon from '@/assets/components/cards/down_chevron.svg';
import "./login.css";
import "../../components/cards/NewTaskCard.css";
import "../../components/cards/Card.css";

export default function LoginPage() {
  const router = useRouter();
  const { login } = useAuth();
  const [email, setEmail] = useState("");
  const [password, setPassword] = useState("");
  const [error, setError] = useState<string | null>(null);
  const [loading, setLoading] = useState(false);
  const [emailError, setEmailError] = useState(false);
  const [passwordError, setPasswordError] = useState(false);
  const [sessionSeconds, setSessionSeconds] = useState(0);
  const [displayCardExpanded, setDisplayCardExpanded] = useState(true);

  // Ephemeral timer for display card
  useEffect(() => {
    const interval = setInterval(() => {
      setSessionSeconds(prev => prev + 1);
    }, 1000);
    return () => clearInterval(interval);
  }, []);

  const formatTime = (seconds: number) => {
    const hrs = Math.floor(seconds / 3600);
    const mins = Math.floor((seconds % 3600) / 60);
    const secs = seconds % 60;
    return `${hrs.toString().padStart(2, '0')}:${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
  };

  const onSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    setError(null);
    // Basic client-side validation
    const emailBlank = email.trim().length === 0;
    const passwordBlank = password.trim().length === 0;
    setEmailError(emailBlank);
    setPasswordError(passwordBlank);
    if (emailBlank || passwordBlank) {
      return;
    }
    setLoading(true);
    try {
      await login(email, password);
      router.push("/dashboard");
    } catch (err: unknown) {
      const msg = err instanceof Error ? err.message : "Login failed";
      setError(msg);
    } finally {
      setLoading(false);
    }
  };

  return (
    <div className="login-page">
      <div className="login-left-panel">
        <div className="login-left-content">
          <div className="login-brand">
          <Link href="/" className="brand-link" aria-label="Astrotask home">
            <span className="brand-wordmark">
              <span className="brand-wordmark-base">ASTRO</span>
              <span className="brand-wordmark-accent">TASK</span>
            </span>
          </Link>
          <span className="brand-welcome">A Privacy Focused <span className="brand-welcome-emphasis">KANBAN</span> built for Makers And Creatives.</span>
        </div>

        <div className="display-new-task-card">
          <div className="new-task-card">
            <div className="new-task-content">
              <div className="new-task-header">
                <span className="new-task-label">TASK</span>
                <div className="new-task-title-input">Task Title</div>
              </div>

              <div className="new-task-meta">
                <div className="new-task-meta-item">
                  <span className="new-task-label">PROJECT</span>
                  <div className="new-task-project confirmed">
                    <span className="new-task-project-input">Astrotask</span>
                  </div>
                </div>

                <div className="new-task-meta-item">
                  <span className="new-task-label">TAGS</span>
                  <div className="new-task-tags">
                    <span className="new-task-tag">Design</span>
                    <span className="new-task-tag">Kanban</span>
                    <span className="new-task-tag new-task-tag-add">
                      <Image src={addIcon} alt="Add" width={20} height={20} />
                    </span>
                  </div>
                </div>
              </div>
            </div>

            <div className="new-task-footer">
              <div className="new-task-actions">
                <div className="new-task-checkbox">
                  <Image src={checkboxFilled} alt="Checked" width={24} height={24} />
                  <span>Add more</span>
                  <div className="new-task-create-shortcut">
                    <Image src={commandIcon} alt="Command" width={17} height={17} />
                    <span>A</span>
                  </div>
                </div>
                <div className="new-task-cancel">
                  Cancel
                  <div className="new-task-create-shortcut">
                    <span>ESC</span>
                  </div>
                </div>
                <div className="new-task-create">
                  Create
                  <div className="new-task-create-shortcut">
                    <Image src={commandIcon} alt="Command" width={17} height={17} />
                    <Image src={returnIcon} alt="Return" width={17} height={17} />
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div className="display-card-expanded">
          <div className={`card ${displayCardExpanded ? 'card--expanded' : 'card--active'}`}>
            <div className="card-content">
              <div className="card-top">
                <div style={{ flex: 1 }}>
                  <div className="card-label">TASK</div>
                  <h3 className="card-title">Wireframe Login Flow</h3>
                </div>
                <div className="card-controls">
                  <div className="card-pause">
                    <Image src={pauseIcon} alt="Pause" width={28} height={28} />
                  </div>
                  <button
                    className="card-expand display-card-expand-btn"
                    onClick={() => setDisplayCardExpanded(!displayCardExpanded)}
                  >
                    <Image
                      src={displayCardExpanded ? upChevronIcon : downChevronIcon}
                      alt={displayCardExpanded ? "Collapse" : "Expand"}
                      width={24}
                      height={24}
                    />
                  </button>
                </div>
              </div>

              <div className="card-meta">
                <div className="card-meta-item">
                  <div className="card-label">PROJECT</div>
                  <div className="card-project">
                    <span>Astrotask</span>
                  </div>
                </div>
                <div className="card-meta-item">
                  <div className="card-label">TAGS</div>
                  <div className="card-tags">
                    <span className="card-tag">Design</span>
                  </div>
                </div>
              </div>
            </div>

            <div className="card-timer">
              <div className="card-timer-inner">
                <span className="card-time">{formatTime(sessionSeconds)}</span>
              </div>
            </div>

            <div className="card-sessions">
              <div className="card-sessions-list">
                <div className="card-session-row inactive">
                  <span>Session 1</span>
                  <span>00:12:20</span>
                </div>
                <div className="card-session-separator" />
                <div className="card-session-row active">
                  <span>Session 2</span>
                  <span>{formatTime(sessionSeconds)}</span>
                </div>
                <div className="card-session-separator" />
                <div className="card-session-row total">
                  <span>total</span>
                  <span>{formatTime(740 + sessionSeconds)}</span>
                </div>
              </div>
            </div>
          </div>
        </div>
        </div>
      </div>
      <div className="login-right-panel">
        <form onSubmit={onSubmit} className={`login-card ${loading ? 'login-loading' : ''}`}>
          <h1 className="login-title">Login</h1>

          <div className={`login-field${emailError ? ' error' : ''}`}>
            <input
              className="login-input"
              type="email"
              value={email}
              onChange={(e) => { setEmail(e.target.value); if (emailError && e.target.value.trim()) setEmailError(false); }}
              placeholder="Email"
              autoComplete="email"
            />
          </div>

          <div className={`login-field${passwordError ? ' error' : ''}`}>
            <input
              className="login-input"
              type="password"
              value={password}
              onChange={(e) => { setPassword(e.target.value); if (passwordError && e.target.value.trim()) setPasswordError(false); }}
              placeholder="Password"
              autoComplete="current-password"
            />
          </div>

          {error && <p className="login-error">{error}</p>}

          <button type="submit" className="login-cta" disabled={loading || !email.trim() || !password.trim()}>
            <span className="login-cta-text">{loading ? "Logging in..." : "Login"}</span>
          </button>

          <button type="button" className="login-cta">
            <span className="login-cta-text">Get an Invite</span>
          </button>
        </form>
      </div>
    </div>
  );
}
