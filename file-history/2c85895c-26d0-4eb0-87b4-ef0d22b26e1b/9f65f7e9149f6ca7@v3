"use client";

import React, { useEffect, useState } from "react";
import { useRouter } from "next/navigation";
import { useAuth } from "@/contexts/AuthContext";
import { metricsApi, MetricsOverview, ChartDataPoint } from "@/services/metricsApi";
import {
  LineChart,
  Line,
  XAxis,
  YAxis,
  CartesianGrid,
  Tooltip,
  ResponsiveContainer,
} from "recharts";
import "./metrics.css";

export default function MetricsPage() {
  const router = useRouter();
  const { user, isAuthenticated, loading } = useAuth();
  const [overview, setOverview] = useState<MetricsOverview | null>(null);
  const [chartData, setChartData] = useState<ChartDataPoint[]>([]);
  const [chartPeriod, setChartPeriod] = useState<"week" | "month" | "year">("week");
  const [chartMetric, setChartMetric] = useState<"signups" | "tasks" | "time" | "sessions">("signups");
  const [error, setError] = useState<string | null>(null);
  const [loadingData, setLoadingData] = useState(true);

  // Redirect non-admins
  useEffect(() => {
    if (loading) return;
    if (!isAuthenticated) {
      router.push("/login");
      return;
    }
    if (user?.role !== "admin") {
      router.push("/dashboard");
      return;
    }
  }, [loading, isAuthenticated, user, router]);

  // Fetch overview data
  useEffect(() => {
    if (!isAuthenticated || user?.role !== "admin") return;

    const fetchOverview = async () => {
      try {
        const data = await metricsApi.getOverview();
        setOverview(data);
        setError(null);
      } catch (err) {
        setError(err instanceof Error ? err.message : "Failed to load metrics");
      } finally {
        setLoadingData(false);
      }
    };

    fetchOverview();
    // Poll every 30 seconds for real-time updates
    const interval = setInterval(fetchOverview, 30000);
    return () => clearInterval(interval);
  }, [isAuthenticated, user]);

  // Fetch chart data
  useEffect(() => {
    if (!isAuthenticated || user?.role !== "admin") return;

    const fetchChart = async () => {
      try {
        const data = await metricsApi.getChartData(chartPeriod, chartMetric);
        setChartData(data.data || []);
      } catch (err) {
        console.error("Chart fetch error:", err);
      }
    };

    fetchChart();
  }, [isAuthenticated, user, chartPeriod, chartMetric]);

  // Format duration in seconds to "Xh Ym" format
  const formatDuration = (seconds: number): string => {
    if (!seconds || seconds === 0) return "0m";
    const hours = Math.floor(seconds / 3600);
    const mins = Math.floor((seconds % 3600) / 60);
    if (hours === 0) return `${mins}m`;
    return `${hours}h ${mins}m`;
  };

  // Prevent flash before auth hydrates
  if (loading || !isAuthenticated || user?.role !== "admin") {
    return null;
  }

  return (
    <div className="metrics-page">
      <div className="metrics-container">
        <h1 className="metrics-title">Admin Metrics</h1>
        {error && <p className="metrics-error">{error}</p>}

        {loadingData ? (
          <p className="metrics-loading">Loading metrics...</p>
        ) : overview ? (
          <>
            {/* Stats Cards Grid */}
            <div className="metrics-cards">
              <div className="metrics-card">
                <h3 className="metrics-card-title">Users</h3>
                <p className="metrics-card-value">{overview.users.total}</p>
                <ul className="metrics-card-details">
                  <li>Today: {overview.users.today}</li>
                  <li>This week: {overview.users.this_week}</li>
                  <li>This month: {overview.users.this_month}</li>
                  <li>Verified: {overview.users.verified}</li>
                  <li>Admins: {overview.users.admins}</li>
                </ul>
              </div>

              <div className="metrics-card">
                <h3 className="metrics-card-title">Tasks</h3>
                <p className="metrics-card-value">{overview.tasks.total}</p>
                <ul className="metrics-card-details">
                  <li>Active timers: {overview.tasks.active}</li>
                  <li>Completed: {overview.tasks.completed}</li>
                  <li>Today: {overview.tasks.today}</li>
                  <li>This week: {overview.tasks.this_week}</li>
                  <li>Avg duration: {formatDuration(overview.tasks.avg_duration)}</li>
                </ul>
              </div>

              <div className="metrics-card">
                <h3 className="metrics-card-title">Time Tracked</h3>
                <p className="metrics-card-value">{formatDuration(overview.sessions.total_time_tracked)}</p>
                <ul className="metrics-card-details">
                  <li>Active now: {overview.sessions.active_now}</li>
                  <li>Today: {formatDuration(overview.sessions.today_time)}</li>
                  <li>This week: {formatDuration(overview.sessions.this_week_time)}</li>
                  <li>This month: {formatDuration(overview.sessions.this_month_time)}</li>
                  <li>Total sessions: {overview.sessions.total}</li>
                </ul>
              </div>
            </div>

            {/* Chart Section */}
            <div className="metrics-chart-section">
              <div className="metrics-chart-header">
                <h2 className="metrics-section-title">Trends</h2>
                <div className="metrics-chart-controls">
                  <select
                    value={chartMetric}
                    onChange={(e) => setChartMetric(e.target.value as typeof chartMetric)}
                    className="metrics-select"
                  >
                    <option value="signups">Signups</option>
                    <option value="tasks">Tasks Created</option>
                    <option value="sessions">Sessions</option>
                    <option value="time">Time Tracked</option>
                  </select>
                  <select
                    value={chartPeriod}
                    onChange={(e) => setChartPeriod(e.target.value as typeof chartPeriod)}
                    className="metrics-select"
                  >
                    <option value="week">Last 7 days</option>
                    <option value="month">Last 30 days</option>
                    <option value="year">Last 365 days</option>
                  </select>
                </div>
              </div>

              <div className="metrics-chart">
                {chartData.length > 0 ? (
                  <ResponsiveContainer width="100%" height={300}>
                    <LineChart data={chartData}>
                      <CartesianGrid strokeDasharray="3 3" stroke="#E5E7EB" />
                      <XAxis
                        dataKey="date"
                        stroke="#6B7280"
                        fontSize={12}
                        tickFormatter={(value) => {
                          const date = new Date(value);
                          return `${date.getMonth() + 1}/${date.getDate()}`;
                        }}
                      />
                      <YAxis stroke="#6B7280" fontSize={12} />
                      <Tooltip
                        contentStyle={{
                          backgroundColor: "#FFFFFF",
                          border: "1px solid #E5E7EB",
                          borderRadius: "8px",
                          fontFamily: "Berkeley Mono, monospace",
                        }}
                        formatter={(value) => {
                          const num = typeof value === "number" ? value : 0;
                          return chartMetric === "time" ? formatDuration(num) : num;
                        }}
                      />
                      <Line
                        type="monotone"
                        dataKey="value"
                        stroke="#3B82F6"
                        strokeWidth={2}
                        dot={{ fill: "#3B82F6", strokeWidth: 0 }}
                        activeDot={{ r: 6 }}
                      />
                    </LineChart>
                  </ResponsiveContainer>
                ) : (
                  <p className="metrics-chart-empty">No data for selected period</p>
                )}
              </div>
            </div>

            {/* Top Users Table */}
            {overview.top_users && overview.top_users.length > 0 && (
              <div className="metrics-top-users">
                <h2 className="metrics-section-title">Most Active Users</h2>
                <table className="metrics-table">
                  <thead>
                    <tr>
                      <th>Name</th>
                      <th>Email</th>
                      <th>Time Tracked</th>
                      <th>Tasks</th>
                      <th>Sessions</th>
                    </tr>
                  </thead>
                  <tbody>
                    {overview.top_users.map((topUser) => (
                      <tr key={topUser.user_id}>
                        <td>{topUser.name}</td>
                        <td>{topUser.email}</td>
                        <td>{formatDuration(topUser.time_tracked)}</td>
                        <td>{topUser.task_count}</td>
                        <td>{topUser.session_count}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
          </>
        ) : null}
      </div>
    </div>
  );
}
