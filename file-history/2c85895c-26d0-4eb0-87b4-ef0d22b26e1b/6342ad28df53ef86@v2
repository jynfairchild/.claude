import fs from "fs";
import path from "path";
import { fileURLToPath } from "url";
import type { NextConfig } from "next";

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);

// In Docker, changelog is copied to .changelog; locally it's at ../.changelog
const changelogDir = fs.existsSync(path.resolve(__dirname, ".changelog"))
  ? path.resolve(__dirname, ".changelog")
  : path.resolve(__dirname, "../.changelog");

const latestVersion = (() => {
  try {
    const files = fs
      .readdirSync(changelogDir, { withFileTypes: true })
      .filter((entry) => entry.isFile())
      .map((entry) => entry.name)
      .filter((name) => /^v\d+\.\d+\.\d+\.md$/i.test(name));

    if (!files.length) return "0.0.0";

    const toTuple = (filename: string) =>
      filename
        .replace(/^v/i, "")
        .replace(/\.md$/i, "")
        .split(".")
        .map((segment) => Number.parseInt(segment, 10));

    files.sort((a, b) => {
      const [aMajor = 0, aMinor = 0, aPatch = 0] = toTuple(a);
      const [bMajor = 0, bMinor = 0, bPatch = 0] = toTuple(b);

      if (aMajor !== bMajor) return aMajor - bMajor;
      if (aMinor !== bMinor) return aMinor - bMinor;
      return aPatch - bPatch;
    });

    const latest = files.at(-1);
    if (!latest) return "0.0.0";

    return latest.replace(/^v/i, "").replace(/\.md$/i, "");
  } catch {
    return "0.0.0";
  }
})();

const nextConfig: NextConfig = {
  output: 'standalone', // Enable standalone output for Docker deployment
  devIndicators: false,
  eslint: { ignoreDuringBuilds: true },
  async redirects() {
    return [
      { source: '/verify_email', destination: '/verify-email', permanent: false },
      { source: '/verify_token', destination: '/verify-email', permanent: false },
      { source: '/reset_password', destination: '/reset-password', permanent: false },
      { source: '/forgot_password', destination: '/forgot-password', permanent: false },
    ];
  },
  env: {
    NEXT_PUBLIC_APP_VERSION: latestVersion,
  },
};

export default nextConfig;
