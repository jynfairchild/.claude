func (h *AuthHandler) Signup(c *gin.Context) {
	var req SignupRequest
	if err := c.ShouldBindJSON(&req); err != nil {
		c.JSON(http.StatusBadRequest, gin.H{"error": err.Error()})
		return
	}

	if err := h.validate.Struct(req); err != nil {
		c.JSON(http.StatusBadRequest, gin.H{"error": err.Error()})
		return
	}

	// Check if invite-only mode is enabled
	requireInvite := os.Getenv("REQUIRE_INVITE") == "true"

	// Validate and consume invitation token if provided
	var inviteVerified bool
	if req.InviteToken != "" {
		invite, err := auth.ConsumeInvitationToken(h.db, req.InviteToken)
		if err != nil {
			c.JSON(http.StatusBadRequest, gin.H{"error": "Invalid or expired invitation"})
			return
		}
		// Verify email matches the invitation
		if invite.Email != req.Email {
			c.JSON(http.StatusBadRequest, gin.H{"error": "Email does not match invitation"})
			return
		}
		inviteVerified = true
	} else if requireInvite {
		// Invite-only mode but no token provided
		c.JSON(http.StatusForbidden, gin.H{"error": "Invitation required to sign up"})
		return
	}

    var existingUser models.User
    if err := h.db.Where("email = ?", req.Email).First(&existingUser).Error; err == nil {
        c.JSON(http.StatusConflict, gin.H{"error": "User already exists"})
        return
    }

    hashedPassword, err := auth.HashPassword(req.Password)
    if err != nil {
        c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to hash password"})
        return
    }

    // Generate encryption salt for zero-knowledge client-side encryption
    saltBytes := make([]byte, 32)
    if _, err := rand.Read(saltBytes); err != nil {
        c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to generate encryption salt"})
        return
    }
    encryptionSalt := base64.StdEncoding.EncodeToString(saltBytes)

	// Auto-verify email if invited
	var emailVerifiedAt *time.Time
	if inviteVerified {
		now := time.Now()
		emailVerifiedAt = &now
	}

    // Check if this email should be auto-promoted to admin
    adminEmail := os.Getenv("ADMIN_EMAIL")
    role := "user"
    if adminEmail != "" && strings.EqualFold(req.Email, adminEmail) {
        role = "admin"
    }

    user := models.User{
        Email:           req.Email,
        Name:            req.Name,
        PasswordHash:    hashedPassword,
        EncryptionSalt:  encryptionSalt,
        Role:            role,
        Plan:            "normal",
        Actionbar:       pq.StringArray{},
        EmailVerifiedAt: emailVerifiedAt,
    }
	
    if err := h.db.Create(&user).Error; err != nil {
        c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to create user"})
        return
    }

    token, err := auth.GenerateToken(user.ID, user.Email, user.Name)
    if err != nil {
        c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to generate token"})
        return
    }

    // Issue refresh token
    ua := c.Request.UserAgent()
    ip := c.ClientIP()
    refreshToken, _, err := auth.CreateRefreshToken(h.db, user.ID, ua, ip)
    if err != nil {
        c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to create refresh token"})
        return
    }

    // Set HttpOnly cookies for access and refresh tokens
    utils.SetAccessTokenCookie(c, token, auth.AccessTTL())
    utils.SetRefreshTokenCookie(c, refreshToken, auth.RefreshTTL())

    // Set CSRF token cookie (non-HttpOnly so JS can read it)
    csrfToken := generateCSRFToken()
    utils.SetCSRFTokenCookie(c, csrfToken)

    resp := gin.H{
        "message": "User created successfully",
        "user": gin.H{
            "id":               user.ID,
            "email":            user.Email,
            "name":             user.Name,
            "role":             user.Role,
            "plan":             user.Plan,
            "actionbar":        user.Actionbar,
            "email_verified_at": user.EmailVerifiedAt,
            "encryption_salt":  user.EncryptionSalt,
        },
    }

    // Create email verification token only if not invited (invited users are auto-verified)
    if !inviteVerified {
        verifyToken, _, err := auth.CreateEmailVerificationToken(h.db, user.ID)
        if err != nil {
            c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to create verification token"})
            return
        }
        if devEchoTokensEnabled() {
            resp["verification_token"] = verifyToken
        }
    }

    // DEV: optionally include tokens in JSON for testing tools
    if devReturnTokensInJSON() {
        resp["token"] = token
        resp["refresh_token"] = refreshToken
    }

    c.JSON(http.StatusCreated, resp)
}

func (h *AuthHandler) Login(c *gin.Context) {
	var req LoginRequest
	if err := c.ShouldBindJSON(&req); err != nil {
		c.JSON(http.StatusBadRequest, gin.H{"error": err.Error()})
		return
	}

	if err := h.validate.Struct(req); err != nil {
		c.JSON(http.StatusBadRequest, gin.H{"error": err.Error()})
		return
	}

	var user models.User
    if err := h.db.Where("email = ?", req.Email).First(&user).Error; err != nil {
        c.JSON(http.StatusUnauthorized, gin.H{"error": "Invalid credentials"})
        return
    }
    ok, newHash, err := auth.VerifyAndMaybeRehash(user.PasswordHash, req.Password)
    if err != nil || !ok {
        c.JSON(http.StatusUnauthorized, gin.H{"error": "Invalid credentials"})
        return
    }
    if newHash != "" {
        // Migrate credential to Argon2id
        user.PasswordHash = newHash
        now := time.Now()
        user.UpdatedAt = now
        _ = h.db.Model(&user).Update("password_hash", newHash).Error
    }

    // Generate encryption salt for existing users who don't have one
    if user.EncryptionSalt == "" {
        saltBytes := make([]byte, 32)
        if _, err := rand.Read(saltBytes); err != nil {
            c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to generate encryption salt"})
            return
        }
        user.EncryptionSalt = base64.StdEncoding.EncodeToString(saltBytes)
        _ = h.db.Model(&user).Update("encryption_salt", user.EncryptionSalt).Error
    }

    token, err := auth.GenerateToken(user.ID, user.Email, user.Name)
    if err != nil {
        c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to generate token"})
        return
    }

    // Create refresh token
    ua := c.Request.UserAgent()
    ip := c.ClientIP()
    refreshToken, _, err := auth.CreateRefreshToken(h.db, user.ID, ua, ip)
    if err != nil {
        c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to create refresh token"})
        return
    }

    // Set HttpOnly cookies for access and refresh tokens
    utils.SetAccessTokenCookie(c, token, auth.AccessTTL())
    utils.SetRefreshTokenCookie(c, refreshToken, auth.RefreshTTL())

    // Set CSRF token cookie (non-HttpOnly so JS can read it)
    csrfToken := generateCSRFToken()
    utils.SetCSRFTokenCookie(c, csrfToken)

    resp := gin.H{
        "message": "Login successful",
        "user": gin.H{
            "id":              user.ID,
            "email":           user.Email,
            "name":            user.Name,
            "role":            user.Role,
            "plan":            user.Plan,
            "actionbar":       user.Actionbar,
            "encryption_salt": user.EncryptionSalt,
        },
    }
    // DEV: optionally include tokens in JSON for testing tools
    if devReturnTokensInJSON() {
        resp["token"] = token
        resp["refresh_token"] = refreshToken
    }
    c.JSON(http.StatusOK, resp)
}

