// generateCSRFToken creates a random CSRF token
func generateCSRFToken() string {
    b := make([]byte, 32)
    if _, err := rand.Read(b); err != nil {
        return ""
    }
    return base64.RawURLEncoding.EncodeToString(b)
}

type AuthHandler struct {
	db       *gorm.DB
	validate *validator.Validate
}

func NewAuthHandler(db *gorm.DB) *AuthHandler {
    return &AuthHandler{
        db:       db,
        validate: validator.New(),
    }
}

// devEchoTokensEnabled controls whether sensitive one-time tokens (verification, password reset)
// are echoed in API responses. Defaults to true for developer convenience unless explicitly disabled.
func devEchoTokensEnabled() bool {
    v := os.Getenv("DEV_ECHO_TOKENS")
    if v == "" { return false } // secure-by-default: disabled unless explicitly enabled
    b, err := strconv.ParseBool(v)
    if err != nil { return false }
    return b
}

// devReturnTokensInJSON controls whether access/refresh tokens are returned in JSON response body.
// In production, tokens should only be set as HttpOnly cookies. In dev, returning them in JSON
// makes testing easier (e.g., with curl or Postman).
func devReturnTokensInJSON() bool {
    v := os.Getenv("DEV_RETURN_TOKENS")
    if v == "" { return false } // secure-by-default
    b, err := strconv.ParseBool(v)
    if err != nil { return false }
    return b
}

