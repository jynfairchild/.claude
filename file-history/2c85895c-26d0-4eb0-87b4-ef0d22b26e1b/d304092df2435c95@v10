// Refresh exchanges a valid refresh token for a new access token and rotated refresh token
func (h *AuthHandler) Refresh(c *gin.Context) {
    // Try to get refresh token from cookie first, then fallback to JSON body
    var refreshTokenStr string
    if cookie, err := c.Cookie("refresh_token"); err == nil && cookie != "" {
        refreshTokenStr = cookie
    } else {
        var req RefreshRequest
        if err := c.ShouldBindJSON(&req); err != nil {
            c.JSON(http.StatusBadRequest, gin.H{"error": "Refresh token required"})
            return
        }
        if err := h.validate.Struct(req); err != nil {
            c.JSON(http.StatusBadRequest, gin.H{"error": err.Error()})
            return
        }
        refreshTokenStr = req.RefreshToken
    }

    // Rotate refresh token
    ua := c.Request.UserAgent()
    ip := c.ClientIP()
    newRefresh, rt, err := auth.RotateRefreshToken(h.db, refreshTokenStr, ua, ip)
    if err != nil {
        c.JSON(http.StatusUnauthorized, gin.H{"error": "Invalid or expired refresh token"})
        return
    }

    // Issue new access token
    var user models.User
    if err := h.db.First(&user, rt.UserID).Error; err != nil {
        c.JSON(http.StatusUnauthorized, gin.H{"error": "User not found"})
        return
    }
    access, err := auth.GenerateToken(user.ID, user.Email, user.Name)
    if err != nil {
        c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to generate token"})
        return
    }

    // Set new HttpOnly cookies
    utils.SetAccessTokenCookie(c, access, auth.AccessTTL())
    utils.SetRefreshTokenCookie(c, newRefresh, auth.RefreshTTL())

    // Regenerate CSRF token
    csrfToken := generateCSRFToken()
    utils.SetCSRFTokenCookie(c, csrfToken)

    resp := gin.H{
        "message":         "Token refreshed",
        "refresh_expires": rt.ExpiresAt,
    }
    // DEV: optionally include tokens in JSON for testing tools
    if devReturnTokensInJSON() {
        resp["token"] = access
        resp["refresh_token"] = newRefresh
    }
    c.JSON(http.StatusOK, resp)
}

// Logout revokes a single refresh token (from cookie or request body) and clears cookies
func (h *AuthHandler) Logout(c *gin.Context) {
    // Try to get refresh token from cookie first, then fallback to JSON body
    var refreshTokenStr string
    if cookie, err := c.Cookie("refresh_token"); err == nil && cookie != "" {
        refreshTokenStr = cookie
    } else {
        var req LogoutRequest
        if err := c.ShouldBindJSON(&req); err == nil && req.RefreshToken != "" {
            refreshTokenStr = req.RefreshToken
        }
    }

    // Revoke the refresh token if we have one
    if refreshTokenStr != "" {
        _ = auth.RevokeRefreshToken(h.db, refreshTokenStr) // Best effort, don't fail logout
    }

    // Always clear auth cookies
    utils.ClearAuthCookies(c)

    c.JSON(http.StatusOK, gin.H{"message": "Logged out"})
}

// LogoutAll revokes all refresh tokens for the authenticated user and clears cookies
func (h *AuthHandler) LogoutAll(c *gin.Context) {
    userID := c.GetUint("userID")
    if userID == 0 {
        c.JSON(http.StatusUnauthorized, gin.H{"error": "Unauthorized"})
        return
    }
    if err := auth.RevokeAllUserRefreshTokens(h.db, userID); err != nil {
        c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to revoke sessions"})
        return
    }

    // Clear auth cookies for this session
    utils.ClearAuthCookies(c)

    c.JSON(http.StatusOK, gin.H{"message": "All sessions revoked"})
}

// VerifyEmail marks a user's email as verified using a one-time token
func (h *AuthHandler) VerifyEmail(c *gin.Context) {
    var req VerifyEmailRequest
    if err := c.ShouldBindJSON(&req); err != nil {
        c.JSON(http.StatusBadRequest, gin.H{"error": err.Error()})
        return
    }
    if err := h.validate.Struct(req); err != nil {
        c.JSON(http.StatusBadRequest, gin.H{"error": err.Error()})
        return
    }

    rec, err := auth.ConsumeEmailVerificationToken(h.db, req.Token)
    if err != nil {
        c.JSON(http.StatusBadRequest, gin.H{"error": "Invalid or expired token"})
        return
    }
    var user models.User
    if err := h.db.First(&user, rec.UserID).Error; err != nil {
        c.JSON(http.StatusNotFound, gin.H{"error": "User not found"})
        return
    }
    now := time.Now()
    user.EmailVerifiedAt = &now
    if err := h.db.Save(&user).Error; err != nil {
        c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to verify email"})
        return
    }
    c.JSON(http.StatusOK, gin.H{"message": "Email verified"})
}

// RequestPasswordReset creates a one-time token and (in dev) returns it in response
func (h *AuthHandler) RequestPasswordReset(c *gin.Context) {
    var req RequestPasswordResetRequest
    if err := c.ShouldBindJSON(&req); err != nil {
        c.JSON(http.StatusBadRequest, gin.H{"error": err.Error()})
        return
    }
    if err := h.validate.Struct(req); err != nil {
        c.JSON(http.StatusBadRequest, gin.H{"error": err.Error()})
        return
    }
    // Respond 200 regardless to avoid account enumeration
    var user models.User
    if err := h.db.Where("email = ?", req.Email).First(&user).Error; err != nil {
        c.JSON(http.StatusOK, gin.H{"message": "If the email exists, a reset token was issued"})
        return
    }
    token, _, err := auth.CreatePasswordResetToken(h.db, user.ID)
    if err != nil {
        c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to create reset token"})
        return
    }
    resp := gin.H{"message": "Password reset token created"}
    if devEchoTokensEnabled() {
        resp["reset_token"] = token
    }
    c.JSON(http.StatusOK, resp)
}

// ResetPassword consumes a valid reset token and sets a new password
func (h *AuthHandler) ResetPassword(c *gin.Context) {
    var req ResetPasswordRequest
    if err := c.ShouldBindJSON(&req); err != nil {
        c.JSON(http.StatusBadRequest, gin.H{"error": err.Error()})
        return
    }
    if err := h.validate.Struct(req); err != nil {
        c.JSON(http.StatusBadRequest, gin.H{"error": err.Error()})
        return
    }
    rec, err := auth.ConsumePasswordResetToken(h.db, req.Token)
    if err != nil {
        c.JSON(http.StatusBadRequest, gin.H{"error": "Invalid or expired token"})
        return
    }
    var user models.User
    if err := h.db.First(&user, rec.UserID).Error; err != nil {
        c.JSON(http.StatusNotFound, gin.H{"error": "User not found"})
        return
    }
    newHash, err := auth.HashPassword(req.NewPassword)
    if err != nil {
        c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to hash password"})
        return
    }
    user.PasswordHash = newHash
    if err := h.db.Save(&user).Error; err != nil {
        c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to update password"})
        return
    }
    // Revoke all refresh tokens for safety
    _ = auth.RevokeAllUserRefreshTokens(h.db, user.ID)
    c.JSON(http.StatusOK, gin.H{"message": "Password updated"})
}

// ChangePassword updates password for authenticated user
func (h *AuthHandler) ChangePassword(c *gin.Context) {
    userID := c.GetUint("userID")
    if userID == 0 {
        c.JSON(http.StatusUnauthorized, gin.H{"error": "Unauthorized"})
        return
    }
    var req ChangePasswordRequest
    if err := c.ShouldBindJSON(&req); err != nil {
        c.JSON(http.StatusBadRequest, gin.H{"error": err.Error()})
        return
    }
    if err := h.validate.Struct(req); err != nil {
        c.JSON(http.StatusBadRequest, gin.H{"error": err.Error()})
        return
    }
    var user models.User
    if err := h.db.First(&user, userID).Error; err != nil {
        c.JSON(http.StatusNotFound, gin.H{"error": "User not found"})
        return
    }
    ok, _, err := auth.VerifyAndMaybeRehash(user.PasswordHash, req.CurrentPassword)
    if err != nil || !ok {
        c.JSON(http.StatusUnauthorized, gin.H{"error": "Current password incorrect"})
        return
    }
    newHash, err := auth.HashPassword(req.NewPassword)
    if err != nil {
        c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to hash password"})
        return
    }
    user.PasswordHash = newHash
    if err := h.db.Save(&user).Error; err != nil {
        c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to update password"})
        return
    }
    _ = auth.RevokeAllUserRefreshTokens(h.db, user.ID)
    c.JSON(http.StatusOK, gin.H{"message": "Password changed"})
}

// ReencryptData handles password change with data re-encryption
// This endpoint changes the password AND updates all encrypted data with new encryption
func (h *AuthHandler) ReencryptData(c *gin.Context) {
    userID := c.GetUint("userID")
    if userID == 0 {
        c.JSON(http.StatusUnauthorized, gin.H{"error": "Unauthorized"})
        return
    }

    var req ReencryptRequest
    if err := c.ShouldBindJSON(&req); err != nil {
        c.JSON(http.StatusBadRequest, gin.H{"error": err.Error()})
        return
    }
    if err := h.validate.Struct(req); err != nil {
        c.JSON(http.StatusBadRequest, gin.H{"error": err.Error()})
        return
    }

    var user models.User
    if err := h.db.First(&user, userID).Error; err != nil {
        c.JSON(http.StatusNotFound, gin.H{"error": "User not found"})
        return
    }

    // Verify current password
    ok, _, err := auth.VerifyAndMaybeRehash(user.PasswordHash, req.CurrentPassword)
    if err != nil || !ok {
        c.JSON(http.StatusUnauthorized, gin.H{"error": "Current password incorrect"})
        return
    }

    // Hash new password
    newHash, err := auth.HashPassword(req.NewPassword)
    if err != nil {
        c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to hash password"})
        return
    }

    // Perform all updates in a transaction
    if err := h.db.Transaction(func(tx *gorm.DB) error {
        // Update user's password and encryption salt
        user.PasswordHash = newHash
        user.EncryptionSalt = req.NewSalt
        if err := tx.Save(&user).Error; err != nil {
            return err
        }

        // Update each task with re-encrypted data
        for _, task := range req.Tasks {
            // Verify task belongs to user
            var existingTask models.Task
            if err := tx.Where("id = ? AND user_id = ?", task.ID, userID).First(&existingTask).Error; err != nil {
                continue // Skip tasks that don't exist or don't belong to user
            }

            // Update only the encrypted fields
            updates := map[string]interface{}{
                "title":   task.Title,
                "project": task.Project,
                "tags":    pq.StringArray(task.Tags),
            }
            if err := tx.Model(&existingTask).Updates(updates).Error; err != nil {
                return err
            }
        }

        // Update each column with re-encrypted data
        for _, col := range req.Columns {
            // Verify column belongs to user
            var existingCol models.UserColumn
            if err := tx.Where("id = ? AND user_id = ?", col.ID, userID).First(&existingCol).Error; err != nil {
                continue // Skip columns that don't exist or don't belong to user
            }

            // Update only the encrypted name field
            if err := tx.Model(&existingCol).Update("name", col.Name).Error; err != nil {
                return err
            }
        }

        return nil
    }); err != nil {
        c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to update data"})
        return
    }

    // Revoke all refresh tokens for security
    _ = auth.RevokeAllUserRefreshTokens(h.db, user.ID)

    c.JSON(http.StatusOK, gin.H{
        "message": "Password changed and data re-encrypted",
        "user": gin.H{
            "id":              user.ID,
            "email":           user.Email,
            "name":            user.Name,
            "role":            user.Role,
            "plan":            user.Plan,
            "actionbar":       user.Actionbar,
            "encryption_salt": user.EncryptionSalt,
        },
    })
}

