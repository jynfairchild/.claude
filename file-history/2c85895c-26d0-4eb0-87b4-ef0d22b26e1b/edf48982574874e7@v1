package database

import (
	"log"
	"os"
	"strings"

	"gorm.io/gorm"

	"simple_task_tracker/backend/internal/auth"
	"simple_task_tracker/backend/internal/email"
	"simple_task_tracker/backend/internal/models"
)

// BootstrapAdminInvite creates an invitation for the ADMIN_EMAIL if no users exist.
// This solves the chicken-and-egg problem: you need an admin to create invites,
// but you need an invite to become an admin.
func BootstrapAdminInvite(db *gorm.DB) {
	adminEmail := strings.TrimSpace(os.Getenv("ADMIN_EMAIL"))
	if adminEmail == "" {
		return // No admin email configured
	}

	// Only bootstrap if no users exist
	var userCount int64
	db.Model(&models.User{}).Count(&userCount)
	if userCount > 0 {
		return // Users already exist, skip bootstrap
	}

	// Check if invite already exists for this email
	var existingInvite models.Invitation
	if err := db.Where("email = ? AND used_at IS NULL", strings.ToLower(adminEmail)).First(&existingInvite).Error; err == nil {
		log.Printf("Admin invite already exists for %s (not creating new one)", adminEmail)
		return
	}

	// Create invitation with InvitedByID = 0 (system-generated)
	token, invite, err := auth.CreateInvitationToken(db, strings.ToLower(adminEmail), 0)
	if err != nil {
		log.Printf("Failed to create admin invite: %v", err)
		return
	}

	frontendURL := os.Getenv("FRONTEND_URL")
	if frontendURL == "" {
		frontendURL = "http://localhost:3000"
	}
	inviteURL := frontendURL + "/signup?invite=" + token

	// Send email (or log if no email service configured)
	if err := email.SendInviteEmail(adminEmail, inviteURL); err != nil {
		log.Printf("Failed to send admin invite email: %v", err)
	}

	log.Println("═══════════════════════════════════════════════════════")
	log.Printf("  ADMIN INVITE CREATED")
	log.Printf("  Email: %s", invite.Email)
	log.Printf("  Expires: %s", invite.ExpiresAt.Format("2006-01-02 15:04 MST"))
	if !email.IsConfigured() {
		log.Printf("  URL: %s", inviteURL)
	}
	log.Println("═══════════════════════════════════════════════════════")
}
