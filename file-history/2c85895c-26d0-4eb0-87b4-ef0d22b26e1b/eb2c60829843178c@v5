import React from 'react';
import { describe, it, expect, vi, beforeEach, afterEach } from 'vitest';
import { render, screen, waitFor, fireEvent, act } from '@testing-library/react';

// Mock navigation
const mockPush = vi.fn();
vi.mock('next/navigation', () => ({
  useRouter: () => ({
    push: mockPush,
  }),
  usePathname: () => '/metrics',
}));

// Mock auth state
let mockUser: { id: number; email: string; name: string; role: string } | null = null;
let mockIsAuthenticated = false;
let mockLoading = false;

vi.mock('@/contexts/AuthContext', () => ({
  useAuth: () => ({
    user: mockUser,
    isAuthenticated: mockIsAuthenticated,
    loading: mockLoading,
  }),
}));

// Mock metrics API
const mockGetOverview = vi.fn();
const mockGetChartData = vi.fn();

vi.mock('@/services/metricsApi', () => ({
  metricsApi: {
    getOverview: () => mockGetOverview(),
    getChartData: (period: string, metric: string) => mockGetChartData(period, metric),
  },
}));

// Mock Recharts to avoid rendering issues in tests
vi.mock('recharts', () => ({
  LineChart: ({ children }: { children: React.ReactNode }) => <div data-testid="line-chart">{children}</div>,
  Line: () => <div data-testid="line" />,
  XAxis: () => <div data-testid="x-axis" />,
  YAxis: () => <div data-testid="y-axis" />,
  CartesianGrid: () => <div data-testid="cartesian-grid" />,
  Tooltip: () => <div data-testid="tooltip" />,
  ResponsiveContainer: ({ children }: { children: React.ReactNode }) => <div data-testid="responsive-container">{children}</div>,
}));

// Import after mocks
import MetricsPage from './page';

function makeOverviewResponse() {
  return {
    users: {
      total: 42,
      verified: 35,
      unverified: 7,
      admins: 2,
      today: 3,
      this_week: 15,
      this_month: 40,
      this_year: 42,
    },
    tasks: {
      total: 256,
      total_created: 280,
      deleted: 24,
      active: 10,
      completed: 200,
      uncompleted: 46,
      avg_duration: 3600,
      today: 20,
      this_week: 75,
    },
    sessions: {
      total: 500,
      active_now: 5,
      total_time_tracked: 7200, // 2 hours
      today_time: 1800,
      this_week_time: 3600,
      this_month_time: 14400,
    },
    top_users: [
      {
        user_id: 1,
        name: 'Top User',
        email: 'top@test.com',
        time_tracked: 3600,
        task_count: 50,
        session_count: 80,
      },
    ],
  };
}

function makeChartResponse() {
  return {
    period: 'week',
    metric: 'signups',
    data: [
      { date: '2025-01-15', value: 5 },
      { date: '2025-01-16', value: 8 },
    ],
  };
}

describe('MetricsPage', () => {
  beforeEach(() => {
    vi.clearAllMocks();
    mockUser = null;
    mockIsAuthenticated = false;
    mockLoading = false;
    mockGetOverview.mockResolvedValue(makeOverviewResponse());
    mockGetChartData.mockResolvedValue(makeChartResponse());
  });

  afterEach(() => {
    vi.clearAllMocks();
  });

  describe('access control', () => {
    it('redirects to login when not authenticated', async () => {
      mockLoading = false;
      mockIsAuthenticated = false;
      mockUser = null;

      await act(async () => {
        render(<MetricsPage />);
      });

      await waitFor(() => {
        expect(mockPush).toHaveBeenCalledWith('/login');
      });
    });

    it('redirects non-admin to dashboard', async () => {
      mockLoading = false;
      mockIsAuthenticated = true;
      mockUser = { id: 1, email: 'user@test.com', name: 'User', role: 'user' };

      await act(async () => {
        render(<MetricsPage />);
      });

      await waitFor(() => {
        expect(mockPush).toHaveBeenCalledWith('/dashboard');
      });
    });

    it('renders for admin users', async () => {
      mockLoading = false;
      mockIsAuthenticated = true;
      mockUser = { id: 1, email: 'admin@test.com', name: 'Admin', role: 'admin' };

      await act(async () => {
        render(<MetricsPage />);
      });

      await waitFor(() => {
        expect(screen.getByText('Admin Metrics')).toBeInTheDocument();
      });
    });

    it('shows nothing while loading auth', () => {
      mockLoading = true;
      mockIsAuthenticated = false;
      mockUser = null;

      const { container } = render(<MetricsPage />);

      expect(container.firstChild).toBeNull();
    });
  });

  describe('data display', () => {
    beforeEach(() => {
      mockLoading = false;
      mockIsAuthenticated = true;
      mockUser = { id: 1, email: 'admin@test.com', name: 'Admin', role: 'admin' };
    });

    it('displays stats cards', async () => {
      await act(async () => {
        render(<MetricsPage />);
      });

      await waitFor(() => {
        expect(screen.getByText('Users')).toBeInTheDocument();
        // 'Tasks' appears in both card title and table header
        expect(screen.getAllByText('Tasks').length).toBeGreaterThan(0);
        // 'Time Tracked' appears in both card title and chart dropdown
        expect(screen.getAllByText('Time Tracked').length).toBeGreaterThan(0);
      });
    });

    it('displays top users table', async () => {
      await act(async () => {
        render(<MetricsPage />);
      });

      await waitFor(() => {
        expect(screen.getByText('Most Active Users')).toBeInTheDocument();
        expect(screen.getByText('Top User')).toBeInTheDocument();
        expect(screen.getByText('top@test.com')).toBeInTheDocument();
      });
    });

    it('displays error message on API failure', async () => {
      mockGetOverview.mockRejectedValue(new Error('API failed'));

      await act(async () => {
        render(<MetricsPage />);
      });

      await waitFor(() => {
        expect(screen.getByText('API failed')).toBeInTheDocument();
      });
    });
  });

  describe('chart controls', () => {
    beforeEach(() => {
      mockLoading = false;
      mockIsAuthenticated = true;
      mockUser = { id: 1, email: 'admin@test.com', name: 'Admin', role: 'admin' };
    });

    it('renders chart section', async () => {
      await act(async () => {
        render(<MetricsPage />);
      });

      await waitFor(() => {
        expect(screen.getByText('Trends')).toBeInTheDocument();
        expect(screen.getByTestId('responsive-container')).toBeInTheDocument();
      });
    });

    it('has period and metric selectors', async () => {
      await act(async () => {
        render(<MetricsPage />);
      });

      await waitFor(() => {
        expect(screen.getByDisplayValue('Last 7 days')).toBeInTheDocument();
        expect(screen.getByDisplayValue('Signups')).toBeInTheDocument();
      });
    });
  });

  describe('fail-safe behavior', () => {
    beforeEach(() => {
      mockLoading = false;
      mockIsAuthenticated = true;
      mockUser = { id: 1, email: 'admin@test.com', name: 'Admin', role: 'admin' };
    });

    it('overview API failure shows error but page still renders', async () => {
      mockGetOverview.mockRejectedValue(new Error('Database connection failed'));
      mockGetChartData.mockResolvedValue(makeChartResponse());

      await act(async () => {
        render(<MetricsPage />);
      });

      await waitFor(() => {
        expect(screen.getByText('Database connection failed')).toBeInTheDocument();
        expect(screen.getByText('Admin Metrics')).toBeInTheDocument();
      });
    });

    it('chart API failure does not crash page', async () => {
      const consoleSpy = vi.spyOn(console, 'error').mockImplementation(() => {});
      mockGetOverview.mockResolvedValue(makeOverviewResponse());
      mockGetChartData.mockRejectedValue(new Error('Chart data unavailable'));

      await act(async () => {
        render(<MetricsPage />);
      });

      await waitFor(() => {
        expect(screen.getByText('Users')).toBeInTheDocument();
      });

      consoleSpy.mockRestore();
    });
  });

  describe('time formatting', () => {
    beforeEach(() => {
      mockLoading = false;
      mockIsAuthenticated = true;
      mockUser = { id: 1, email: 'admin@test.com', name: 'Admin', role: 'admin' };
    });

    it('formats time correctly', async () => {
      await act(async () => {
        render(<MetricsPage />);
      });

      await waitFor(() => {
        // 7200 seconds = 2h 0m
        expect(screen.getByText('2h 0m')).toBeInTheDocument();
      });
    });
  });

  describe('initial data fetch', () => {
    beforeEach(() => {
      mockLoading = false;
      mockIsAuthenticated = true;
      mockUser = { id: 1, email: 'admin@test.com', name: 'Admin', role: 'admin' };
    });

    it('fetches overview data on mount', async () => {
      await act(async () => {
        render(<MetricsPage />);
      });

      await waitFor(() => {
        expect(mockGetOverview).toHaveBeenCalled();
      });
    });

    it('fetches chart data on mount', async () => {
      await act(async () => {
        render(<MetricsPage />);
      });

      await waitFor(() => {
        expect(mockGetChartData).toHaveBeenCalled();
      });
    });
  });
});
