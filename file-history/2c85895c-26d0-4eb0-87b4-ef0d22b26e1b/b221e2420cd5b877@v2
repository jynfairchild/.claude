# AstroTask Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env files with real secrets!

# =============================================================================
# DATABASE
# =============================================================================

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=MODE
# Local:  postgresql://postgres:yourpassword@localhost:5432/astrotask_db?sslmode=disable
# AWS:    postgresql://postgres:yourpassword@your-rds-endpoint.region.rds.amazonaws.com:5432/astrotask_db?sslmode=require
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/astrotask_db?sslmode=disable

# Password for PostgreSQL (used by docker-compose for the postgres container)
POSTGRES_PASSWORD=CHANGE_ME

# =============================================================================
# SECURITY
# =============================================================================

# JWT secret for signing tokens (64+ characters recommended)
# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Environment: "development" or "production"
# In production, JWT_SECRET is required (no fallback)
ENVIRONMENT=development

# =============================================================================
# URLS & CORS
# =============================================================================

# Frontend URL (used in email links)
# Local:      http://localhost:3000
# Production: https://astrotask.io
FRONTEND_URL=http://localhost:3000

# CORS allowed origins (comma-separated for multiple)
# Must include your frontend URL
CORS_ORIGINS=http://localhost:3000

# =============================================================================
# EMAIL (Resend)
# =============================================================================

# Resend API key for sending emails
# Get one at: https://resend.com/api-keys
# If not set, emails will be logged to console instead
RESEND_API_KEY=re_YOUR_API_KEY

# From email address for outgoing emails
EMAIL_FROM=noreply@astrotask.io

# =============================================================================
# AUTHENTICATION
# =============================================================================

# Admin email for bootstrap invite (sent when no users exist)
ADMIN_EMAIL=your-email@example.com

# Require invitation to sign up (true/false)
REQUIRE_INVITE=true

# =============================================================================
# COOKIES (Production)
# =============================================================================

# Enable secure cookies (HTTPS only) - set to "true" in production
SECURE_COOKIES=false

# Cookie SameSite attribute: Lax, Strict, or None
COOKIE_SAMESITE=Lax

# Cookie domain (optional, for subdomains)
# COOKIE_DOMAIN=.astrotask.io

# =============================================================================
# SERVER
# =============================================================================

# Backend server port
PORT=8080

# =============================================================================
# TOKEN TTL (Optional - defaults shown)
# =============================================================================

# ACCESS_TOKEN_TTL=45m
# REFRESH_TOKEN_TTL=720h
# EMAIL_VERIFY_TTL=48h
# PASSWORD_RESET_TTL=1h
# INVITATION_TTL=168h
