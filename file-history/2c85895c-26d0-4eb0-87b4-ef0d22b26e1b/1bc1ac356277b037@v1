## Backend Implementation

### 1. New Handler Method
**File:** `backend/internal/handlers/auth.go`

Add `DeleteUserData` method to AuthHandler:

```go
// DELETE /auth/data - Delete all user data but keep account
func (h *AuthHandler) DeleteUserData(c *gin.Context) {
    userID := c.GetUint("userID")
    if userID == 0 {
        c.JSON(http.StatusUnauthorized, gin.H{"error": "Unauthorized"})
        return
    }

    var req struct {
        Password string `json:"password" binding:"required"`
    }
    if err := c.ShouldBindJSON(&req); err != nil {
        c.JSON(http.StatusBadRequest, gin.H{"error": "Password required"})
        return
    }

    // Verify password
    var user models.User
    if err := h.db.First(&user, userID).Error; err != nil {
        c.JSON(http.StatusUnauthorized, gin.H{"error": "User not found"})
        return
    }
    if err := bcrypt.CompareHashAndPassword([]byte(user.PasswordHash), []byte(req.Password)); err != nil {
        c.JSON(http.StatusUnauthorized, gin.H{"error": "Invalid password"})
        return
    }

    // Transaction: delete all user data
    if err := h.db.Transaction(func(tx *gorm.DB) error {
        // 1. Delete tokens (no cascade)
        if err := tx.Where("user_id = ?", userID).Delete(&models.RefreshToken{}).Error; err != nil {
            return err
        }
        if err := tx.Where("user_id = ?", userID).Delete(&models.PasswordResetToken{}).Error; err != nil {
            return err
        }
        if err := tx.Where("user_id = ?", userID).Delete(&models.EmailVerificationToken{}).Error; err != nil {
            return err
        }

        // 2. Delete invitations created by user
        if err := tx.Where("invited_by_id = ?", userID).Delete(&models.Invitation{}).Error; err != nil {
            return err
        }

        // 3. Delete tasks (sessions cascade automatically)
        if err := tx.Unscoped().Where("user_id = ?", userID).Delete(&models.Task{}).Error; err != nil {
            return err
        }

        // 4. Delete projects
        if err := tx.Unscoped().Where("user_id = ?", userID).Delete(&models.Project{}).Error; err != nil {
            return err
        }

        // 5. Delete user columns
        if err := tx.Where("user_id = ?", userID).Delete(&models.UserColumn{}).Error; err != nil {
            return err
        }

        // 6. Reset user preferences
        if err := tx.Model(&models.User{}).Where("id = ?", userID).
            Updates(map[string]interface{}{
                "actionbar":     pq.StringArray{},
                "last_login_at": nil,
            }).Error; err != nil {
            return err
        }

        return nil
    }); err != nil {
        c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to delete user data"})
        return
    }

    c.JSON(http.StatusOK, gin.H{"message": "All user data deleted successfully"})
}
```

