package handlers

import (
    "net/http"
    "strconv"

    "github.com/gin-gonic/gin"
    "gorm.io/gorm"
    "simple_task_tracker/backend/internal/models"
)

type ColumnHandler struct {
    db *gorm.DB
}

func NewColumnHandler(db *gorm.DB) *ColumnHandler { return &ColumnHandler{db: db} }

// List user columns (dev: user_id=1) and seed defaults if none
func (h *ColumnHandler) List(c *gin.Context) {
    userID := c.GetUint("userID")
    if userID == 0 { c.JSON(http.StatusUnauthorized, gin.H{"error": "Unauthorized"}); return }
    var cols []models.UserColumn
    project := c.Query("project")
    q := h.db.Where("user_id = ?", userID)
    if project != "" { q = q.Where("project = ?", project) } else { q = q.Where("project = ''") }
    if err := q.Order("col_index ASC").Find(&cols).Error; err != nil {
        c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to fetch columns"})
        return
    }
    if len(cols) == 0 {
        // seed defaults 0: Todo, 1: In Progress
        defaults := []models.UserColumn{
            {UserID: userID, Project: project, ColIndex: 0, Name: "Todo"},
            {UserID: userID, Project: project, ColIndex: 1, Name: "In Progress"},
        }
        if err := h.db.Create(&defaults).Error; err == nil {
            cols = defaults
        }
    }
    c.JSON(http.StatusOK, cols)
}

type createColumnReq struct {
    Project  string `json:"project,omitempty"`
    ColIndex int    `json:"col_index"`
    Name     string `json:"name"`
}

func (h *ColumnHandler) Create(c *gin.Context) {
    userID := c.GetUint("userID")
    if userID == 0 { c.JSON(http.StatusUnauthorized, gin.H{"error": "Unauthorized"}); return }
    var req createColumnReq
    if err := c.ShouldBindJSON(&req); err != nil || req.Name == "" {
        c.JSON(http.StatusBadRequest, gin.H{"error": "Invalid payload"})
        return
    }
    col := models.UserColumn{UserID: userID, Project: req.Project, ColIndex: req.ColIndex, Name: req.Name}
    if err := h.db.Create(&col).Error; err != nil {
        c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to create column"})
        return
    }
    c.JSON(http.StatusCreated, col)
}

type updateColumnReq struct {
    Name     *string `json:"name,omitempty"`
    ColIndex *int    `json:"col_index,omitempty"`
}

func (h *ColumnHandler) Update(c *gin.Context) {
    userID := c.GetUint("userID")
    if userID == 0 { c.JSON(http.StatusUnauthorized, gin.H{"error": "Unauthorized"}); return }
    id, err := strconv.Atoi(c.Param("id"))
    if err != nil { c.JSON(http.StatusBadRequest, gin.H{"error": "Invalid id"}); return }
    var req updateColumnReq
    if err := c.ShouldBindJSON(&req); err != nil { c.JSON(http.StatusBadRequest, gin.H{"error": "Invalid payload"}); return }
    var col models.UserColumn
    if err := h.db.Where("id = ? AND user_id = ?", id, userID).First(&col).Error; err != nil {
        if err == gorm.ErrRecordNotFound { c.JSON(http.StatusNotFound, gin.H{"error": "Not found"}); return }
        c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to fetch column"}); return
    }
    if req.Name != nil { col.Name = *req.Name }
    if req.ColIndex != nil { col.ColIndex = *req.ColIndex }
    if err := h.db.Save(&col).Error; err != nil {
        c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to update column"}); return
    }
    c.JSON(http.StatusOK, col)
}

func (h *ColumnHandler) Delete(c *gin.Context) {
    userID := c.GetUint("userID")
    if userID == 0 { c.JSON(http.StatusUnauthorized, gin.H{"error": "Unauthorized"}); return }
    id, err := strconv.Atoi(c.Param("id"))
    if err != nil { c.JSON(http.StatusBadRequest, gin.H{"error": "Invalid id"}); return }
    // Fetch column to know user and index
    var col models.UserColumn
    if err := h.db.Where("id = ? AND user_id = ?", id, userID).First(&col).Error; err != nil {
        if err == gorm.ErrRecordNotFound { c.JSON(http.StatusNotFound, gin.H{"error": "Not found"}); return }
        c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to fetch column"}); return
    }
    // Prevent deleting the last remaining column for this user+project
    var total int64
    if err := h.db.Model(&models.UserColumn{}).
        Where("user_id = ? AND project = ?", col.UserID, col.Project).
        Count(&total).Error; err != nil {
        c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to check column count"}); return
    }
    if total <= 1 {
        c.JSON(http.StatusBadRequest, gin.H{"error": "You can't delete the last column, add a new column, and then deleting this column will be possible"})
        return
    }

    // Delete tasks in this column, delete the column, then shift remaining columns/tasks down
    deletedIndex := col.ColIndex
    if err := h.db.Transaction(func(tx *gorm.DB) error {
        // Delete tasks in the deleted column
        if err := tx.Where("user_id = ? AND column_index = ?", col.UserID, deletedIndex).Delete(&models.Task{}).Error; err != nil {
            return err
        }
        // Delete the column
        if err := tx.Delete(&models.UserColumn{}, id).Error; err != nil {
            return err
        }
        // Shift columns after the deleted one down by 1
        if err := tx.Model(&models.UserColumn{}).
            Where("user_id = ? AND project = ? AND col_index > ?", col.UserID, col.Project, deletedIndex).
            Update("col_index", gorm.Expr("col_index - 1")).Error; err != nil {
            return err
        }
        // Shift tasks after the deleted column down by 1
        if err := tx.Model(&models.Task{}).
            Where("user_id = ? AND column_index > ?", col.UserID, deletedIndex).
            Update("column_index", gorm.Expr("column_index - 1")).Error; err != nil {
            return err
        }
        return nil
    }); err != nil {
        c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to delete column and tasks"}); return
    }
    c.JSON(http.StatusOK, gin.H{"deleted": id, "col_index": deletedIndex})
}
