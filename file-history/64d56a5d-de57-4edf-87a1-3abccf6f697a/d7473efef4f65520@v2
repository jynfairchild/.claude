package models

import (
    "time"

    "github.com/lib/pq"
)

type User struct {
    ID              uint       `json:"id" gorm:"primaryKey"`
    Email           string     `json:"email" gorm:"unique;not null" validate:"required,email"`
    Name            string     `json:"name" gorm:"not null" validate:"required,min=1,max=120"`
    PasswordHash    string     `json:"-" gorm:"column:password_hash"`
    EmailVerifiedAt *time.Time `json:"email_verified_at,omitempty"`
    Role            string     `json:"role,omitempty" gorm:"default:user"` // allowed: user, admin
    Plan            string     `json:"plan,omitempty" gorm:"default:normal"` // allowed: normal, pro, vip
    LastLoginAt     *time.Time     `json:"last_login_at,omitempty"`
    Actionbar       pq.StringArray `json:"actionbar,omitempty" gorm:"type:text[]"`
    CreatedAt       time.Time      `json:"created_at"`
    UpdatedAt       time.Time      `json:"updated_at"`

    Projects []Project `json:"projects,omitempty" gorm:"foreignKey:UserID"`
    Tasks    []Task    `json:"tasks,omitempty" gorm:"foreignKey:UserID"`
}
