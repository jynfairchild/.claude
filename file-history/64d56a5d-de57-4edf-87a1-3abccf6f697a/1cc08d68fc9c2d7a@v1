        t.Fatalf("expected defaults for project ProjA, got %+v", cols)
    }
}

func TestColumns_Delete_CascadesTasksForThatUserAndIndex(t *testing.T) {
    db := setupTestDB(t)
    ensureColumnsMigrated(t, db)
    h := NewColumnHandler(db)
    r, w := setupColumnRouter(h)

    // Seed tasks for user 1 in col 2 (to be deleted)
    mkTask := func(user uint, idx int) models.Task {
        tsk := models.Task{UserID: user, Title: "T", ColumnIndex: idx, Status: "uncompleted", Position: 0, StartTime: time.Now()}
        if err := db.Create(&tsk).Error; err != nil { t.Fatalf("insert task: %v", err) }
        return tsk
    }
    _ = mkTask(1, 2)
    _ = mkTask(1, 2)
    _ = mkTask(1, 2)
    // Other columns for same user should remain
    other1 := mkTask(1, 1)
    other2 := mkTask(1, 1)
    // Different user same col index should remain
    _ = mkTask(2, 2)

    // Create a column record for user 1, col_index 2 and another to keep
    w = httptest.NewRecorder()
    reqC := httptest.NewRequest(http.MethodPost, "/api/v1/columns", bytes.NewBufferString(`{"name":"Col2","col_index":2}`))
    reqC.Header.Set("Content-Type", "application/json")
    r.ServeHTTP(w, reqC)
    if w.Code != http.StatusCreated { t.Fatalf("create column failed: %d %s", w.Code, w.Body.String()) }
    var col models.UserColumn
    _ = json.Unmarshal(w.Body.Bytes(), &col)

    // Second column to keep so deletion is permitted
    w = httptest.NewRecorder()
    reqKeep := httptest.NewRequest(http.MethodPost, "/api/v1/columns", bytes.NewBufferString(`{"name":"Keep","col_index":9}`))
    reqKeep.Header.Set("Content-Type", "application/json")
    r.ServeHTTP(w, reqKeep)
    if w.Code != http.StatusCreated { t.Fatalf("create keep failed: %d %s", w.Code, w.Body.String()) }

    // Delete column -> should delete tasks of user 1 in col 2
    w = httptest.NewRecorder()
    reqD := httptest.NewRequest(http.MethodDelete, "/api/v1/columns/"+strconv.Itoa(int(col.ID)), nil)
    r.ServeHTTP(w, reqD)
    if w.Code != http.StatusOK { t.Fatalf("delete failed: %d %s", w.Code, w.Body.String()) }

    // Verify: tasks for user 1 col 2 gone
    var remain []models.Task
    if err := db.Where("user_id = ? AND column_index = ?", 1, 2).Find(&remain).Error; err != nil { t.Fatal(err) }
    if len(remain) != 0 { t.Fatalf("expected 0 tasks in user 1 col 2, got %d", len(remain)) }

    // Verify: tasks in other column for same user still exist
    var still []models.Task
    if err := db.Where("id IN ?", []uint{other1.ID, other2.ID}).Find(&still).Error; err != nil { t.Fatal(err) }
    if len(still) != 2 { t.Fatalf("expected other column tasks to remain, found %d", len(still)) }

    // Verify: tasks for other user same col remain
    var otherUser []models.Task
    if err := db.Where("user_id = ? AND column_index = ?", 2, 2).Find(&otherUser).Error; err != nil { t.Fatal(err) }
    if len(otherUser) != 1 { t.Fatalf("expected other user tasks untouched, got %d", len(otherUser)) }
}

