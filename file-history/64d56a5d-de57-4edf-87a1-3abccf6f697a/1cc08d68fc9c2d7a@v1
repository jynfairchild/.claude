    w = httptest.NewRecorder()
    req = httptest.NewRequest(http.MethodGet, "/api/v1/columns?project=ProjA", nil)
    r.ServeHTTP(w, req)
    if w.Code != http.StatusOK { t.Fatalf("expected 200, got %d", w.Code) }
