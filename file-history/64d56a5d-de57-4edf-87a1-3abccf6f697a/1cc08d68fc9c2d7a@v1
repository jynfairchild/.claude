func TestColumns_Delete_PreventDeletingLastColumn(t *testing.T) {
    db := setupTestDB(t)
    ensureColumnsMigrated(t, db)
    h := NewColumnHandler(db)
    r, w := setupColumnRouter(h)

    // Create two columns for user 1
    w = httptest.NewRecorder()
    reqC1 := httptest.NewRequest(http.MethodPost, "/api/v1/columns", bytes.NewBufferString(`{"name":"A","col_index":0}`))
    reqC1.Header.Set("Content-Type", "application/json")
    r.ServeHTTP(w, reqC1)
    if w.Code != http.StatusCreated { t.Fatalf("create A failed: %d %s", w.Code, w.Body.String()) }
    var a models.UserColumn
    _ = json.Unmarshal(w.Body.Bytes(), &a)

    w = httptest.NewRecorder()
    reqC2 := httptest.NewRequest(http.MethodPost, "/api/v1/columns", bytes.NewBufferString(`{"name":"B","col_index":1}`))
    reqC2.Header.Set("Content-Type", "application/json")
    r.ServeHTTP(w, reqC2)
    if w.Code != http.StatusCreated { t.Fatalf("create B failed: %d %s", w.Code, w.Body.String()) }
    var b models.UserColumn
    _ = json.Unmarshal(w.Body.Bytes(), &b)

    // Delete one column (B)
    w = httptest.NewRecorder()
    reqD1 := httptest.NewRequest(http.MethodDelete, "/api/v1/columns/"+strconv.Itoa(int(b.ID)), nil)
    r.ServeHTTP(w, reqD1)
    if w.Code != http.StatusOK { t.Fatalf("delete B failed: %d %s", w.Code, w.Body.String()) }

    // Attempt to delete the last remaining column (A) -> expect 400
    w = httptest.NewRecorder()
    reqD2 := httptest.NewRequest(http.MethodDelete, "/api/v1/columns/"+strconv.Itoa(int(a.ID)), nil)
    r.ServeHTTP(w, reqD2)
    if w.Code != http.StatusBadRequest {
        t.Fatalf("expected 400 preventing last column deletion, got %d: %s", w.Code, w.Body.String())
    }
}

func TestColumns_Delete_ShiftsRemainingColumnsAndTasks(t *testing.T) {
    db := setupTestDB(t)
    ensureColumnsMigrated(t, db)
    h := NewColumnHandler(db)
    r, w := setupColumnRouter(h)

    // Create 4 columns: 0, 1, 2, 3
    createCol := func(name string, idx int) models.UserColumn {
        w = httptest.NewRecorder()
        payload := `{"name":"` + name + `","col_index":` + strconv.Itoa(idx) + `}`
        req := httptest.NewRequest(http.MethodPost, "/api/v1/columns", bytes.NewBufferString(payload))
        req.Header.Set("Content-Type", "application/json")
        r.ServeHTTP(w, req)
        if w.Code != http.StatusCreated {
            t.Fatalf("create %s failed: %d %s", name, w.Code, w.Body.String())
        }
        var col models.UserColumn
        _ = json.Unmarshal(w.Body.Bytes(), &col)
        return col
    }

    col0 := createCol("Col0", 0)
    col1 := createCol("Col1", 1) // Will be deleted
    col2 := createCol("Col2", 2)
    col3 := createCol("Col3", 3)

    // Create tasks in each column
    mkTask := func(colIdx int, title string) models.Task {
        tsk := models.Task{UserID: 1, Title: title, ColumnIndex: colIdx, Status: "uncompleted", Position: 0, StartTime: time.Now()}
        if err := db.Create(&tsk).Error; err != nil {
            t.Fatalf("insert task: %v", err)
        }
        return tsk
    }

    task0 := mkTask(0, "Task in Col0")
    _      = mkTask(1, "Task in Col1") // Will be deleted with column
    task2 := mkTask(2, "Task in Col2")
    task3 := mkTask(3, "Task in Col3")

    // Delete column 1 (middle column)
    w = httptest.NewRecorder()
    reqD := httptest.NewRequest(http.MethodDelete, "/api/v1/columns/"+strconv.Itoa(int(col1.ID)), nil)
    r.ServeHTTP(w, reqD)
    if w.Code != http.StatusOK {
        t.Fatalf("delete failed: %d %s", w.Code, w.Body.String())
    }

    // Verify columns shifted: col2 -> 1, col3 -> 2
    var updatedCol0, updatedCol2, updatedCol3 models.UserColumn
    if err := db.First(&updatedCol0, col0.ID).Error; err != nil {
        t.Fatalf("col0 not found: %v", err)
    }
    if updatedCol0.ColIndex != 0 {
        t.Fatalf("col0 should still be at index 0, got %d", updatedCol0.ColIndex)
    }

    if err := db.First(&updatedCol2, col2.ID).Error; err != nil {
        t.Fatalf("col2 not found: %v", err)
    }
    if updatedCol2.ColIndex != 1 {
        t.Fatalf("col2 should have shifted to index 1, got %d", updatedCol2.ColIndex)
    }

    if err := db.First(&updatedCol3, col3.ID).Error; err != nil {
        t.Fatalf("col3 not found: %v", err)
    }
    if updatedCol3.ColIndex != 2 {
        t.Fatalf("col3 should have shifted to index 2, got %d", updatedCol3.ColIndex)
    }

    // Verify tasks shifted: task2 -> col 1, task3 -> col 2
    var updatedTask0, updatedTask2, updatedTask3 models.Task
    if err := db.First(&updatedTask0, task0.ID).Error; err != nil {
        t.Fatalf("task0 not found: %v", err)
    }
    if updatedTask0.ColumnIndex != 0 {
        t.Fatalf("task0 should still be in col 0, got %d", updatedTask0.ColumnIndex)
    }

    if err := db.First(&updatedTask2, task2.ID).Error; err != nil {
        t.Fatalf("task2 not found: %v", err)
    }
    if updatedTask2.ColumnIndex != 1 {
        t.Fatalf("task2 should have shifted to col 1, got %d", updatedTask2.ColumnIndex)
    }

    if err := db.First(&updatedTask3, task3.ID).Error; err != nil {
        t.Fatalf("task3 not found: %v", err)
    }
    if updatedTask3.ColumnIndex != 2 {
        t.Fatalf("task3 should have shifted to col 2, got %d", updatedTask3.ColumnIndex)
    }

    // Verify column 1's task was deleted
    var deletedTasks []models.Task
    if err := db.Where("title = ?", "Task in Col1").Find(&deletedTasks).Error; err != nil {
        t.Fatalf("query failed: %v", err)
    }
    if len(deletedTasks) != 0 {
        t.Fatalf("task in deleted column should be gone, found %d", len(deletedTasks))
    }
}
