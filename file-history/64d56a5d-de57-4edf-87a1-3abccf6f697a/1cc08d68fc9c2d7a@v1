func setupColumnRouter(h *ColumnHandler) (*gin.Engine, *httptest.ResponseRecorder) {
    gin.SetMode(gin.TestMode)
    r := gin.New()
    r.Use(gin.Recovery())
    // Simulate auth middleware for tests: userID=1
    r.Use(func(c *gin.Context) { c.Set("userID", uint(1)); c.Next() })
    r.GET("/api/v1/columns", h.List)
    r.POST("/api/v1/columns", h.Create)
    r.PATCH("/api/v1/columns/:id", h.Update)
    r.DELETE("/api/v1/columns/:id", h.Delete)
    return r, httptest.NewRecorder()
}

// ensureColumnsMigrated extends the shared test DB with the user_columns table
func ensureColumnsMigrated(t *testing.T, db *gorm.DB) {
    t.Helper()
    if err := db.AutoMigrate(&models.UserColumn{}); err != nil {
        t.Fatalf("failed to migrate user_columns: %v", err)
    }
}

func TestColumns_List_SeedsDefaultsWhenEmpty(t *testing.T) {
    db := setupTestDB(t)
    ensureColumnsMigrated(t, db)
    h := NewColumnHandler(db)
    r, w := setupColumnRouter(h)

    req := httptest.NewRequest(http.MethodGet, "/api/v1/columns", nil)
    r.ServeHTTP(w, req)
    if w.Code != http.StatusOK {
        t.Fatalf("expected 200, got %d: %s", w.Code, w.Body.String())
    }
    var cols []models.UserColumn
    if err := json.Unmarshal(w.Body.Bytes(), &cols); err != nil {
        t.Fatalf("invalid JSON: %v", err)
    }
    if len(cols) != 2 {
        t.Fatalf("expected 2 default columns, got %d", len(cols))
    }
    if cols[0].ColIndex != 0 || cols[0].Name != "Todo" || cols[1].ColIndex != 1 || cols[1].Name != "In Progress" {
        t.Fatalf("unexpected defaults: %+v", cols)
    }
}

func TestColumns_Create_AddsNewColumn(t *testing.T) {
    db := setupTestDB(t)
    ensureColumnsMigrated(t, db)
    h := NewColumnHandler(db)
    r, w := setupColumnRouter(h)

    payload := map[string]any{"name": "Review", "col_index": 2}
    bts, _ := json.Marshal(payload)
    req := httptest.NewRequest(http.MethodPost, "/api/v1/columns", bytes.NewReader(bts))
    req.Header.Set("Content-Type", "application/json")
    r.ServeHTTP(w, req)

    if w.Code != http.StatusCreated {
        t.Fatalf("expected 201, got %d: %s", w.Code, w.Body.String())
    }
    var col models.UserColumn
    if err := json.Unmarshal(w.Body.Bytes(), &col); err != nil {
        t.Fatalf("invalid JSON: %v", err)
    }
    if col.ID == 0 || col.UserID != 1 || col.Name != "Review" || col.ColIndex != 2 {
        t.Fatalf("unexpected created column: %+v", col)
    }
}

func TestColumns_Update_RenameAndReindex(t *testing.T) {
    db := setupTestDB(t)
    ensureColumnsMigrated(t, db)
    h := NewColumnHandler(db)
    r, w := setupColumnRouter(h)

    // Create initial column
    w = httptest.NewRecorder()
    reqC := httptest.NewRequest(http.MethodPost, "/api/v1/columns", bytes.NewBufferString(`{"name":"Backlog","col_index":0}`))
    reqC.Header.Set("Content-Type", "application/json")
    r.ServeHTTP(w, reqC)
    if w.Code != http.StatusCreated { t.Fatalf("create failed: %d %s", w.Code, w.Body.String()) }
    var created models.UserColumn
    _ = json.Unmarshal(w.Body.Bytes(), &created)

    // Update
    w = httptest.NewRecorder()
    upd := map[string]any{"name": "QA", "col_index": 3}
    bts, _ := json.Marshal(upd)
    req := httptest.NewRequest(http.MethodPatch, "/api/v1/columns/"+strconv.Itoa(int(created.ID)), bytes.NewReader(bts))
    req.Header.Set("Content-Type", "application/json")
    r.ServeHTTP(w, req)

    if w.Code != http.StatusOK {
        t.Fatalf("expected 200, got %d: %s", w.Code, w.Body.String())
    }
    var updated models.UserColumn
    _ = json.Unmarshal(w.Body.Bytes(), &updated)
    if updated.Name != "QA" || updated.ColIndex != 3 {
        t.Fatalf("expected renamed/reindexed column, got %+v", updated)
    }
}

func TestColumns_Delete_RemovesRow(t *testing.T) {
    db := setupTestDB(t)
    ensureColumnsMigrated(t, db)
    h := NewColumnHandler(db)
    r, w := setupColumnRouter(h)

    // Create two columns so deletion is allowed (cannot delete last column)
    w = httptest.NewRecorder()
    reqC := httptest.NewRequest(http.MethodPost, "/api/v1/columns", bytes.NewBufferString(`{"name":"X","col_index":5}`))
    reqC.Header.Set("Content-Type", "application/json")
    r.ServeHTTP(w, reqC)
    if w.Code != http.StatusCreated { t.Fatalf("create failed: %d %s", w.Code, w.Body.String()) }
    var created models.UserColumn
    _ = json.Unmarshal(w.Body.Bytes(), &created)

    // Second column to keep
    w = httptest.NewRecorder()
    reqC2 := httptest.NewRequest(http.MethodPost, "/api/v1/columns", bytes.NewBufferString(`{"name":"Keep","col_index":6}`))
    reqC2.Header.Set("Content-Type", "application/json")
    r.ServeHTTP(w, reqC2)
    if w.Code != http.StatusCreated { t.Fatalf("create 2 failed: %d %s", w.Code, w.Body.String()) }

    w = httptest.NewRecorder()
    req := httptest.NewRequest(http.MethodDelete, "/api/v1/columns/"+strconv.Itoa(int(created.ID)), nil)
    r.ServeHTTP(w, req)
    if w.Code != http.StatusOK {
        t.Fatalf("expected 200, got %d: %s", w.Code, w.Body.String())
    }
    // Verify not found
    var row models.UserColumn
    if err := db.First(&row, created.ID).Error; err == nil {
        t.Fatalf("expected row deleted, still found: %+v", row)
    }
}

func TestColumns_List_ProjectFilter_IsolatedDefaults(t *testing.T) {
    db := setupTestDB(t)
    ensureColumnsMigrated(t, db)
    h := NewColumnHandler(db)
    r, w := setupColumnRouter(h)

    // Seed defaults for blank project
    req := httptest.NewRequest(http.MethodGet, "/api/v1/columns", nil)
    r.ServeHTTP(w, req)
    if w.Code != http.StatusOK { t.Fatalf("expected 200, got %d", w.Code) }

