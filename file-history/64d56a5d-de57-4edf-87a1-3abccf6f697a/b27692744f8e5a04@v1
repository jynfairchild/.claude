func TestResetPassword_UpdatesHash_RevokesTokens(t *testing.T) {
    db := setupAuthTestDB(t)
    h := NewAuthHandler(db)
    r, w := setupAuthRouter(h)

    // Seed user with known password
    oldHash, _ := a.HashPassword("oldpass123")
    u := models.User{Email: "rs@ex.com", Name: "RS", PasswordHash: oldHash}
    if err := db.Create(&u).Error; err != nil { t.Fatal(err) }
    // Seed refresh tokens
    _, _, _ = a.CreateRefreshToken(db, u.ID, "ua1", "ip1")
    _, _, _ = a.CreateRefreshToken(db, u.ID, "ua2", "ip2")

    // Create reset token
    token, _, err := a.CreatePasswordResetToken(db, u.ID)
    if err != nil { t.Fatal(err) }

    // Reset
    body := bytes.NewBufferString(`{"token":"` + token + `","new_password":"newpass789"}`)
    req := httptest.NewRequest(http.MethodPost, "/api/v1/auth/reset-password", body)
    req.Header.Set("Content-Type", "application/json")
    r.ServeHTTP(w, req)
    if w.Code != http.StatusOK { t.Fatalf("reset: %d %s", w.Code, w.Body.String()) }

    // Password updated
    var got models.User
    if err := db.First(&got, u.ID).Error; err != nil { t.Fatal(err) }
    okOld, _, _ := a.VerifyAndMaybeRehash(got.PasswordHash, "oldpass123")
    okNew, _, _ := a.VerifyAndMaybeRehash(got.PasswordHash, "newpass789")
    if okOld || !okNew { t.Fatalf("password not updated correctly") }

    // Tokens revoked
    var cnt int64
    if err := db.Model(&models.RefreshToken{}).Where("user_id = ? AND revoked_at IS NOT NULL", u.ID).Count(&cnt).Error; err != nil { t.Fatal(err) }
    if cnt != 2 { t.Fatalf("expected 2 revoked tokens, got %d", cnt) }
}

func TestChangePassword_Protected_AndRevokesTokens(t *testing.T) {
    db := setupAuthTestDB(t)
    h := NewAuthHandler(db)
    r, w := setupAuthRouter(h)

    // Seed user and tokens
    oldHash, _ := a.HashPassword("oldpass123")
    u := models.User{Email: "cp@ex.com", Name: "CP", PasswordHash: oldHash}
    if err := db.Create(&u).Error; err != nil { t.Fatal(err) }
    // One token
    _, _, _ = a.CreateRefreshToken(db, u.ID, "ua", "ip")

    _ = os.Setenv("JWT_SECRET", "test-secret")
    access, err := a.GenerateToken(u.ID, u.Email, u.Name)
    if err != nil { t.Fatal(err) }

    body := bytes.NewBufferString(`{"current_password":"oldpass123","new_password":"newpass456"}`)
    req := httptest.NewRequest(http.MethodPost, "/api/v1/auth/change-password", body)
    req.Header.Set("Content-Type", "application/json")
    req.Header.Set("Authorization", "Bearer "+access)
    r.ServeHTTP(w, req)
    if w.Code != http.StatusOK { t.Fatalf("change password: %d %s", w.Code, w.Body.String()) }

    var got models.User
    if err := db.First(&got, u.ID).Error; err != nil { t.Fatal(err) }
    okNew, _, _ := a.VerifyAndMaybeRehash(got.PasswordHash, "newpass456")
    if !okNew { t.Fatalf("expected new password to be valid") }

    // Tokens revoked
    var cnt int64
    if err := db.Model(&models.RefreshToken{}).Where("user_id = ? AND revoked_at IS NOT NULL", u.ID).Count(&cnt).Error; err != nil { t.Fatal(err) }
    if cnt != 1 { t.Fatalf("expected 1 revoked token, got %d", cnt) }
}
