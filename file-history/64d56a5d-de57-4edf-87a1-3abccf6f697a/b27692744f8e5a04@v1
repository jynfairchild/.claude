// setupAuthTestDB creates an in-memory DB with auth-related tables.
func setupAuthTestDB(t *testing.T) *gorm.DB {
    t.Helper()
    glogger := gormlogger.New(
        stdlog.New(testWriter{t}, "", 0),
        gormlogger.Config{
            SlowThreshold:             0,
            LogLevel:                  gormlogger.Warn,
            IgnoreRecordNotFoundError: true,
            Colorful:                  false,
        },
    )
    db, err := gorm.Open(sqlite.Open(":memory:"), &gorm.Config{ Logger: glogger })
    if err != nil {
        t.Fatalf("failed to open sqlite: %v", err)
    }
    if err := db.AutoMigrate(&models.User{}, &models.RefreshToken{}, &models.EmailVerificationToken{}, &models.PasswordResetToken{}); err != nil {
        t.Fatalf("failed to migrate: %v", err)
    }
    return db
}

// Reuse testWriter from sessions_test.go

func setupAuthRouter(h *AuthHandler) (*gin.Engine, *httptest.ResponseRecorder) {
    gin.SetMode(gin.TestMode)
    r := gin.New()
    r.Use(gin.Recovery())
    api := r.Group("/api/v1")
    api.POST("/auth/signup", h.Signup)
    api.POST("/auth/login", h.Login)
    api.POST("/auth/refresh", h.Refresh)
    api.POST("/auth/logout", h.Logout)
    api.POST("/auth/verify-email", h.VerifyEmail)
    api.POST("/auth/request-password-reset", h.RequestPasswordReset)
    api.POST("/auth/reset-password", h.ResetPassword)

    // Protected routes
    protected := api.Group("/")
    protected.Use(middleware.AuthMiddleware())
    protected.POST("/auth/logout-all", h.LogoutAll)
    protected.POST("/auth/change-password", h.ChangePassword)
    protected.GET("/auth/profile", h.GetProfile)
    protected.PATCH("/auth/profile", h.UpdateProfile)

    return r, httptest.NewRecorder()
}

func TestSignup_CreatesUser_AndReturnsTokens(t *testing.T) {
    db := setupAuthTestDB(t)
    h := NewAuthHandler(db)
    r, w := setupAuthRouter(h)

    body := bytes.NewBufferString(`{"email":"new@ex.com","password":"password123","name":"New User"}`)
    req := httptest.NewRequest(http.MethodPost, "/api/v1/auth/signup", body)
    req.Header.Set("Content-Type", "application/json")
    r.ServeHTTP(w, req)

    if w.Code != http.StatusCreated {
        t.Fatalf("expected 201, got %d: %s", w.Code, w.Body.String())
    }

    var resp map[string]any
    if err := json.Unmarshal(w.Body.Bytes(), &resp); err != nil {
        t.Fatalf("invalid JSON: %v", err)
    }
    if resp["token"] == nil || resp["refresh_token"] == nil {
        t.Fatalf("expected token and refresh_token in response")
    }

    // Verify user persisted with Argon2id hash
    var u models.User
    if err := db.Where("email = ?", "new@ex.com").First(&u).Error; err != nil {
        t.Fatalf("user not found: %v", err)
    }
    if len(u.PasswordHash) == 0 || u.PasswordHash[:9] != "$argon2id" {
        t.Fatalf("expected argon2id hash, got %q", u.PasswordHash)
    }
}

