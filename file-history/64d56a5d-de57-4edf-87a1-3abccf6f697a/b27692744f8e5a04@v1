func TestLogin_WithBcrypt_RehashesToArgon2(t *testing.T) {
    db := setupAuthTestDB(t)
    // Seed user with bcrypt hash for password "secret"
    b, _ := bcrypt.GenerateFromPassword([]byte("secret"), bcrypt.DefaultCost)
    u := models.User{Email: "login@ex.com", Name: "Login User", PasswordHash: string(b)}
    if err := db.Create(&u).Error; err != nil { t.Fatal(err) }

    h := NewAuthHandler(db)
    r, w := setupAuthRouter(h)

    body := bytes.NewBufferString(`{"email":"login@ex.com","password":"secret"}`)
    req := httptest.NewRequest(http.MethodPost, "/api/v1/auth/login", body)
    req.Header.Set("Content-Type", "application/json")
    r.ServeHTTP(w, req)

    if w.Code != http.StatusOK {
        t.Fatalf("expected 200, got %d: %s", w.Code, w.Body.String())
    }

    // Reload and ensure PasswordHash migrated to argon2id
    var got models.User
    if err := db.First(&got, u.ID).Error; err != nil { t.Fatal(err) }
    if len(got.PasswordHash) == 0 || got.PasswordHash[:9] != "$argon2id" {
        t.Fatalf("expected argon2id rehash, got %q", got.PasswordHash)
    }
}

func TestRefresh_Rotates_AndRevokesOld(t *testing.T) {
    db := setupAuthTestDB(t)
    h := NewAuthHandler(db)
    r, w := setupAuthRouter(h)

    // Signup to get initial refresh token
    sbody := bytes.NewBufferString(`{"email":"r@ex.com","password":"pass1234","name":"R U"}`)
    sreq := httptest.NewRequest(http.MethodPost, "/api/v1/auth/signup", sbody)
    sreq.Header.Set("Content-Type", "application/json")
    r.ServeHTTP(w, sreq)
    if w.Code != http.StatusCreated { t.Fatalf("signup: %d %s", w.Code, w.Body.String()) }
    var sresp map[string]any
    _ = json.Unmarshal(w.Body.Bytes(), &sresp)
    oldRefresh := sresp["refresh_token"].(string)

    // Refresh
    w = httptest.NewRecorder()
    rbody := bytes.NewBufferString(`{"refresh_token":"` + oldRefresh + `"}`)
    rreq := httptest.NewRequest(http.MethodPost, "/api/v1/auth/refresh", rbody)
    rreq.Header.Set("Content-Type", "application/json")
    r.ServeHTTP(w, rreq)
    if w.Code != http.StatusOK { t.Fatalf("refresh: %d %s", w.Code, w.Body.String()) }
    var rresp map[string]any
    _ = json.Unmarshal(w.Body.Bytes(), &rresp)
    newRefresh := rresp["refresh_token"].(string)

    // Old token should be revoked
    if _, err := a.FindValidRefreshToken(db, oldRefresh); err == nil {
        t.Fatalf("expected old refresh token to be invalid after rotation")
    }
    // New token should be valid
    if _, err := a.FindValidRefreshToken(db, newRefresh); err != nil {
        t.Fatalf("new refresh token should be valid: %v", err)
    }
}

func TestLogout_RevokesRefreshToken(t *testing.T) {
    db := setupAuthTestDB(t)
    h := NewAuthHandler(db)
    r, w := setupAuthRouter(h)

    // Create a user and a refresh token
    u := models.User{Email: "lo@ex.com", Name: "Lo", PasswordHash: "phc"}
    if err := db.Create(&u).Error; err != nil { t.Fatal(err) }
    plain, _, err := a.CreateRefreshToken(db, u.ID, "ua", "ip")
    if err != nil { t.Fatal(err) }

    // Logout
    body := bytes.NewBufferString(`{"refresh_token":"` + plain + `"}`)
    req := httptest.NewRequest(http.MethodPost, "/api/v1/auth/logout", body)
    req.Header.Set("Content-Type", "application/json")
    r.ServeHTTP(w, req)
    if w.Code != http.StatusOK { t.Fatalf("logout: %d %s", w.Code, w.Body.String()) }

    // Token should be invalid now
    if _, err := a.FindValidRefreshToken(db, plain); err == nil {
        t.Fatalf("expected refresh token to be revoked")
    }
}

func TestLogoutAll_RevokesAllForUser(t *testing.T) {
    db := setupAuthTestDB(t)
    h := NewAuthHandler(db)
    r, w := setupAuthRouter(h)

    // Seed user and tokens
    u := models.User{Email: "all@ex.com", Name: "All", PasswordHash: "phc"}
    if err := db.Create(&u).Error; err != nil { t.Fatal(err) }
    t1, _, _ := a.CreateRefreshToken(db, u.ID, "ua", "ip")
    t2, _, _ := a.CreateRefreshToken(db, u.ID, "ua2", "ip2")
    _ = t1; _ = t2

    // Protected endpoint requires a valid access token
    _ = os.Setenv("JWT_SECRET", "test-secret")
    access, err := a.GenerateToken(u.ID, u.Email, u.Name)
    if err != nil { t.Fatal(err) }

    req := httptest.NewRequest(http.MethodPost, "/api/v1/auth/logout-all", nil)
    req.Header.Set("Authorization", "Bearer "+access)
    r.ServeHTTP(w, req)
    if w.Code != http.StatusOK { t.Fatalf("logout-all: %d %s", w.Code, w.Body.String()) }

    // All tokens should be revoked
    var cnt int64
    if err := db.Model(&models.RefreshToken{}).Where("user_id = ? AND revoked_at IS NOT NULL", u.ID).Count(&cnt).Error; err != nil {
        t.Fatal(err)
    }
    if cnt != 2 {
        t.Fatalf("expected 2 revoked tokens, got %d", cnt)
    }
}

