'use client';

import React, { createContext, useContext, useState, useEffect, useCallback } from 'react';
import { Task, taskApi } from '@/services/api';
import { loadTimerState, validateTimerState, clearTimerState } from '@/utils/timerPersistence';
import { useAuth } from '@/contexts/AuthContext';
import { authLog, timerLog, moveLog } from '@/utils/debug';

export interface TaskContextType {
  activeTask: Task | null;
  tasks: Task[];
  isLoading: boolean;
  error: string | null;
  startTask: (title: string, project: string, tags: string[]) => Promise<Task>;
  updateTaskTimer: (duration: number, sessionDuration?: number) => Promise<void>;
  stopTask: (currentDuration?: number, sessionDuration?: number) => Promise<void>;
  resumeTask: (taskId: number) => Promise<void>;
  loadTasks: () => Promise<void>;
  loadActiveTask: () => Promise<Task | null>;
  moveTask: (taskId: number, columnIndex: number, position?: number) => Promise<void>;
  reorderTask: (taskId: number, newPosition: number) => Promise<void>;
  updateTask: (taskId: number, updates: { title?: string; project?: string; tags?: string[]; is_active?: boolean }) => Promise<void>;
  completeTask: (taskId: number) => Promise<void>;
  deleteTask: (taskId: number) => Promise<void>;
}

const TaskContext = createContext<TaskContextType | undefined>(undefined);

export function TaskProvider({ children }: { children: React.ReactNode }) {
  const { accessToken, refresh } = useAuth();
  const [activeTask, setActiveTask] = useState<Task | null>(null);
  const [tasks, setTasks] = useState<Task[]>([]);
  const [isLoading, setIsLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);

  // Load tasks on mount
  useEffect(() => {
    // If not authenticated, do not fetch; clear any state and return
    if (!accessToken) {
      setTasks([]);
      setActiveTask(null);
      setIsLoading(false);
      setError(null);
      return;
    }
    // Check for recoverable timer state first
    const checkForRecovery = async () => {
      const savedState = loadTimerState();
      if (savedState) {
        const validation = validateTimerState(savedState);
        if (validation.isValid && savedState.activeTask) {
          timerLog('[TaskContext] Found recoverable timer; deferring to backend for truth');
          // Do NOT set activeTask from localStorage to avoid auto-resume.
          // useTaskTimer can still show recovered session info without reactivating.
        }
      }
      
      // Then load fresh data from backend
      await loadTasks();
      const backendActiveTask = await loadActiveTask();
      
      // If backend has no active task but localStorage does, clear the stale data
      if (!backendActiveTask && savedState?.activeTask) {
        timerLog('[TaskContext] Backend has no active task, clearing stale localStorage');
        clearTimerState();
        setActiveTask(null);
      }
    };
    
    checkForRecovery();
  }, [accessToken]);

  // Load all tasks
  const loadTasks = useCallback(async () => {
    if (!accessToken) {
      // Not authenticated; nothing to load
      setTasks([]);
      return;
    }
    try {
      setIsLoading(true);
      const fetchedTasks = await taskApi.getAll();
      setTasks(fetchedTasks);
      setError(null);
    } catch (err) {
      // If unauthorized, try refreshing once then retry
      const msg = err instanceof Error ? err.message : String(err);
      if (/unauthorized/i.test(msg)) {
        authLog('TaskContext.loadTasks: unauthorized, attempting refresh');
        const ok = await refresh();
        if (ok) {
          try {
            const fetchedTasks = await taskApi.getAll();
            setTasks(fetchedTasks);
            setError(null);
            return;
          } catch (e2) {
            console.error('Error loading tasks after refresh:', e2);
          }
        } else {
          // Refresh failed; soft-expire handled by AuthContext. Do not logout here.
          authLog('TaskContext.loadTasks: refresh failed, soft-expire active');
          return;
        }
      }
      setError(err instanceof Error ? err.message : 'Failed to load tasks');
      console.error('Error loading tasks:', err);
    } finally {
      setIsLoading(false);
    }
  }, [accessToken]);

  // Load active task
  const loadActiveTask = useCallback(async () => {
    if (!accessToken) {
      setActiveTask(null);
      return null;
    }
    try {
      const active = await taskApi.getActive();
      timerLog('[TaskContext] Loaded active task from backend:', {
        taskId: active?.id,
        isActive: active?.is_active,
        sessionDuration: active?.session_duration
      });
      setActiveTask(active);
      return active;
    } catch (err) {
      // If unauthorized, attempt refresh and retry
      const msg = err instanceof Error ? err.message : String(err);
      if (/unauthorized/i.test(msg)) {
        authLog('TaskContext.loadActiveTask: unauthorized, attempting refresh');
        const ok = await refresh();
        if (ok) {
          try {
            const active = await taskApi.getActive();
            setActiveTask(active);
            return active;
          } catch (e2) {
            console.error('Error loading active task after refresh:', e2);
          }
        } else {
          // Refresh failed; soft-expire handled by AuthContext. Do not logout here.
          authLog('TaskContext.loadActiveTask: refresh failed, soft-expire active');
          return null;
        }
      }
      timerLog('Error loading active task:', { error: String(err) });
      // Don't set activeTask to null on error - it might be a recovered task
      return null;
    }
  }, [accessToken]);

  // Start a new task
  const startTask = useCallback(async (title: string, project: string, tags: string[]) => {
    const attemptCreate = async () => {
      // Stop any existing active task
      if (activeTask) {
        await taskApi.stopTimer(activeTask.id, activeTask.duration);
      }
      // Create new task
      return taskApi.create({ title, project, tags, is_active: true });
    };

    try {
      let newTask = await attemptCreate();
      setActiveTask(newTask);
      await loadTasks();
      return newTask;
    } catch (err) {
      const msg = err instanceof Error ? err.message : String(err);
      // If unauthorized, attempt a token refresh once and retry
      if (/unauthorized/i.test(msg)) {
        const ok = await refresh();
        if (ok) {
          try {
            const newTask = await attemptCreate();
            setActiveTask(newTask);
            await loadTasks();
            return newTask;
          } catch (e2) {
            setError(e2 instanceof Error ? e2.message : 'Failed to start task');
            throw e2;
          }
        }
      }
      setError(msg || 'Failed to start task');
      throw err;
    }
  }, [activeTask, loadTasks, refresh]);

  // Update the active task's timer
  const updateTaskTimer = useCallback(async (duration: number, sessionDuration?: number) => {
    if (!activeTask) return;

    try {
      const updatedTask = await taskApi.updateTimer(activeTask.id, duration, sessionDuration);
      setActiveTask(updatedTask);
      
      // Update the task in the tasks list
      setTasks(prevTasks => 
        prevTasks.map(task => 
          task.id === updatedTask.id ? updatedTask : task
        )
      );
    } catch (err) {
      timerLog('Error updating timer:', { error: String(err) });
    }
  }, [activeTask]);

  // Stop the active task
  const stopTask = useCallback(async (currentDuration?: number, sessionDuration?: number) => {
    timerLog('[TaskContext] stopTask called:', {
      activeTaskId: activeTask?.id,
      frontendTotal: currentDuration,
      backendDuration: activeTask?.duration,
      sessionDuration,
      activeTaskIsActive: activeTask?.is_active,
      discrepancy: currentDuration !== undefined && activeTask?.duration !== undefined
        ? currentDuration - activeTask.duration
        : 'N/A',
      timestamp: new Date().toISOString()
    });
    
    if (!activeTask) {
      timerLog('[TaskContext] No active task to stop');
      return;
    }

    try {
      // Use provided duration or fall back to activeTask duration
      const finalDuration = currentDuration ?? activeTask.duration;
      timerLog('[TaskContext] Calling API stopTimer:', {
        taskId: activeTask.id,
        finalDuration,
        sessionDuration
      });
      
      const stoppedTask = await taskApi.stopTimer(activeTask.id, finalDuration, sessionDuration);
      
      timerLog('[TaskContext] API response:', {
        stoppedTaskId: stoppedTask.id,
        stoppedTaskIsActive: stoppedTask.is_active,
        stoppedTaskDuration: stoppedTask.duration
      });
      
      setActiveTask(null);
      
      // Update the task in the tasks list with the stopped task
      // Make sure the stopped task has is_active: false
      const updatedStoppedTask = { ...stoppedTask, is_active: false };
      setTasks(prevTasks => 
        prevTasks.map(task => 
          task.id === stoppedTask.id ? updatedStoppedTask : task
        )
      );
      
      timerLog('[TaskContext] Task stopped successfully');
    } catch (err) {
      timerLog('[TaskContext] Error stopping task:', { error: String(err) });
    }
  }, [activeTask]);

  // Refresh active task when tab becomes visible again
  useEffect(() => {
    const handleVisibility = () => {
      if (document.visibilityState === 'visible' && accessToken) {
        loadActiveTask().catch(() => {});
      }
    };
    document.addEventListener('visibilitychange', handleVisibility);
    return () => document.removeEventListener('visibilitychange', handleVisibility);
  }, [accessToken, loadActiveTask]);

  // Resume a stopped task
  const resumeTask = useCallback(async (taskId: number) => {
    timerLog('[TaskContext] resumeTask called:', {
      taskId,
      currentActiveTaskId: activeTask?.id,
      currentActiveTaskIsActive: activeTask?.is_active,
      timestamp: new Date().toISOString()
    });
    
    try {
      // Stop any existing active task first
      if (activeTask && activeTask.id !== taskId) {
        timerLog('[TaskContext] Stopping different active task first');
        await stopTask();
      }
      
      // Set the task as active immediately to prevent UI flash
      const taskToResume = tasks.find(t => t.id === taskId);
      timerLog('[TaskContext] Task to resume:', {
        found: !!taskToResume,
        taskId: taskToResume?.id,
        taskIsActive: taskToResume?.is_active
      });
      
      if (taskToResume) {
        timerLog('[TaskContext] Setting task as active optimistically');
        setActiveTask({ ...taskToResume, is_active: true });
      }
      
      // Resume the selected task
      timerLog('[TaskContext] Calling API to resume task');
      const resumedTask = await taskApi.update(taskId, { is_active: true });
      
      timerLog('[TaskContext] API response:', {
        resumedTaskId: resumedTask.id,
        resumedTaskIsActive: resumedTask.is_active,
        resumedTaskDuration: resumedTask.duration,
        resumedTaskSessionDuration: resumedTask.session_duration
      });
      
      setActiveTask(resumedTask);
      
      // Update the task in the tasks list
      setTasks(prevTasks => 
        prevTasks.map(task => 
          task.id === resumedTask.id ? resumedTask : task
        )
      );
      
      timerLog('[TaskContext] Task resumed successfully');
    } catch (err) {
      timerLog('[TaskContext] Error resuming task:', { error: String(err) });
    }
  }, [activeTask, stopTask, tasks]);

  // Move task to different column
  const moveTask = useCallback(async (taskId: number, columnIndex: number, position?: number) => {
    try {
      moveLog('[TaskContext] Moving task', { taskId, columnIndex, position });
      
      // Optimistic update: update local state immediately
      setTasks(prevTasks => {
        const taskToMove = prevTasks.find(t => t.id === taskId);
        if (!taskToMove) return prevTasks;
        
        // Create a new array with the task moved to the new column
        const updatedTasks = prevTasks.map(task => {
          if (task.id === taskId) {
            return { ...task, column_index: columnIndex, position: position ?? task.position };
          }
          // Adjust positions of other tasks in the target column
          if (task.column_index === columnIndex && position !== undefined && task.position >= position) {
            return { ...task, position: task.position + 1 };
          }
          return task;
        });
        
        return updatedTasks;
      });
      
      // Then make the API call
      const updates: { column_index: number; position?: number } = { column_index: columnIndex };
      if (position !== undefined) {
        updates.position = position;
      }
      const updatedTask = await taskApi.update(taskId, updates);
      moveLog('[TaskContext] Move response', { updatedTaskId: updatedTask.id, column_index: updatedTask.column_index, position: updatedTask.position });
      
      // Reload to get the server's authoritative state
      await loadTasks();
    } catch (err) {
      moveLog('Error moving task:', { error: String(err) });
      // Revert on error by reloading
      await loadTasks();
      throw err;
    }
  }, [loadTasks]);

  // Reorder task within same column
  const reorderTask = useCallback(async (taskId: number, newPosition: number) => {
    try {
      moveLog('[TaskContext] Reordering task', { taskId, newPosition });
      
      // Optimistic update: reorder locally immediately
      setTasks(prevTasks => {
        const taskToMove = prevTasks.find(t => t.id === taskId);
        if (!taskToMove) return prevTasks;
        
        const oldPosition = taskToMove.position;
        const columnIndex = taskToMove.column_index;
        
        // Update positions for all affected tasks in the same column
        const updatedTasks = prevTasks.map(task => {
          if (task.column_index !== columnIndex) return task;
          
          if (task.id === taskId) {
            return { ...task, position: newPosition };
          }
          
          // Adjust positions of other tasks
          if (oldPosition < newPosition) {
            // Moving down: tasks between old and new position shift up
            if (task.position > oldPosition && task.position <= newPosition) {
              return { ...task, position: task.position - 1 };
            }
          } else {
            // Moving up: tasks between new and old position shift down
            if (task.position >= newPosition && task.position < oldPosition) {
              return { ...task, position: task.position + 1 };
            }
          }
          
          return task;
        });
        
        return updatedTasks;
      });
      
      // Then make the API call
      const updatedTask = await taskApi.update(taskId, { position: newPosition });
      moveLog('[TaskContext] Reorder response', { updatedTaskId: updatedTask.id, position: updatedTask.position });
      
      // Reload to get the server's authoritative state
      await loadTasks();
    } catch (err) {
      moveLog('Error reordering task:', { error: String(err) });
      // Revert on error by reloading
      await loadTasks();
      throw err;
    }
  }, [loadTasks]);

  // Update task properties
  const updateTask = useCallback(async (taskId: number, updates: { title?: string; project?: string; tags?: string[]; is_active?: boolean }) => {
    try {
      const updatedTask = await taskApi.update(taskId, updates);
      
      // Update the task in the tasks list
      setTasks(prevTasks => 
        prevTasks.map(task => 
          task.id === updatedTask.id ? updatedTask : task
        )
      );
      
      // If this is the active task, update it too
      if (activeTask?.id === taskId) {
        setActiveTask(updatedTask);
      }
    } catch (err) {
      timerLog('Error updating task:', { error: String(err) });
    }
  }, [activeTask]);

  const completeTask = useCallback(async (taskId: number) => {
    const previousActive = activeTask;
    let removedTask: Task | null = null;

    setTasks(prevTasks => {
      const next = prevTasks.filter(task => {
        if (task.id === taskId) {
          removedTask = task;
          return false;
        }
        return true;
      });
      return next;
    });

    if (previousActive?.id === taskId) {
      setActiveTask(null);
    }

    try {
      await taskApi.update(taskId, { status: 'completed', is_active: false });
      await loadTasks();
    } catch (err) {
      if (removedTask) {
        setTasks(prevTasks => {
          const restored = [...prevTasks, removedTask];
          restored.sort((a, b) => {
            if (a.column_index !== b.column_index) return a.column_index - b.column_index;
            if (a.position !== b.position) return a.position - b.position;
            return a.id - b.id;
          });
          return restored;
        });
      }

      if (previousActive?.id === taskId && previousActive) {
        setActiveTask(previousActive);
      }

      await loadTasks();
      throw err;
    }
  }, [activeTask, loadTasks]);

  const deleteTask = useCallback(async (taskId: number) => {
    const previousActive = activeTask;
    let removedTask: Task | null = null;

    setTasks(prevTasks => {
      const next = prevTasks.filter(task => {
        if (task.id === taskId) {
          removedTask = task;
          return false;
        }
        return true;
      });
      return next;
    });

    if (previousActive?.id === taskId) {
      setActiveTask(null);
    }

    try {
      await taskApi.delete(taskId);
      await loadTasks();
    } catch (err) {
      if (removedTask) {
        setTasks(prevTasks => {
          const restored = [...prevTasks, removedTask!];
          restored.sort((a, b) => {
            if (a.column_index !== b.column_index) return a.column_index - b.column_index;
            if (a.position !== b.position) return a.position - b.position;
            return a.id - b.id;
          });
          return restored;
        });
      }

      if (previousActive?.id === taskId && previousActive) {
        setActiveTask(previousActive);
      }

      await loadTasks();
      throw err;
    }
  }, [activeTask, loadTasks]);

  return (
    <TaskContext.Provider 
      value={{
        activeTask,
        tasks,
        isLoading,
        error,
        startTask,
        updateTaskTimer,
        stopTask,
        resumeTask,
        loadTasks,
        loadActiveTask,
        moveTask,
        reorderTask,
        updateTask,
        completeTask,
        deleteTask,
      }}
    >
      {children}
    </TaskContext.Provider>
  );
}

export function useTask() {
  const context = useContext(TaskContext);
  if (context === undefined) {
    throw new Error('useTask must be used within a TaskProvider');
  }
  return context;
}
