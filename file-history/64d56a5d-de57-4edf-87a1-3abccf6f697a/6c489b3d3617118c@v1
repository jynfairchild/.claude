import { authApi } from './authApi';
import { authLog } from '@/utils/debug';

export type RefreshResult = { token: string; refresh_token: string; refresh_expires?: string };

// Cooldown window to avoid back-to-back refreshes that race with rotation
const COOLDOWN_MS = 2000;

// localStorage keys (must match AuthContext)
const ACCESS_TOKEN_KEY = 'kk_access_token';
const REFRESH_TOKEN_KEY = 'kk_refresh_token';
const REFRESH_EXPIRES_KEY = 'kk_refresh_expires';

let inFlight: Promise<RefreshResult> | null = null;
let lastSuccess: RefreshResult | null = null;
let lastSuccessAt = 0;

export function getLastRefreshSuccessAt(): number { return lastSuccessAt; }
export function getLastRefreshResult(): RefreshResult | null { return lastSuccess; }

// Helper to read current refresh token from localStorage
function getStoredRefreshToken(): string | null {
  try {
    return localStorage.getItem(REFRESH_TOKEN_KEY);
  } catch {
    return null;
  }
}

// Helper to immediately persist new tokens to localStorage
function persistTokens(result: RefreshResult): void {
  try {
    localStorage.setItem(ACCESS_TOKEN_KEY, result.token);
    localStorage.setItem(REFRESH_TOKEN_KEY, result.refresh_token);
    if (result.refresh_expires) {
      localStorage.setItem(REFRESH_EXPIRES_KEY, result.refresh_expires);
    }
    authLog('globalRefresh: persisted new tokens to localStorage');
  } catch (e) {
    authLog('globalRefresh: failed to persist tokens', { error: e });
  }
}

export async function globalRefresh(refreshToken: string): Promise<RefreshResult> {
  // If there's an in-flight refresh, join it (all callers share the same result)
  if (inFlight) {
    authLog('globalRefresh: join in-flight refresh');
    return inFlight;
  }

  const now = Date.now();

  // Within cooldown: reuse last success to avoid immediate rotation thrash
  if (lastSuccess && now - lastSuccessAt < COOLDOWN_MS) {
    authLog('globalRefresh: returning last success due to cooldown', { cooldownMs: COOLDOWN_MS, sinceMs: now - lastSuccessAt });
    return lastSuccess;
  }

  // Check if the token we were given is stale (already rotated by another call)
  // If localStorage has a different token, use that one instead
  const storedToken = getStoredRefreshToken();
  if (storedToken && storedToken !== refreshToken && lastSuccess && lastSuccess.refresh_token === storedToken) {
    // localStorage was already updated by a recent refresh, and we have the result cached
    authLog('globalRefresh: caller token is stale, returning cached result', {
      callerTokenEnd: refreshToken.slice(-8),
      storedTokenEnd: storedToken.slice(-8),
    });
    return lastSuccess;
  }

  // Use the most recent token (prefer stored over passed if different and we don't have cached result)
  const tokenToUse = storedToken && storedToken !== refreshToken ? storedToken : refreshToken;
  if (tokenToUse !== refreshToken) {
    authLog('globalRefresh: using stored token instead of passed token', {
      passedEnd: refreshToken.slice(-8),
      storedEnd: tokenToUse.slice(-8),
    });
  }

  authLog('globalRefresh: starting network refresh');
  inFlight = (async () => {
    const resp = await authApi.refresh(tokenToUse);

    // CRITICAL: Persist to localStorage IMMEDIATELY before returning
    // This ensures any other code reading localStorage gets the new token
    persistTokens(resp);

    lastSuccess = resp;
    lastSuccessAt = Date.now();
    authLog('globalRefresh: refresh success', { at: lastSuccessAt });
    return resp;
  })();

  try {
    return await inFlight;
  } finally {
    authLog('globalRefresh: clear in-flight');
    inFlight = null;
  }
}

// Test utility to clear cached refresh state between specs
export function resetRefreshGateForTests(): void {
  if (process.env.NODE_ENV !== 'test') return;
  inFlight = null;
  lastSuccess = null;
  lastSuccessAt = 0;
}
