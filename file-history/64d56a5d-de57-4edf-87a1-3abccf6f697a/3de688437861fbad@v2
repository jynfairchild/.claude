'use client';

import React, { createContext, useContext, useState, useEffect, useRef, useCallback } from 'react';
import type { WorkerMessage } from '@/types/worker.types';
import { isDebugEnabled } from '@/utils/debug';

interface TimerWorkerContextValue {
  // Current elapsed seconds
  seconds: number;
  
  // Control methods
  start: () => void;
  stop: () => void;
  reset: () => void;
  
  // State
  isRunning: boolean;
  
  // Start time for duration calculations
  startTime: number | null;
  
  // For integration with existing timer hooks
  workerRef: React.MutableRefObject<Worker | null>;
}

export const TimerWorkerContext = createContext<TimerWorkerContextValue | null>(null);

export const useTimerWorker = () => {
  const context = useContext(TimerWorkerContext);
  if (!context) {
    throw new Error('useTimerWorker must be used within TimerWorkerProvider');
  }
  return context;
};

interface TimerWorkerProviderProps {
  children: React.ReactNode;
}

export const TimerWorkerProvider: React.FC<TimerWorkerProviderProps> = ({ children }) => {
  const [seconds, setSeconds] = useState(0);
  const [isRunning, setIsRunning] = useState(false);
  const [startTime, setStartTime] = useState<number | null>(null);
  
  const workerRef = useRef<Worker | null>(null);
  const fallbackIntervalRef = useRef<number | null>(null);
  const debugEnabled = isDebugEnabled('WORKER');
  
  // Initialize worker on mount
  useEffect(() => {
    try {
      if (debugEnabled) {
        console.log('[TimerWorkerContext] Creating shared Web Worker');
      }
      const worker = new Worker(new URL('../workers/timer.worker.js', import.meta.url));
      
      worker.onmessage = (e: MessageEvent<WorkerMessage>) => {
        if (e.data.type === 'tick') {
          setSeconds(prev => {
            const newValue = prev + 1;
            if (debugEnabled) {
              console.log('[TimerWorkerContext] Tick:', newValue);
            }
            return newValue;
          });
        } else if (e.data.type === 'stopped') {
          if (debugEnabled) {
            console.log('[TimerWorkerContext] Worker stopped');
          }
        }
      };
      
      worker.onerror = (error) => {
        if (debugEnabled) {
          console.error('[TimerWorkerContext] Worker error, will use fallback interval:', error);
        }
      };
      
      // Configure worker debug based on WORKER category
      try {
        const debug = isDebugEnabled('WORKER');
        worker.postMessage({ type: 'setDebug', debug });
      } catch {}
      workerRef.current = worker;
      
    } catch (error) {
      if (debugEnabled) {
        console.warn('[TimerWorkerContext] Failed to create Web Worker, will use fallback interval:', error);
      }
    }
    
    // Cleanup on unmount
    return () => {
      if (workerRef.current) {
        workerRef.current.terminate();
        workerRef.current = null;
      }
      if (fallbackIntervalRef.current) {
        clearInterval(fallbackIntervalRef.current);
        fallbackIntervalRef.current = null;
      }
    };
  }, []); // Only run once on mount

  // Sync worker debug flag on runtime toggle changes via storage events
  useEffect(() => {
    const onStorage = (e: StorageEvent) => {
      if (e.storageArea !== localStorage) return;
      if (!workerRef.current) return;
      if (!e.key) return;
      if (e.key === 'kk_debug_ALL' || e.key === 'kk_debug_WORKER') {
        try {
          const debug = isDebugEnabled('WORKER');
          workerRef.current.postMessage({ type: 'setDebug', debug });
        } catch {}
      }
    };
    window.addEventListener('storage', onStorage);
    return () => window.removeEventListener('storage', onStorage);
  }, []);

  // Start the timer
  const start = useCallback(() => {
    if (debugEnabled) {
      console.log('[TimerWorkerContext] Start called, isRunning:', isRunning);
    }
    if (isRunning) return;
    
    setSeconds(0);
    setIsRunning(true);
    setStartTime(Date.now());
    
    if (workerRef.current) {
      if (debugEnabled) {
        console.log('[TimerWorkerContext] Sending start message to worker');
      }
      workerRef.current.postMessage({ type: 'start' });
    } else {
      // Use fallback interval
      if (debugEnabled) {
        console.log('[TimerWorkerContext] Starting fallback interval');
      }
      const interval = setInterval(() => {
        setSeconds(prev => prev + 1);
      }, 1000);
      fallbackIntervalRef.current = interval as unknown as number;
    }
  }, [isRunning, debugEnabled]);
  
  // Stop the timer
  const stop = useCallback(() => {
    if (debugEnabled) {
      console.log('[TimerWorkerContext] Stop called');
    }
    setIsRunning(false);
    
    if (workerRef.current) {
      if (debugEnabled) {
        console.log('[TimerWorkerContext] Sending stop message to worker');
      }
      workerRef.current.postMessage({ type: 'stop' });
    } else if (fallbackIntervalRef.current) {
      if (debugEnabled) {
        console.log('[TimerWorkerContext] Stopping fallback interval');
      }
      clearInterval(fallbackIntervalRef.current);
      fallbackIntervalRef.current = null;
    }
  }, [debugEnabled]);
  
  // Reset the timer
  const reset = useCallback(() => {
    if (debugEnabled) {
      console.log('[TimerWorkerContext] Reset called');
    }
    stop();
    setSeconds(0);
    setStartTime(null);
  }, [stop, debugEnabled]);
  
  const value: TimerWorkerContextValue = {
    seconds,
    start,
    stop,
    reset,
    isRunning,
    startTime,
    workerRef,
  };
  
  return (
    <TimerWorkerContext.Provider value={value}>
      {children}
    </TimerWorkerContext.Provider>
  );
};

// Optional: Hook to check if timer worker is available
export const useIsTimerWorkerAvailable = () => {
  try {
    const context = useContext(TimerWorkerContext);
    return context !== null;
  } catch {
    return false;
  }
};
