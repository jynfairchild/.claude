'use client';

import React, { useState, useEffect, useRef } from 'react';
import Image from 'next/image';
import threeDotIcon from '@/assets/components/kanban/3dot.svg';
import addIcon from '@/assets/components/kanban/add_24px.svg';
import Card, { draggedCardHeight as globalDraggedCardHeight, draggedCardId as globalDraggedCardId } from '@/components/cards/Card';
import { useTask } from '@/contexts/TaskContext';
import { Session } from '@/services/api';
import './KanbanColumn.css';
import Dropdown from '@/components/ui/Dropdown';
import { moveLog } from '@/utils/debug';

interface ColumnData {
  title: string;
  columnIndex: number; // Backend column index
  columnId?: number;    // UserColumn row id (for updates)
  cards: Array<{
    id: number;
    title: string;
    project: string;
    tags: string[];
    time: string;
    totalTime: string; // Total time from all sessions
    isActive: boolean;
    duration: number; // Add raw duration in seconds
    sessionDuration: number; // Current session duration in seconds
    sessions?: Session[]; // Array of sessions
    position: number;
  }>;
  onNewTask: (columnIndex: number) => void;
  onDropTask?: (columnIndex: number) => void;
  onRenameColumn?: (columnIndex: number, newName: string) => void;
  onRemoveColumn?: (columnIndex: number, columnId?: number, columnName?: string) => Promise<void> | void;
}
import { columnsApi } from '@/services/api';
import { DeleteColumnModal } from '@/components/modal/DeleteColumnModal';
import { useTaskDrag } from '@/contexts/TaskDragContext';

export const KanbanColumn = ({ title, columnIndex, columnId, cards, onNewTask, onDropTask, onRenameColumn, onRemoveColumn }: ColumnData) => {
  const { moveTask, reorderTask, loadTasks } = useTask();
  const { isDraggingTask, endTaskDrag, setHoverTarget } = useTaskDrag();
  const [showMetadata, setShowMetadata] = useState(true);
  const [isDragOver, setIsDragOver] = useState(false);
  const [dropPosition, setDropPosition] = useState<number | null>(null);
  const [isColumnHovered, setIsColumnHovered] = useState(false);
  const [isEditingTitle, setIsEditingTitle] = useState(false);
  const [editedTitle, setEditedTitle] = useState(title);
  const titleInputRef = useRef<HTMLInputElement>(null);
  const columnRef = useRef<HTMLDivElement>(null);
  const [isDeleteOpen, setIsDeleteOpen] = useState(false);
  const [deleteMode, setDeleteMode] = useState<'confirm'|'info'>('confirm');
  const [deleteMessage, setDeleteMessage] = useState<string | undefined>(undefined);
  
  // Clear any lingering drop indicators once a drag fully ends (e.g., task dropped into a tray)
  useEffect(() => {
    if (!isDraggingTask) {
      setIsDragOver(false);
      setDropPosition(null);
    }
  }, [isDraggingTask]);
  
  const handleMenuRename = () => {
    setIsEditingTitle(true);
    setEditedTitle('');
  };

  const handleMenuRemove = async () => {
    // If column is empty, delete immediately without confirmation
    if (cards.length === 0) {
      try {
        if (columnId) {
          await columnsApi.delete(columnId);
        }
        await onRemoveColumn?.(columnIndex, columnId, title);
      } catch (e) {
        console.error('Failed to delete column:', e);
        const msg = e instanceof Error ? e.message : 'Unable to delete column.';
        const known = msg.replace(/^Failed to delete column:\s*/i, '');
        setDeleteMode('info');
        setDeleteMessage(known);
        setIsDeleteOpen(true);
      }
      return;
    }
    // Column has tasks - show confirmation modal
    setDeleteMode('confirm');
    setDeleteMessage(undefined);
    setIsDeleteOpen(true);
  };

  const handleConfirmDelete = async () => {
    try {
      if (columnId) {
        await columnsApi.delete(columnId);
      }
      await onRemoveColumn?.(columnIndex, columnId, title);
    } catch (e) {
      console.error('Failed to delete column:', e);
      // If backend blocked the operation (e.g., last column), show info message
      const msg = e instanceof Error ? e.message : 'Unable to delete column.';
      // Try to extract backend-provided text after our prefix
      const known = msg.replace(/^Failed to delete column:\s*/i, '');
      setDeleteMode('info');
      setDeleteMessage(known);
      return; // keep modal open
    } finally {
      if (deleteMode === 'confirm') {
        // Close only when successful
        setIsDeleteOpen(false);
      }
    }
  };
  
  const handleToggleMetadata = () => {
    setShowMetadata(!showMetadata);
  };
  
  // Keep edited title in sync with prop updates
  useEffect(() => { setEditedTitle(title); }, [title]);

  // Focus input when entering edit mode
  useEffect(() => {
    if (isEditingTitle && titleInputRef.current) {
      titleInputRef.current.focus();
      titleInputRef.current.select();
    }
  }, [isEditingTitle]);

  const handleTitleClick = () => {
    setIsEditingTitle(true);
    setEditedTitle('');
  };

  const saveTitle = async () => {
    const newName = editedTitle.trim();
    if (!newName || newName === title) {
      setEditedTitle(title);
      setIsEditingTitle(false);
      return;
    }
    try {
      onRenameColumn?.(columnIndex, newName);
    } catch (e) {
      console.error('Failed to rename column:', e);
      setEditedTitle(title);
    } finally {
      setIsEditingTitle(false);
    }
  };

  const handleTitleKeyDown = (e: React.KeyboardEvent<HTMLInputElement>) => {
    if (e.key === 'Enter' || e.key === 'Tab') {
      e.preventDefault();
      saveTitle();
    } else if (e.key === 'Escape') {
      setEditedTitle(title);
      setIsEditingTitle(false);
    }
  };
  
  const handleDragOver = (e: React.DragEvent<HTMLDivElement>) => {
    e.preventDefault(); // Allow drop
    e.dataTransfer.dropEffect = 'move';
    
    // Calculate drop position based on mouse position
    if (columnRef.current) {
      const cardElements = columnRef.current.querySelectorAll('.card');
      let newDropPosition = cards.length; // Default to end (using cards array length, not DOM elements)
      
      // Find if the dragged card is already in this column
      const draggedCardIndex = cards.findIndex(card => card.id === globalDraggedCardId);
      const isCardInColumn = draggedCardIndex !== -1;
      
      // Find visual position based on mouse Y coordinate
      for (let i = 0; i < cardElements.length; i++) {
        const cardElement = cardElements[i];
        const cardRect = cardElement.getBoundingClientRect();
        const cardMiddle = cardRect.top + cardRect.height / 2;
        
        if (e.clientY < cardMiddle) {
          newDropPosition = i;
          break;
        }
      }
      
      // If the card is in this column, don't show indicator for positions that wouldn't change anything
      if (isCardInColumn) {
        // If dropping at the same position or the position right after (which is the same after removal)
        if (newDropPosition === draggedCardIndex || newDropPosition === draggedCardIndex + 1) {
          setDropPosition(null); // Don't show any indicator
          return;
        }
      }
      
      setDropPosition(newDropPosition);
    }
  };
  
  const handleDragEnter = (e: React.DragEvent<HTMLDivElement>) => {
    e.preventDefault();
    setIsDragOver(true);
    // Reset hover state during drag operations
    setIsColumnHovered(false);
  };
  
  const handleDragLeave = (e: React.DragEvent<HTMLDivElement>) => {
    // Only set isDragOver to false if we're leaving the column entirely
    const rect = e.currentTarget.getBoundingClientRect();
    const x = e.clientX;
    const y = e.clientY;
    
    if (x < rect.left || x >= rect.right || y < rect.top || y >= rect.bottom) {
      setIsDragOver(false);
      setDropPosition(null);
      // Reset hover state when leaving during drag
      setIsColumnHovered(false);
    }
  };
  
  const handleNewTask = () => {
    onNewTask(columnIndex);
  };
  
  const handleDrop = async (e: React.DragEvent<HTMLDivElement>) => {
    e.preventDefault();
    const finalDropPosition = dropPosition; // Save before resetting
    setIsDragOver(false);
    setDropPosition(null);
    setHoverTarget(null);
    endTaskDrag();
    
    // Capture values before the timeout (e.currentTarget becomes null in async callbacks)
    const columnElement = e.currentTarget;
    const mouseX = e.clientX;
    const mouseY = e.clientY;
    
    // After drop, check if mouse is still over the column and restore hover state
    // Use a small timeout to let the drag operation fully complete
    setTimeout(() => {
      const rect = columnElement.getBoundingClientRect();
      
      // If mouse is still within column bounds, show the add button
      if (mouseX >= rect.left && mouseX < rect.right && mouseY >= rect.top && mouseY < rect.bottom) {
        setIsColumnHovered(true);
      }
    }, 50);
    
    const taskId = parseInt(e.dataTransfer.getData('taskId'));
    const taskTitle = e.dataTransfer.getData('taskTitle');
    
    if (!taskId) return;
    
    // Check if the task is already in this column
    const existingCardIndex = cards.findIndex(card => card.id === taskId);
    const taskInColumn = existingCardIndex !== -1;
    
    if (taskInColumn) {
      // Reorder within same column
      if (finalDropPosition !== null && finalDropPosition !== existingCardIndex) {
        moveLog(`[KanbanColumn] Reordering task "${taskTitle}" from position ${existingCardIndex} to position ${finalDropPosition}`);
        
        // When moving within the same column, adjust for the card being removed from its original position
        // If moving down, the positions below shift up, so we need to subtract 1
        const adjustedPosition = finalDropPosition > existingCardIndex ? finalDropPosition - 1 : finalDropPosition;
        
        try {
          moveLog(`[KanbanColumn] Calling reorderTask with taskId: ${taskId}, adjusted position: ${adjustedPosition}`);
          await reorderTask(taskId, adjustedPosition);
          moveLog('[KanbanColumn] Reorder successful, reloading tasks...');
          // Instead of reload, refresh the task list
          await loadTasks();
        } catch (error) {
          moveLog('Failed to reorder task:', { error: String(error) });
          // Don't reload on error
        }
      }
    } else {
      // Move to different column
      moveLog(`[KanbanColumn] Moving task "${taskTitle}" (ID: ${taskId}) to column ${columnIndex} at position ${finalDropPosition}`);
      
      try {
        await moveTask(taskId, columnIndex, finalDropPosition ?? undefined);
        // Track the column where the task was dropped
        if (onDropTask) {
          onDropTask(columnIndex);
        }
      } catch (error) {
        moveLog('Failed to move task:', { error: String(error) });
      }
    }
  };
  
  return (
    <div 
      className={`kanban-column ${isDragOver ? 'kanban-column--drag-over' : ''}`}
      onDragOver={handleDragOver}
      onDragEnter={handleDragEnter}
      onDragLeave={handleDragLeave}
      onDrop={handleDrop}
      onMouseEnter={() => setIsColumnHovered(true)}
      onMouseLeave={() => setIsColumnHovered(false)}
    >
      <div className="kanban-column-header">
        {isEditingTitle ? (
          <input
            ref={titleInputRef}
            type="text"
            className="kanban-column-title-input"
            value={editedTitle}
            onChange={(e) => setEditedTitle(e.target.value)}
            onBlur={saveTitle}
            onKeyDown={handleTitleKeyDown}
          />
        ) : (
          <h2 className="kanban-column-title editable" onClick={handleTitleClick}>{editedTitle}</h2>
        )}
        <div className="kanban-column-menu-container">
          <Dropdown
            align="right"
            panelClassName="wide"
            trigger={({ onClick, "aria-expanded": expanded }) => (
              <button className="kanban-column-menu" onClick={onClick} aria-haspopup="menu" aria-expanded={expanded}>
                <Image src={threeDotIcon} alt="Menu" width={28} height={28} />
              </button>
            )}
          >
            {(close) => (
              <>
                <button className="dropdown-item" onClick={() => { handleMenuRename(); close(); }}>Rename column</button>
                <button className="dropdown-item" onClick={() => { handleMenuRemove(); close(); }}>Remove column</button>
                <div className="dropdown-separator" />
                <div className="dropdown-item" aria-label="Show metadata row">
                  <span>Show metadata</span>
                  <button
                    className={`kanban-column-toggle ${showMetadata ? 'active' : ''}`}
                    onClick={(e) => { e.stopPropagation(); handleToggleMetadata(); }}
                    aria-pressed={showMetadata}
                    aria-label="Toggle metadata visibility"
                  >
                    <span className="kanban-column-toggle-slider" />
                  </button>
                </div>
              </>
            )}
          </Dropdown>
        </div>
      </div>
      <div className="kanban-column-content" ref={columnRef}>
        {cards.map((card, index) => (
          <React.Fragment key={card.id}>
            {dropPosition === index && isDragOver && (
              <div className="kanban-drop-indicator" style={{ height: `${globalDraggedCardHeight}px` }} />
            )}
          <Card
            taskId={card.id}
            title={card.title}
            project={card.project}
            tags={card.tags}
            time={card.time}
            totalTime={card.totalTime}
            isActive={card.isActive}
            currentDuration={card.duration}
            sessionDuration={card.sessionDuration}
            sessions={card.sessions}
            variant={card.isActive ? 'active' : (showMetadata ? 'inactive' : 'minimal')}
            columnIndex={columnIndex}
            position={card.position}
          />
          </React.Fragment>
        ))}
        {dropPosition === cards.length && isDragOver && (
          <div className="kanban-drop-indicator" style={{ height: `${globalDraggedCardHeight}px` }} />
        )}
        
        {/* New Task Button: always in layout; toggled visible on hover to avoid height jump */}
        <button className={`kanban-new-task-button ${isColumnHovered ? 'is-visible' : ''}`} onClick={handleNewTask}>
          <Image 
            src={addIcon} 
            alt="Add new task" 
            width={24} 
            height={24}
          />
        </button>
      </div>
      <DeleteColumnModal 
        isOpen={isDeleteOpen}
        columnName={title}
        onCancel={() => setIsDeleteOpen(false)}
        onConfirm={handleConfirmDelete}
        mode={deleteMode}
        message={deleteMessage}
      />
    </div>
  );
};
