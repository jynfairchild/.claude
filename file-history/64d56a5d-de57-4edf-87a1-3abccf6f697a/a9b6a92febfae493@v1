// After stopping a task (is_active=false), a subsequent periodic update that omits
// is_active must NOT reactivate the task.
func TestUpdateTask_AfterStop_PeriodicUpdate_DoesNotReactivate(t *testing.T) {
	db := setupTestDB(t)
	h := NewTaskHandler(db)
	r, w := setupTaskRouter(h)

	// Create active task via API (so it has an open session)
	w = httptest.NewRecorder()
	reqCreate := httptest.NewRequest(http.MethodPost, "/api/v1/tasks", bytes.NewBufferString(`{"title":"T","is_active":true}`))
	reqCreate.Header.Set("Content-Type", "application/json")
	r.ServeHTTP(w, reqCreate)
	if w.Code != http.StatusCreated {
		t.Fatalf("create failed: %d %s", w.Code, w.Body.String())
	}
	var task models.Task
	if err := json.Unmarshal(w.Body.Bytes(), &task); err != nil {
		t.Fatal(err)
	}

	// Stop the task
	w = httptest.NewRecorder()
	reqStop := httptest.NewRequest(http.MethodPatch, "/api/v1/tasks/"+strconv.Itoa(int(task.ID)), bytes.NewBufferString(`{"is_active":false}`))
	reqStop.Header.Set("Content-Type", "application/json")
	r.ServeHTTP(w, reqStop)
	if w.Code != http.StatusOK {
		t.Fatalf("stop failed: %d %s", w.Code, w.Body.String())
	}

	// Now send a periodic update WITHOUT is_active, only durations
	w = httptest.NewRecorder()
	payload := map[string]any{"duration": 123, "session_duration": 0}
	bts, _ := json.Marshal(payload)
	reqUpd := httptest.NewRequest(http.MethodPatch, "/api/v1/tasks/"+strconv.Itoa(int(task.ID)), bytes.NewReader(bts))
	reqUpd.Header.Set("Content-Type", "application/json")
	r.ServeHTTP(w, reqUpd)
	if w.Code != http.StatusOK {
		t.Fatalf("update failed: %d %s", w.Code, w.Body.String())
	}

	var updated models.Task
	if err := json.Unmarshal(w.Body.Bytes(), &updated); err != nil {
		t.Fatal(err)
	}
	if updated.IsActive {
		t.Fatalf("expected task to remain inactive after periodic update without is_active")
	}
	if updated.Duration != 123 {
		t.Fatalf("expected duration to update to 123, got %d", updated.Duration)
	}
}

func TestDeleteTask_RemovesTaskAndNormalizesPositions(t *testing.T) {
