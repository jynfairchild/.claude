func TestUpdateTask_ReorderSamePosition_NoOp(t *testing.T) {
	db := setupTestDB(t)
	h := NewTaskHandler(db)
	r, w := setupTaskRouter(h)

	// Create three Todo tasks via API: A,B,C with positions 0,1,2
	titles := []string{"A", "B", "C"}
	ids := make([]uint, 0, 3)
	for _, tt := range titles {
		w = httptest.NewRecorder()
		req := httptest.NewRequest(http.MethodPost, "/api/v1/tasks", bytes.NewBufferString(`{"title":"`+tt+`"}`))
		req.Header.Set("Content-Type", "application/json")
		r.ServeHTTP(w, req)
		var tsk models.Task
		_ = json.Unmarshal(w.Body.Bytes(), &tsk)
		ids = append(ids, tsk.ID)
	}

	// Capture initial order by position
	var before []models.Task
	if err := db.Where("column_index = ? AND status = ?", 0, "uncompleted").Find(&before).Error; err != nil {
		t.Fatal(err)
	}
	sort.Slice(before, func(i, j int) bool { return before[i].Position < before[j].Position })
	bTitles := []string{before[0].Title, before[1].Title, before[2].Title}

	// No-op: set B (ids[1]) to its current position
	w = httptest.NewRecorder()
	payload := bytes.NewBufferString(`{"position":1}`)
	req := httptest.NewRequest(http.MethodPatch, "/api/v1/tasks/"+strconv.Itoa(int(ids[1])), payload)
	req.Header.Set("Content-Type", "application/json")
	r.ServeHTTP(w, req)
	if w.Code != http.StatusOK {
		t.Fatalf("expected 200, got %d: %s", w.Code, w.Body.String())
	}

	var after []models.Task
	if err := db.Where("column_index = ? AND status = ?", 0, "uncompleted").Find(&after).Error; err != nil {
		t.Fatal(err)
	}
	sort.Slice(after, func(i, j int) bool { return after[i].Position < after[j].Position })
	aTitles := []string{after[0].Title, after[1].Title, after[2].Title}
	for i := 0; i < 3; i++ {
		if aTitles[i] != bTitles[i] {
			t.Fatalf("expected no-op reorder; before=%v after=%v", bTitles, aTitles)
		}
	}
}

