func TestUpdateTask_StopSession_ComputesDurations(t *testing.T) {
	db := setupTestDB(t)
	h := NewTaskHandler(db)
	r, w := setupTaskRouter(h)

	// Create and start
	createReq := httptest.NewRequest(http.MethodPost, "/api/v1/tasks", bytes.NewBufferString(`{"title":"X"}`))
	createReq.Header.Set("Content-Type", "application/json")
	r.ServeHTTP(w, createReq)
	var task models.Task
	_ = json.Unmarshal(w.Body.Bytes(), &task)

	// Start via update
	w = httptest.NewRecorder()
	startBody := bytes.NewBufferString(`{"is_active":true}`)
	req1 := httptest.NewRequest(http.MethodPatch, "/api/v1/tasks/"+strconv.Itoa(int(task.ID)), startBody)
	req1.Header.Set("Content-Type", "application/json")
	r.ServeHTTP(w, req1)

	// Wait enough to ensure computed duration rounds to >= 1 second
	time.Sleep(1100 * time.Millisecond)

	// Stop via update without explicit durations -> sums sessions
	w = httptest.NewRecorder()
	stopBody := bytes.NewBufferString(`{"is_active":false}`)
	req2 := httptest.NewRequest(http.MethodPatch, "/api/v1/tasks/"+strconv.Itoa(int(task.ID)), stopBody)
	req2.Header.Set("Content-Type", "application/json")
	r.ServeHTTP(w, req2)

	if w.Code != http.StatusOK {
		t.Fatalf("expected 200, got %d: %s", w.Code, w.Body.String())
	}
	var updated models.Task
	_ = json.Unmarshal(w.Body.Bytes(), &updated)
	if updated.IsActive {
		t.Fatalf("expected inactive after stop")
	}
	if updated.Duration <= 0 {
		t.Fatalf("expected positive duration from summed sessions, got %d", updated.Duration)
	}
	// Active session should now have EndTime
	var s models.Session
	if err := db.Where("task_id = ? AND end_time IS NOT NULL", updated.ID).First(&s).Error; err != nil {
		t.Fatalf("expected ended session in DB: %v", err)
	}
}

func TestUpdateTask_MoveBetweenColumns_WithPosition(t *testing.T) {
	db := setupTestDB(t)
	h := NewTaskHandler(db)
	r, w := setupTaskRouter(h)

	// Create two tasks in In Progress to occupy positions 0 and 1
	a := createTestTask(t, db, "A")
	a.ColumnIndex = 1
	a.Position = 0
	if err := db.Save(&a).Error; err != nil {
		t.Fatal(err)
	}
	b := createTestTask(t, db, "B")
	b.ColumnIndex = 1
	b.Position = 1
	if err := db.Save(&b).Error; err != nil {
		t.Fatal(err)
	}

	// Create a Todo task C
	createReq := httptest.NewRequest(http.MethodPost, "/api/v1/tasks", bytes.NewBufferString(`{"title":"C"}`))
	createReq.Header.Set("Content-Type", "application/json")
	r.ServeHTTP(w, createReq)
	if w.Code != http.StatusCreated {
		t.Fatalf("create C failed: %d %s", w.Code, w.Body.String())
	}
	var cTask models.Task
	_ = json.Unmarshal(w.Body.Bytes(), &cTask)

	// Move C to In Progress at position 1
	w = httptest.NewRecorder()
	payload := map[string]any{"column_index": 1, "position": 1}
	bts, _ := json.Marshal(payload)
	req := httptest.NewRequest(http.MethodPatch, "/api/v1/tasks/"+strconv.Itoa(int(cTask.ID)), bytes.NewReader(bts))
	req.Header.Set("Content-Type", "application/json")
	r.ServeHTTP(w, req)

	if w.Code != http.StatusOK {
		t.Fatalf("update failed: %d %s", w.Code, w.Body.String())
	}

	// Verify final positions in In Progress are sequential and C at index 1
	var inprog []models.Task
	if err := db.Where("column_index = ? AND status = ?", 1, "uncompleted").Find(&inprog).Error; err != nil {
		t.Fatal(err)
	}
	sort.Slice(inprog, func(i, j int) bool { return inprog[i].Position < inprog[j].Position })
	if len(inprog) != 3 {
		t.Fatalf("expected 3 in In Progress, got %d", len(inprog))
	}
	if inprog[1].ID != cTask.ID {
		t.Fatalf("expected moved task at position 1, got id=%d", inprog[1].ID)
	}
}

func TestUpdateTask_ReorderWithinSameColumn(t *testing.T) {
	db := setupTestDB(t)
	h := NewTaskHandler(db)
	r, w := setupTaskRouter(h)

	// Create three Todo tasks in order A(0),B(1),C(2)
	// Use API so normalize runs consistently
	mk := func(title string) models.Task {
		w = httptest.NewRecorder()
		req := httptest.NewRequest(http.MethodPost, "/api/v1/tasks", bytes.NewBufferString(`{"title":"`+title+`"}`))
		req.Header.Set("Content-Type", "application/json")
		r.ServeHTTP(w, req)
		var tsk models.Task
		_ = json.Unmarshal(w.Body.Bytes(), &tsk)
		return tsk
	}
	a := mk("A")
	_ = mk("B")
	_ = mk("C")

	// Move A from position 0 to 2 within Todo
	w = httptest.NewRecorder()
	payload := map[string]any{"position": 2}
	bts, _ := json.Marshal(payload)
	req := httptest.NewRequest(http.MethodPatch, "/api/v1/tasks/"+strconv.Itoa(int(a.ID)), bytes.NewReader(bts))
	req.Header.Set("Content-Type", "application/json")
	r.ServeHTTP(w, req)
	if w.Code != http.StatusOK {
		t.Fatalf("reorder update failed: %d %s", w.Code, w.Body.String())
	}

	// Order should be B(0), C(1), A(2)
	var todos []models.Task
	if err := db.Where("column_index = ? AND status = ?", 0, "uncompleted").Find(&todos).Error; err != nil {
		t.Fatal(err)
	}
	sort.Slice(todos, func(i, j int) bool { return todos[i].Position < todos[j].Position })
	if len(todos) != 3 {
		t.Fatalf("expected 3 todos, got %d", len(todos))
	}
	// fetch titles to compare order
	titles := []string{todos[0].Title, todos[1].Title, todos[2].Title}
	want := []string{"B", "C", "A"}
	for i := range want {
		if titles[i] != want[i] {
			t.Fatalf("unexpected order at %d: got %q want %q (positions: %d,%d,%d)", i, titles[i], want[i], todos[0].Position, todos[1].Position, todos[2].Position)
		}
	}
}

func TestGetTaskWithSessions_OrdersBySessionNumAsc(t *testing.T) {
	db := setupTestDB(t)
	h := NewTaskHandler(db)
	r, w := setupTaskRouter(h)

	// Create a task
	w = httptest.NewRecorder()
	req := httptest.NewRequest(http.MethodPost, "/api/v1/tasks", bytes.NewBufferString(`{"title":"T"}`))
	req.Header.Set("Content-Type", "application/json")
	r.ServeHTTP(w, req)
	var task models.Task
	_ = json.Unmarshal(w.Body.Bytes(), &task)

	// Insert sessions out of order
	s2 := models.Session{TaskID: task.ID, StartTime: time.Now(), SessionNum: 2}
	s1 := models.Session{TaskID: task.ID, StartTime: time.Now().Add(-10 * time.Second), SessionNum: 1}
	s3 := models.Session{TaskID: task.ID, StartTime: time.Now().Add(10 * time.Second), SessionNum: 3}
	if err := db.Create(&s2).Error; err != nil {
		t.Fatal(err)
	}
	if err := db.Create(&s1).Error; err != nil {
		t.Fatal(err)
	}
	if err := db.Create(&s3).Error; err != nil {
		t.Fatal(err)
	}

	// Fetch with sessions
	w = httptest.NewRecorder()
	req = httptest.NewRequest(http.MethodGet, "/api/v1/tasks/"+strconv.Itoa(int(task.ID)), nil)
	r.ServeHTTP(w, req)
	if w.Code != http.StatusOK {
		t.Fatalf("expected 200, got %d: %s", w.Code, w.Body.String())
	}
	var got models.Task
	_ = json.Unmarshal(w.Body.Bytes(), &got)
	if len(got.Sessions) != 3 {
		t.Fatalf("expected 3 sessions, got %d", len(got.Sessions))
	}
	if got.Sessions[0].SessionNum != 1 || got.Sessions[1].SessionNum != 2 || got.Sessions[2].SessionNum != 3 {
		t.Fatalf("expected sessions ordered 1,2,3; got %d,%d,%d", got.Sessions[0].SessionNum, got.Sessions[1].SessionNum, got.Sessions[2].SessionNum)
	}
}

