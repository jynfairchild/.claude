// New behavior: while active, periodic syncs provide session_duration and the
// handler derives total duration from the sum of sessions (completed + active).
func TestUpdateTask_Active_PeriodicSync_UsesSessionSum(t *testing.T) {
	db := setupTestDB(t)
	h := NewTaskHandler(db)
	r, w := setupTaskRouter(h)

	// Seed a baseline task via DB
	task := createTestTask(t, db, "SumDurations")

	// Add one ended session of 30s
	start1 := time.Now().Add(-40 * time.Second)
	end1 := start1.Add(30 * time.Second)
	s1 := models.Session{TaskID: task.ID, StartTime: start1, EndTime: &end1, Duration: 30, SessionNum: 1}
	if err := db.Create(&s1).Error; err != nil {
		t.Fatal(err)
	}

	// Make task active and create an open session (SessionNum=2)
	task.IsActive = true
	task.ColumnIndex = 1
	task.SessionCount = 2
	if err := db.Save(&task).Error; err != nil {
		t.Fatal(err)
	}
	s2 := models.Session{TaskID: task.ID, StartTime: time.Now().Add(-20 * time.Second), SessionNum: 2}
	if err := db.Create(&s2).Error; err != nil {
		t.Fatal(err)
	}

	// PATCH with session_duration=20 and a conflicting duration=10
	w = httptest.NewRecorder()
	payload := map[string]any{"session_duration": 20, "is_active": true, "duration": 10}
	bts, _ := json.Marshal(payload)
	req := httptest.NewRequest(http.MethodPatch, "/api/v1/tasks/"+strconv.Itoa(int(task.ID)), bytes.NewReader(bts))
	req.Header.Set("Content-Type", "application/json")
	r.ServeHTTP(w, req)
	if w.Code != http.StatusOK {
		t.Fatalf("expected 200, got %d: %s", w.Code, w.Body.String())
	}

	var updated models.Task
	if err := json.Unmarshal(w.Body.Bytes(), &updated); err != nil {
		t.Fatalf("invalid JSON: %v", err)
	}
	// Expect total = 30 (ended) + 20 (active) = 50
	if updated.Duration != 50 {
		t.Fatalf("expected summed duration 50, got %d", updated.Duration)
	}
	if !updated.IsActive {
		t.Fatalf("expected task to remain active")
	}
	// Active session should have duration 20 and no EndTime
	var active models.Session
	if err := db.Where("task_id = ? AND end_time IS NULL", updated.ID).First(&active).Error; err != nil {
		t.Fatalf("expected one active session: %v", err)
	}
	if active.Duration != 20 {
		t.Fatalf("expected active session duration 20, got %d", active.Duration)
	}
}

