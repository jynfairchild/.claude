func setupTaskRouter(h *TaskHandler) (*gin.Engine, *httptest.ResponseRecorder) {
	gin.SetMode(gin.TestMode)
	r := gin.New()
	r.Use(gin.Recovery())
	// Simulate auth middleware for tests: userID=1
	r.Use(func(c *gin.Context) { c.Set("userID", uint(1)); c.Next() })
	r.POST("/api/v1/tasks", h.CreateTask)
	r.PATCH("/api/v1/tasks/:id", h.UpdateTask)
	r.DELETE("/api/v1/tasks/:id", h.DeleteTask)
	r.GET("/api/v1/tasks", h.GetTasks)
	r.GET("/api/v1/tasks/:id", h.GetTaskWithSessions)
	r.GET("/api/v1/active", h.GetActiveTask)
	return r, httptest.NewRecorder()
}

func TestCreateTask_Defaults_TodoNoSession(t *testing.T) {
	db := setupTestDB(t)
	h := NewTaskHandler(db)
	r, w := setupTaskRouter(h)

	body := bytes.NewBufferString(`{}`)
	req := httptest.NewRequest(http.MethodPost, "/api/v1/tasks", body)
	req.Header.Set("Content-Type", "application/json")
	r.ServeHTTP(w, req)

	if w.Code != http.StatusCreated {
		t.Fatalf("expected 201, got %d: %s", w.Code, w.Body.String())
	}
	var task models.Task
	if err := json.Unmarshal(w.Body.Bytes(), &task); err != nil {
		t.Fatalf("invalid JSON: %v", err)
	}
	if task.Title != "Untitled Task" {
		t.Fatalf("expected default title, got %q", task.Title)
	}
	if task.ColumnIndex != 0 || task.IsActive {
		t.Fatalf("expected column_index=0 and inactive; got idx=%d active=%v", task.ColumnIndex, task.IsActive)
	}
	if task.Position != 0 {
		t.Fatalf("expected position 0, got %d", task.Position)
	}
	if len(task.Sessions) != 0 || task.SessionCount != 0 {
		t.Fatalf("expected no sessions; got len=%d count=%d", len(task.Sessions), task.SessionCount)
	}
}

