package email

import (
	"fmt"
	"log"
	"os"

	"github.com/resend/resend-go/v2"
)

var client *resend.Client

// Init initializes the email client with the Resend API key from environment.
// If no API key is set, emails will be logged to console instead.
func Init() {
	apiKey := os.Getenv("RESEND_API_KEY")
	if apiKey != "" {
		client = resend.NewClient(apiKey)
		log.Println("Email service initialized with Resend")
	} else {
		log.Println("RESEND_API_KEY not set - emails will be logged to console")
	}
}

// IsConfigured returns true if the email service has an API key configured.
func IsConfigured() bool {
	return client != nil
}

// SendInviteEmail sends an invitation email with the signup link.
// If no email service is configured, logs the URL to console instead.
func SendInviteEmail(toEmail, inviteURL string) error {
	if client == nil {
		// No email configured - log to console instead
		log.Printf("[EMAIL] Invite for %s: %s", toEmail, inviteURL)
		return nil
	}

	fromEmail := os.Getenv("EMAIL_FROM")
	if fromEmail == "" {
		fromEmail = "onboarding@resend.dev"
	}

	_, err := client.Emails.Send(&resend.SendEmailRequest{
		From:    fromEmail,
		To:      []string{toEmail},
		Subject: "You're invited to Astrotask",
		Html: fmt.Sprintf(`
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <style>
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; line-height: 1.6; color: #333; }
        .container { max-width: 600px; margin: 0 auto; padding: 40px 20px; }
        h1 { color: #1a1a1a; margin-bottom: 24px; }
        .button { display: inline-block; background: #0066ff; color: white; padding: 12px 24px; text-decoration: none; border-radius: 6px; font-weight: 500; }
        .footer { margin-top: 40px; font-size: 14px; color: #666; }
    </style>
</head>
<body>
    <div class="container">
        <h1>You're invited to Astrotask</h1>
        <p>Someone has invited you to join Astrotask, a productivity and time tracking app.</p>
        <p>Click the button below to create your account:</p>
        <p style="margin: 32px 0;">
            <a href="%s" class="button">Create Your Account</a>
        </p>
        <p class="footer">
            This invitation expires in 7 days.<br>
            If you didn't expect this email, you can safely ignore it.
        </p>
    </div>
</body>
</html>
`, inviteURL),
	})

	if err != nil {
		log.Printf("Failed to send invite email to %s: %v", toEmail, err)
		return err
	}

	log.Printf("Invite email sent to %s", toEmail)
	return nil
}
