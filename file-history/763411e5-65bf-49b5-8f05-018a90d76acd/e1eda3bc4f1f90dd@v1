import { describe, it, expect, vi, beforeEach, afterEach } from 'vitest';
import { sessionApi } from './sessionApi';

describe('sessionApi', () => {
  beforeEach(() => {
    localStorage.clear();
  });
  afterEach(() => {
    vi.restoreAllMocks();
  });

  it('updateCurrentSession sends PATCH with durations and credentials included', async () => {
    const fetchSpy = vi.spyOn(global, 'fetch' as any).mockResolvedValue({ ok: true, json: async () => ({ message: 'ok', session_duration: 5, task_duration: 125 }), statusText: 'OK' } as any);
    await sessionApi.updateCurrentSession(9, 125, 5);
    const [url, init] = fetchSpy.mock.calls[0] as [string, RequestInit];
    expect(url).toMatch(/\/tasks\/9\/sessions\/current$/);
    expect(init?.method).toBe('PATCH');
    expect(init?.credentials).toBe('include');
    const body = JSON.parse(String(init?.body));
    expect(body).toEqual({ duration: 125, session_duration: 5 });
  });

  it('startSession throws rich error from backend json when not ok', async () => {
    vi.spyOn(global, 'fetch' as any).mockResolvedValue({ ok: false, json: async () => ({ error: 'Already active' }), statusText: 'Conflict' } as any);
    await expect(sessionApi.startSession(1)).rejects.toThrow(/Already active/);
  });

  it('stopSession sends POST with durations', async () => {
    const fetchSpy = vi.spyOn(global, 'fetch' as any).mockResolvedValue({ ok: true, json: async () => ({}), statusText: 'OK' } as any);
    await sessionApi.stopSession(3, 50, 10);
    const [url, init] = fetchSpy.mock.calls[0] as [string, RequestInit];
    expect(url).toMatch(/\/tasks\/3\/sessions\/stop$/);
    expect(init?.method).toBe('POST');
    const body = JSON.parse(String(init?.body));
    expect(body).toEqual({ duration: 50, session_duration: 10 });
  });
});

