package auth

import (
    "crypto/rand"
    "crypto/sha256"
    "encoding/base64"
    "errors"
    "fmt"
    "os"
    "time"

    "gorm.io/gorm"

    "simple_task_tracker/backend/internal/models"
)

// refreshTTL returns the configured refresh token TTL or a default of 30 days.
func refreshTTL() time.Duration {
    if v := os.Getenv("REFRESH_TOKEN_TTL"); v != "" {
        if d, err := time.ParseDuration(v); err == nil {
            return d
        }
    }
    return 24 * time.Hour * 30
}

// RefreshTTL returns the configured refresh token TTL (exported for cookie duration)
func RefreshTTL() time.Duration {
    return refreshTTL()
}

// Generate an opaque, URL-safe token.
func generateOpaqueToken(nBytes int) (string, error) {
    b := make([]byte, nBytes)
    if _, err := rand.Read(b); err != nil {
        return "", fmt.Errorf("rand: %w", err)
    }
    return base64.RawURLEncoding.EncodeToString(b), nil
}

func hashToken(token string) string {
    sum := sha256.Sum256([]byte(token))
    return base64.RawURLEncoding.EncodeToString(sum[:])
}

// CreateRefreshToken creates and persists a hashed refresh token for the user.
// Returns the plaintext token for the client and the created record.
func CreateRefreshToken(db *gorm.DB, userID uint, userAgent, ip string) (string, *models.RefreshToken, error) {
    plain, err := generateOpaqueToken(32)
    if err != nil {
        return "", nil, err
    }
    hashed := hashToken(plain)
    rt := &models.RefreshToken{
        UserID:    userID,
        TokenHash: hashed,
        ExpiresAt: time.Now().Add(refreshTTL()),
        UserAgent: userAgent,
        IP:        ip,
    }
    if err := db.Create(rt).Error; err != nil {
        return "", nil, err
    }
    return plain, rt, nil
}

// FindValidRefreshToken validates a refresh token string and returns its record if not expired/revoked.
func FindValidRefreshToken(db *gorm.DB, token string) (*models.RefreshToken, error) {
    if token == "" { return nil, errors.New("missing token") }
    hashed := hashToken(token)
    var rt models.RefreshToken
    if err := db.Where("token_hash = ?", hashed).First(&rt).Error; err != nil {
        return nil, err
    }
    if rt.RevokedAt != nil {
        return nil, errors.New("token revoked")
    }
    if time.Now().After(rt.ExpiresAt) {
        return nil, errors.New("token expired")
    }
    return &rt, nil
}

// RotateRefreshToken revokes the old token and issues a new one in a transaction.
func RotateRefreshToken(db *gorm.DB, oldToken string, userAgent, ip string) (string, *models.RefreshToken, error) {
    returnValue := ""
    var newRT *models.RefreshToken
    err := db.Transaction(func(tx *gorm.DB) error {
        rt, err := FindValidRefreshToken(tx, oldToken)
        if err != nil {
            return err
        }
        // Create new token
        plain, created, err := CreateRefreshToken(tx, rt.UserID, userAgent, ip)
        if err != nil {
            return err
        }
        // Revoke old
        now := time.Now()
        rt.RevokedAt = &now
        rt.ReplacedByID = &created.ID
        if err := tx.Save(rt).Error; err != nil { return err }

        returnValue = plain
        newRT = created
        return nil
    })
    if err != nil { return "", nil, err }
    return returnValue, newRT, nil
}

// RevokeRefreshToken revokes a single token by its plaintext value.
func RevokeRefreshToken(db *gorm.DB, token string) error {
    hashed := hashToken(token)
    var rt models.RefreshToken
    if err := db.Where("token_hash = ?", hashed).First(&rt).Error; err != nil {
        return err
    }
    now := time.Now()
    rt.RevokedAt = &now
    return db.Save(&rt).Error
}

// RevokeAllUserRefreshTokens revokes all refresh tokens for a user.
func RevokeAllUserRefreshTokens(db *gorm.DB, userID uint) error {
    now := time.Now()
    return db.Model(&models.RefreshToken{}).
        Where("user_id = ? AND revoked_at IS NULL", userID).
        Updates(map[string]interface{}{"revoked_at": now}).Error
}

