import { describe, it, expect, vi, beforeEach, afterEach } from 'vitest';
import { metricsApi, MetricsOverview, ChartResponse } from './metricsApi';

function makeOverviewResponse(): MetricsOverview {
  return {
    users: {
      total: 100,
      verified: 80,
      unverified: 20,
      admins: 5,
      today: 3,
      this_week: 15,
      this_month: 40,
      this_year: 100,
    },
    tasks: {
      total: 500,
      total_created: 550,
      deleted: 50,
      active: 10,
      completed: 350,
      uncompleted: 140,
      avg_duration: 3600,
      today: 20,
      this_week: 100,
    },
    sessions: {
      total: 1000,
      active_now: 5,
      total_time_tracked: 360000,
      today_time: 7200,
      this_week_time: 36000,
      this_month_time: 144000,
    },
    top_users: [
      {
        user_id: 1,
        name: 'Top User',
        email: 'top@test.com',
        time_tracked: 36000,
        task_count: 50,
        session_count: 100,
      },
    ],
  };
}

function makeChartResponse(): ChartResponse {
  return {
    period: 'week',
    metric: 'signups',
    data: [
      { date: '2025-01-15', value: 5 },
      { date: '2025-01-16', value: 8 },
      { date: '2025-01-17', value: 3 },
    ],
  };
}

describe('metricsApi', () => {
  beforeEach(() => {
    localStorage.clear();
  });

  afterEach(() => {
    vi.restoreAllMocks();
  });

  describe('getOverview', () => {
    it('fetches overview with credentials included', async () => {
      const mockResponse = makeOverviewResponse();
      const fetchSpy = vi.spyOn(global, 'fetch').mockResolvedValue({
        ok: true,
        json: async () => mockResponse,
        statusText: 'OK',
      } as Response);

      const result = await metricsApi.getOverview();

      expect(fetchSpy).toHaveBeenCalledTimes(1);
      const [url, init] = fetchSpy.mock.calls[0] as [string, RequestInit];
      expect(url).toMatch(/\/admin\/metrics\/overview$/);
      expect(init?.credentials).toBe('include');
      expect(result).toEqual(mockResponse);
    });

    it('throws error when response is not ok', async () => {
      vi.spyOn(global, 'fetch').mockResolvedValue({
        ok: false,
        statusText: 'Forbidden',
        json: async () => ({ error: 'Admin access required' }),
      } as Response);

      await expect(metricsApi.getOverview()).rejects.toThrow(/Failed to fetch metrics/);
    });

    it('returns all user stats fields', async () => {
      const mockResponse = makeOverviewResponse();
      vi.spyOn(global, 'fetch').mockResolvedValue({
        ok: true,
        json: async () => mockResponse,
        statusText: 'OK',
      } as Response);

      const result = await metricsApi.getOverview();

      expect(result.users.total).toBe(100);
      expect(result.users.verified).toBe(80);
      expect(result.users.unverified).toBe(20);
      expect(result.users.admins).toBe(5);
      expect(result.users.today).toBe(3);
      expect(result.users.this_week).toBe(15);
      expect(result.users.this_month).toBe(40);
      expect(result.users.this_year).toBe(100);
    });

    it('returns all task stats fields', async () => {
      const mockResponse = makeOverviewResponse();
      vi.spyOn(global, 'fetch').mockResolvedValue({
        ok: true,
        json: async () => mockResponse,
        statusText: 'OK',
      } as Response);

      const result = await metricsApi.getOverview();

      expect(result.tasks.total).toBe(500);
      expect(result.tasks.active).toBe(10);
      expect(result.tasks.completed).toBe(350);
      expect(result.tasks.uncompleted).toBe(140);
      expect(result.tasks.avg_duration).toBe(3600);
      expect(result.tasks.today).toBe(20);
      expect(result.tasks.this_week).toBe(100);
    });

    it('returns all session stats fields', async () => {
      const mockResponse = makeOverviewResponse();
      vi.spyOn(global, 'fetch').mockResolvedValue({
        ok: true,
        json: async () => mockResponse,
        statusText: 'OK',
      } as Response);

      const result = await metricsApi.getOverview();

      expect(result.sessions.total).toBe(1000);
      expect(result.sessions.active_now).toBe(5);
      expect(result.sessions.total_time_tracked).toBe(360000);
      expect(result.sessions.today_time).toBe(7200);
      expect(result.sessions.this_week_time).toBe(36000);
      expect(result.sessions.this_month_time).toBe(144000);
    });

    it('returns top users array', async () => {
      const mockResponse = makeOverviewResponse();
      vi.spyOn(global, 'fetch').mockResolvedValue({
        ok: true,
        json: async () => mockResponse,
        statusText: 'OK',
      } as Response);

      const result = await metricsApi.getOverview();

      expect(result.top_users).toHaveLength(1);
      expect(result.top_users[0].name).toBe('Top User');
      expect(result.top_users[0].email).toBe('top@test.com');
      expect(result.top_users[0].time_tracked).toBe(36000);
    });
  });

  describe('getChartData', () => {
    it('fetches chart data with credentials included', async () => {
      const mockResponse = makeChartResponse();
      const fetchSpy = vi.spyOn(global, 'fetch').mockResolvedValue({
        ok: true,
        json: async () => mockResponse,
        statusText: 'OK',
      } as Response);

      const result = await metricsApi.getChartData('week', 'signups');

      expect(fetchSpy).toHaveBeenCalledTimes(1);
      const [url, init] = fetchSpy.mock.calls[0] as [string, RequestInit];
      expect(url).toMatch(/\/admin\/metrics\/charts\?period=week&metric=signups$/);
      expect(init?.credentials).toBe('include');
      expect(result).toEqual(mockResponse);
    });

    it('uses default parameters when not specified', async () => {
      const mockResponse = makeChartResponse();
      const fetchSpy = vi.spyOn(global, 'fetch').mockResolvedValue({
        ok: true,
        json: async () => mockResponse,
        statusText: 'OK',
      } as Response);

      await metricsApi.getChartData();

      const [url] = fetchSpy.mock.calls[0] as [string, RequestInit];
      expect(url).toMatch(/period=week/);
      expect(url).toMatch(/metric=signups/);
    });

    it('accepts month period', async () => {
      const mockResponse: ChartResponse = { period: 'month', metric: 'tasks', data: [] };
      const fetchSpy = vi.spyOn(global, 'fetch').mockResolvedValue({
        ok: true,
        json: async () => mockResponse,
        statusText: 'OK',
      } as Response);

      await metricsApi.getChartData('month', 'tasks');

      const [url] = fetchSpy.mock.calls[0] as [string, RequestInit];
      expect(url).toMatch(/period=month/);
      expect(url).toMatch(/metric=tasks/);
    });

    it('accepts year period', async () => {
      const mockResponse: ChartResponse = { period: 'year', metric: 'sessions', data: [] };
      const fetchSpy = vi.spyOn(global, 'fetch').mockResolvedValue({
        ok: true,
        json: async () => mockResponse,
        statusText: 'OK',
      } as Response);

      await metricsApi.getChartData('year', 'sessions');

      const [url] = fetchSpy.mock.calls[0] as [string, RequestInit];
      expect(url).toMatch(/period=year/);
      expect(url).toMatch(/metric=sessions/);
    });

    it('accepts time metric', async () => {
      const mockResponse: ChartResponse = { period: 'week', metric: 'time', data: [] };
      const fetchSpy = vi.spyOn(global, 'fetch').mockResolvedValue({
        ok: true,
        json: async () => mockResponse,
        statusText: 'OK',
      } as Response);

      await metricsApi.getChartData('week', 'time');

      const [url] = fetchSpy.mock.calls[0] as [string, RequestInit];
      expect(url).toMatch(/metric=time/);
    });

    it('throws error when response is not ok', async () => {
      vi.spyOn(global, 'fetch').mockResolvedValue({
        ok: false,
        statusText: 'Bad Request',
        json: async () => ({ error: 'Invalid metric' }),
      } as Response);

      await expect(metricsApi.getChartData('week', 'signups')).rejects.toThrow(/Failed to fetch chart data/);
    });

    it('returns data points with date and value', async () => {
      const mockResponse = makeChartResponse();
      vi.spyOn(global, 'fetch').mockResolvedValue({
        ok: true,
        json: async () => mockResponse,
        statusText: 'OK',
      } as Response);

      const result = await metricsApi.getChartData('week', 'signups');

      expect(result.data).toHaveLength(3);
      expect(result.data[0].date).toBe('2025-01-15');
      expect(result.data[0].value).toBe(5);
    });

    it('handles empty data array', async () => {
      const mockResponse: ChartResponse = { period: 'week', metric: 'signups', data: [] };
      vi.spyOn(global, 'fetch').mockResolvedValue({
        ok: true,
        json: async () => mockResponse,
        statusText: 'OK',
      } as Response);

      const result = await metricsApi.getChartData('week', 'signups');

      expect(result.data).toEqual([]);
    });
  });

  describe('error handling - fail-safe behavior', () => {
    it('getOverview failure does not block other API calls', async () => {
      // First call fails
      const fetchSpy = vi.spyOn(global, 'fetch')
        .mockResolvedValueOnce({
          ok: false,
          statusText: 'Internal Server Error',
          json: async () => ({ error: 'Database error' }),
        } as Response)
        .mockResolvedValueOnce({
          ok: true,
          json: async () => makeChartResponse(),
          statusText: 'OK',
        } as Response);

      // Overview should fail
      await expect(metricsApi.getOverview()).rejects.toThrow();

      // But chart data should still work
      const chartResult = await metricsApi.getChartData();
      expect(chartResult.period).toBe('week');

      expect(fetchSpy).toHaveBeenCalledTimes(2);
    });

    it('network error is caught and rethrown', async () => {
      vi.spyOn(global, 'fetch').mockRejectedValue(new Error('Network error'));

      await expect(metricsApi.getOverview()).rejects.toThrow('Network error');
    });
  });
});
