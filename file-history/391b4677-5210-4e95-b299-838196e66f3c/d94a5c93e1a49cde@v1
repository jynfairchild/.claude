"use client";

import React, { useCallback, useEffect, useRef, useState } from "react";
import "./Dropdown.css";

type Align = "left" | "right";
type Vertical = "top" | "bottom";

type TriggerProps = {
  ref: React.Ref<HTMLButtonElement>;
  onClick: () => void;
  "aria-haspopup": "menu";
  "aria-expanded": boolean;
};

interface DropdownProps {
  trigger: (props: TriggerProps) => React.ReactNode;
  children: (close: () => void) => React.ReactNode;
  align?: Align;
  vertical?: Vertical;
  panelClassName?: string; // optional extra class on the dropdown panel
  hoverOpen?: boolean; // open on hover instead of click
}

export const Dropdown: React.FC<DropdownProps> = ({ trigger, children, align = "right", vertical = "bottom", panelClassName }) => {
  const [open, setOpen] = useState(false);
  const rootRef = useRef<HTMLDivElement | null>(null);
  const btnRef = useRef<HTMLButtonElement | null>(null);

  const close = useCallback(() => setOpen(false), []);
  const toggle = useCallback(() => setOpen(o => !o), []);

  // Close on outside click
  useEffect(() => {
    if (!open) return;
    const onDocClick = (e: MouseEvent) => {
      const target = e.target as Node;
      if (!rootRef.current) return;
      if (!rootRef.current.contains(target)) {
        close();
      }
    };
    document.addEventListener("mousedown", onDocClick);
    return () => document.removeEventListener("mousedown", onDocClick);
  }, [open, close]);

  // Close on Escape
  useEffect(() => {
    if (!open) return;
    const onKey = (e: KeyboardEvent) => {
      if (e.key === "Escape") close();
    };
    document.addEventListener("keydown", onKey);
    return () => document.removeEventListener("keydown", onKey);
  }, [open, close]);

  return (
    <div ref={rootRef} className="kk-dropdown-root">
      {trigger({ ref: btnRef, onClick: toggle, "aria-haspopup": "menu", "aria-expanded": open })}
      {open && (
        <div
          className={`dropdown ${align === "right" ? "align-right" : "align-left"} ${vertical === "top" ? "align-top" : ""} ${panelClassName ?? ""}`}
          role="menu"
        >
          {children(close)}
        </div>
      )}
    </div>
  );
};

export default Dropdown;
