	if resp.Tasks.Deleted != 0 {
		t.Fatalf("expected 0 deleted tasks, got %d", resp.Tasks.Deleted)
	}
	if resp.Sessions.Total != 0 {
		t.Fatalf("expected 0 sessions, got %d", resp.Sessions.Total)
	}
}

func TestMetricsCharts_NoDataReturns200(t *testing.T) {
	db := setupMetricsTestDB(t)
	h := NewMetricsHandler(db)
	r, w := setupMetricsRouter(db, h)

	_, token := seedAdminUser(t, db)

	req := httptest.NewRequest(http.MethodGet, "/api/v1/admin/metrics/charts?period=week&metric=sessions", nil)
	req.Header.Set("Authorization", "Bearer "+token)
	r.ServeHTTP(w, req)

	// Should return 200 even with no data
	if w.Code != http.StatusOK {
		t.Fatalf("expected 200, got %d: %s", w.Code, w.Body.String())
	}

	var resp models.ChartResponse
	if err := json.Unmarshal(w.Body.Bytes(), &resp); err != nil {
		t.Fatalf("invalid JSON: %v", err)
	}

	// Response structure should be valid
	if resp.Period != "week" {
		t.Fatalf("expected period 'week', got %s", resp.Period)
	}
	if resp.Metric != "sessions" {
		t.Fatalf("expected metric 'sessions', got %s", resp.Metric)
	}
}
