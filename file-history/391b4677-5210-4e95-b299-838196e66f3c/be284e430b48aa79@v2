	r, w := setupMetricsRouter(db, h)

	admin, token := seedAdminUser(t, db)

	// Create a task
	task := models.Task{UserID: admin.ID, Title: "Session Task", Status: "uncompleted"}
	if err := db.Create(&task).Error; err != nil {
		t.Fatalf("failed to create task: %v", err)
	}

	now := time.Now()
	endTime := now.Add(-1 * time.Minute)

	// Create sessions: 2 ended with explicit durations
	s1 := models.Session{TaskID: task.ID, StartTime: now.Add(-10 * time.Minute), EndTime: &endTime, Duration: 300, SessionNum: 1}
	s2 := models.Session{TaskID: task.ID, StartTime: now.Add(-5 * time.Minute), EndTime: &endTime, Duration: 200, SessionNum: 2}
	if err := db.Create(&s1).Error; err != nil {
		t.Fatalf("failed to create session: %v", err)
	}
	if err := db.Create(&s2).Error; err != nil {
		t.Fatalf("failed to create session: %v", err)
	}

	req := httptest.NewRequest(http.MethodGet, "/api/v1/admin/metrics/overview", nil)
	req.Header.Set("Authorization", "Bearer "+token)
	r.ServeHTTP(w, req)

	if w.Code != http.StatusOK {
		t.Fatalf("expected 200, got %d: %s", w.Code, w.Body.String())
	}

	var resp models.AggregateStats
	if err := json.Unmarshal(w.Body.Bytes(), &resp); err != nil {
		t.Fatalf("invalid JSON: %v", err)
	}

	if resp.Sessions.Total != 2 {
		t.Fatalf("expected 2 sessions, got %d", resp.Sessions.Total)
	}
	// Total time should include sum of stored durations (at least 300 + 200 = 500)
	if resp.Sessions.TotalTimeTracked < 500 {
		t.Fatalf("expected at least 500 total time tracked, got %d", resp.Sessions.TotalTimeTracked)
	}
}

func TestMetricsOverview_TopUsersRankedByTime(t *testing.T) {
	db := setupMetricsTestDB(t)
	h := NewMetricsHandler(db)
	r, w := setupMetricsRouter(db, h)

	_, token := seedAdminUser(t, db)

	// Create multiple users with different time tracked
	user1 := models.User{Email: "heavy@test.com", Name: "Heavy User", PasswordHash: "phc", Role: "user"}
	user2 := models.User{Email: "light@test.com", Name: "Light User", PasswordHash: "phc", Role: "user"}
	db.Create(&user1)
	db.Create(&user2)

	// Create tasks and sessions
	task1 := models.Task{UserID: user1.ID, Title: "Task 1", Status: "completed"}
	task2 := models.Task{UserID: user2.ID, Title: "Task 2", Status: "uncompleted"}
	db.Create(&task1)
	db.Create(&task2)

	end := time.Now()
	// Heavy user: 1000 seconds tracked
	db.Create(&models.Session{TaskID: task1.ID, StartTime: time.Now().Add(-20 * time.Minute), EndTime: &end, Duration: 1000, SessionNum: 1})
	// Light user: 100 seconds tracked
	db.Create(&models.Session{TaskID: task2.ID, StartTime: time.Now().Add(-5 * time.Minute), EndTime: &end, Duration: 100, SessionNum: 1})

	req := httptest.NewRequest(http.MethodGet, "/api/v1/admin/metrics/overview", nil)
	req.Header.Set("Authorization", "Bearer "+token)
	r.ServeHTTP(w, req)

	if w.Code != http.StatusOK {
		t.Fatalf("expected 200, got %d: %s", w.Code, w.Body.String())
	}

	var resp models.AggregateStats
	if err := json.Unmarshal(w.Body.Bytes(), &resp); err != nil {
		t.Fatalf("invalid JSON: %v", err)
	}

	if len(resp.TopUsers) < 2 {
		t.Fatalf("expected at least 2 top users, got %d", len(resp.TopUsers))
	}

	// Heavy user should be first (has most time tracked)
	if resp.TopUsers[0].Name != "Heavy User" {
		t.Fatalf("expected Heavy User first, got %s", resp.TopUsers[0].Name)
	}
	// Verify heavy user has more time tracked than light user
	if resp.TopUsers[0].TimeTracked <= resp.TopUsers[1].TimeTracked {
		t.Fatalf("expected Heavy User to have more time than Light User")
	}
}

