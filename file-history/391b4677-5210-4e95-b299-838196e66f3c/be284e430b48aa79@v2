func TestMetricsOverview_CountsUsersCorrectly(t *testing.T) {
	db := setupMetricsTestDB(t)
	h := NewMetricsHandler(db)
	r, w := setupMetricsRouter(db, h)

	// Seed admin
	_, token := seedAdminUser(t, db)

	// Seed additional users
	now := time.Now()
	yesterday := now.AddDate(0, 0, -1)
	lastWeek := now.AddDate(0, 0, -5)
	lastMonth := now.AddDate(0, 0, -20)

	users := []models.User{
		{Email: "today@test.com", Name: "Today User", PasswordHash: "phc", Role: "user"},
		{Email: "yesterday@test.com", Name: "Yesterday User", PasswordHash: "phc", Role: "user"},
		{Email: "lastweek@test.com", Name: "Last Week User", PasswordHash: "phc", Role: "user"},
		{Email: "lastmonth@test.com", Name: "Last Month User", PasswordHash: "phc", Role: "user"},
	}
	for _, u := range users {
		if err := db.Create(&u).Error; err != nil {
			t.Fatalf("failed to create user: %v", err)
		}
	}
	// Update created_at manually for time-based tests
	db.Model(&models.User{}).Where("email = ?", "yesterday@test.com").Update("created_at", yesterday)
	db.Model(&models.User{}).Where("email = ?", "lastweek@test.com").Update("created_at", lastWeek)
	db.Model(&models.User{}).Where("email = ?", "lastmonth@test.com").Update("created_at", lastMonth)

	// Add verified user
	verified := time.Now()
	db.Model(&models.User{}).Where("email = ?", "today@test.com").Update("email_verified_at", &verified)

	req := httptest.NewRequest(http.MethodGet, "/api/v1/admin/metrics/overview", nil)
	req.Header.Set("Authorization", "Bearer "+token)
	r.ServeHTTP(w, req)

	if w.Code != http.StatusOK {
		t.Fatalf("expected 200, got %d: %s", w.Code, w.Body.String())
	}

	var resp models.AggregateStats
	if err := json.Unmarshal(w.Body.Bytes(), &resp); err != nil {
		t.Fatalf("invalid JSON: %v", err)
	}

	// Total = 5 (admin + 4 seeded)
	if resp.Users.Total != 5 {
		t.Fatalf("expected 5 users, got %d", resp.Users.Total)
	}
	// Verified = 1
	if resp.Users.Verified != 1 {
		t.Fatalf("expected 1 verified user, got %d", resp.Users.Verified)
	}
	// Admins = 1
	if resp.Users.Admins != 1 {
		t.Fatalf("expected 1 admin, got %d", resp.Users.Admins)
	}
}

func TestMetricsOverview_CountsTasksCorrectly(t *testing.T) {
	db := setupMetricsTestDB(t)
	h := NewMetricsHandler(db)
	r, w := setupMetricsRouter(db, h)

	admin, token := seedAdminUser(t, db)

	// Create tasks
	tasks := []models.Task{
		{UserID: admin.ID, Title: "Active Task", IsActive: true, Status: "uncompleted", Duration: 0},
		{UserID: admin.ID, Title: "Completed Task", IsActive: false, Status: "completed", Duration: 120},
		{UserID: admin.ID, Title: "Another Completed", IsActive: false, Status: "completed", Duration: 60},
		{UserID: admin.ID, Title: "Uncompleted Task", IsActive: false, Status: "uncompleted", Duration: 0},
	}
	for _, task := range tasks {
		if err := db.Create(&task).Error; err != nil {
			t.Fatalf("failed to create task: %v", err)
		}
	}

	req := httptest.NewRequest(http.MethodGet, "/api/v1/admin/metrics/overview", nil)
	req.Header.Set("Authorization", "Bearer "+token)
	r.ServeHTTP(w, req)

	if w.Code != http.StatusOK {
		t.Fatalf("expected 200, got %d: %s", w.Code, w.Body.String())
	}

	var resp models.AggregateStats
	if err := json.Unmarshal(w.Body.Bytes(), &resp); err != nil {
		t.Fatalf("invalid JSON: %v", err)
	}

	if resp.Tasks.Total != 4 {
		t.Fatalf("expected 4 tasks, got %d", resp.Tasks.Total)
	}
	if resp.Tasks.TotalCreated != 4 {
		t.Fatalf("expected 4 total_created tasks, got %d", resp.Tasks.TotalCreated)
	}
	if resp.Tasks.Deleted != 0 {
		t.Fatalf("expected 0 deleted tasks, got %d", resp.Tasks.Deleted)
	}
	if resp.Tasks.Active != 1 {
		t.Fatalf("expected 1 active task, got %d", resp.Tasks.Active)
	}
	if resp.Tasks.Completed != 2 {
		t.Fatalf("expected 2 completed tasks, got %d", resp.Tasks.Completed)
	}
	if resp.Tasks.Uncompleted != 2 {
		t.Fatalf("expected 2 uncompleted tasks, got %d", resp.Tasks.Uncompleted)
	}
	// Avg duration of completed tasks with duration > 0: (120 + 60) / 2 = 90
	if resp.Tasks.AvgDuration != 90 {
		t.Fatalf("expected avg duration 90, got %f", resp.Tasks.AvgDuration)
	}
}

func TestMetricsOverview_CountsDeletedTasksCorrectly(t *testing.T) {
	db := setupMetricsTestDB(t)
	h := NewMetricsHandler(db)
	r, w := setupMetricsRouter(db, h)

	admin, token := seedAdminUser(t, db)

	// Create tasks
	tasks := []models.Task{
		{UserID: admin.ID, Title: "Active Task", IsActive: false, Status: "uncompleted"},
		{UserID: admin.ID, Title: "Will Be Deleted", IsActive: false, Status: "uncompleted"},
		{UserID: admin.ID, Title: "Also Deleted", IsActive: false, Status: "completed"},
	}
	for _, task := range tasks {
		if err := db.Create(&task).Error; err != nil {
			t.Fatalf("failed to create task: %v", err)
		}
	}

	// Soft delete two tasks
	db.Delete(&models.Task{}, "title = ?", "Will Be Deleted")
	db.Delete(&models.Task{}, "title = ?", "Also Deleted")

	req := httptest.NewRequest(http.MethodGet, "/api/v1/admin/metrics/overview", nil)
	req.Header.Set("Authorization", "Bearer "+token)
	r.ServeHTTP(w, req)

	if w.Code != http.StatusOK {
		t.Fatalf("expected 200, got %d: %s", w.Code, w.Body.String())
	}

	var resp models.AggregateStats
	if err := json.Unmarshal(w.Body.Bytes(), &resp); err != nil {
		t.Fatalf("invalid JSON: %v", err)
	}

	// Total should only count non-deleted tasks
	if resp.Tasks.Total != 1 {
		t.Fatalf("expected 1 active task, got %d", resp.Tasks.Total)
	}
	// TotalCreated should count all tasks including deleted
	if resp.Tasks.TotalCreated != 3 {
		t.Fatalf("expected 3 total_created tasks, got %d", resp.Tasks.TotalCreated)
	}
	// Deleted should count only soft-deleted tasks
	if resp.Tasks.Deleted != 2 {
		t.Fatalf("expected 2 deleted tasks, got %d", resp.Tasks.Deleted)
	}
}

func TestMetricsOverview_CountsSessionsCorrectly(t *testing.T) {
	db := setupMetricsTestDB(t)
