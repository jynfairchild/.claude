// setupMetricsTestDB creates an in-memory DB with metrics-related tables.
func setupMetricsTestDB(t *testing.T) *gorm.DB {
	t.Helper()
	glogger := gormlogger.New(
		stdlog.New(testWriter{t}, "", 0),
		gormlogger.Config{
			SlowThreshold:             0,
			LogLevel:                  gormlogger.Warn,
			IgnoreRecordNotFoundError: true,
			Colorful:                  false,
		},
	)
	db, err := gorm.Open(sqlite.Open(":memory:"), &gorm.Config{Logger: glogger})
	if err != nil {
		t.Fatalf("failed to open sqlite: %v", err)
	}
	if err := db.AutoMigrate(&models.User{}, &models.Task{}, &models.Session{}); err != nil {
		t.Fatalf("failed to migrate: %v", err)
	}
	return db
}

// setupMetricsRouter creates a Gin router with admin-protected metrics endpoints.
func setupMetricsRouter(db *gorm.DB, h *MetricsHandler) (*gin.Engine, *httptest.ResponseRecorder) {
	gin.SetMode(gin.TestMode)
	r := gin.New()
	r.Use(gin.Recovery())

	api := r.Group("/api/v1")
	admin := api.Group("/admin")
	admin.Use(middleware.AuthMiddleware())
	admin.Use(middleware.AdminMiddleware(db))
	admin.GET("/metrics/overview", h.GetOverview)
	admin.GET("/metrics/charts", h.GetChartData)

	return r, httptest.NewRecorder()
}

// seedAdminUser creates an admin user and returns their access token.
func seedAdminUser(t *testing.T, db *gorm.DB) (models.User, string) {
	t.Helper()
	_ = os.Setenv("JWT_SECRET", "test-secret")
	hash, _ := a.HashPassword("adminpass")
	u := models.User{
		Email:        "admin@test.com",
		Name:         "Admin User",
		PasswordHash: hash,
		Role:         "admin",
	}
	if err := db.Create(&u).Error; err != nil {
		t.Fatalf("failed to create admin: %v", err)
	}
	token, err := a.GenerateToken(u.ID, u.Email, u.Name)
	if err != nil {
		t.Fatalf("failed to generate token: %v", err)
	}
	return u, token
}

// seedRegularUser creates a regular (non-admin) user and returns their access token.
func seedRegularUser(t *testing.T, db *gorm.DB) (models.User, string) {
